<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChatAgentBridge_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChatAgentBridge_Desktop"
    xmlns:inbox="using:ChatAgentBridge_Desktop.Inbox"
    xmlns:history="using:ChatAgentBridge_Desktop.History"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization"
    xmlns:appearance="using:ChatAgentBridge_Desktop.Appearance"
    xmlns:executionUi="using:ChatAgentBridge_Desktop.ExecutionUi"
    xmlns:about="using:ChatAgentBridge_Desktop.About"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:layout="using:ChatAgentBridge_Desktop.Layout"
    xmlns:tray="using:ChatAgentBridge_Desktop.Tray"
    xmlns:deployment="using:ChatAgentBridge_Desktop.Deployment"
    xmlns:diagrams="using:ChatAgentBridge_Desktop.Diagrams"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <NavigationView x:Name="MainNavigation" Visibility="{x:Bind local:MainPage.ToHiddenVisibility(ViewModel.IsOnboardingActive), Mode=OneWay}"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto" OpenPaneLength="240"
                        DisplayModeChanged="MainNavigation_DisplayModeChanged"
                        SelectionChanged="MainNavigation_SelectionChanged"

                        AutomationProperties.AutomationId="MainNavigation" x:Uid="MainNavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem  Tag="overview"  AutomationProperties.AutomationId="NavOverview" x:Uid="NavOverview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem  Tag="workbench"  AutomationProperties.AutomationId="NavWorkbench" x:Uid="NavWorkbench">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem  Tag="agent" AutomationProperties.AutomationId="NavAgentSettings" Icon="Setting"  x:Uid="NavAgentSettings" />
                <NavigationViewItem  Tag="connections"  AutomationProperties.AutomationId="NavConnections" x:Uid="NavConnections">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Link" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem  Tag="chat" AutomationProperties.AutomationId="NavChat" Icon="Message"  x:Uid="NavChat" />
                <NavigationViewItem  Tag="history" AutomationProperties.AutomationId="NavHistory" Icon="Clock"  x:Uid="NavHistory" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNavigationItem" Tag="about" AutomationProperties.AutomationId="NavAbout" x:Uid="NavAbout">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="AboutUpdateBadge" Visibility="Collapsed" Style="{StaticResource AttentionIconInfoBadgeStyle}"
                                   Background="{ThemeResource ControlFillColorTransparentBrush}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   Width="24" Height="24" MinWidth="24" MinHeight="24" MaxHeight="24" Padding="2"
                                   AutomationProperties.AccessibilityView="Control" AutomationProperties.AutomationId="NavAboutUpdateBadge">
                            <InfoBadge.Resources>
                                <Thickness x:Key="IconInfoBadgeFontIconMargin">0</Thickness>
                            </InfoBadge.Resources>
                            <!-- Fluent System Icons: Arrow Circle Up (filled). Source and MIT license: Assets/Icons/FluentSystemIcons. -->
                            <InfoBadge.IconSource>
                                <FontIconSource FontFamily="ms-appx:///Assets/Icons/FluentSystemIcons/UpdateAvailable.ttf#FluentSystemIcons-Filled"
                                                Glyph="&#xE0A2;" FontSize="20" IsTextScaleFactorEnabled="False" />
                            </InfoBadge.IconSource>
                        </InfoBadge>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <Grid x:Name="MainContentGrid" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <InfoBar Grid.Row="0" Margin="0,0,0,16" AutomationProperties.AutomationId="ExecutionStatus"
                             IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                             Severity="{x:Bind local:MainPage.ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}"
                             Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    <StackPanel Grid.Row="1" MaxWidth="1040" HorizontalAlignment="Left" Spacing="4" Margin="0,0,0,16"
                                Visibility="{x:Bind local:MainPage.ToVisibility(IsAgentSelected), Mode=OneTime}">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock013" x:Uid="chatAgentBridgeDesktopMainPageTextBlock013" />
                        <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock014" x:Uid="chatAgentBridgeDesktopMainPageTextBlock014" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" MaxWidth="1040" HorizontalAlignment="Left" Spacing="4" Margin="0,0,0,16"
                                Visibility="{x:Bind local:MainPage.ToVisibility(IsConnectionsSelected), Mode=OneTime}">
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock046" x:Uid="chatAgentBridgeDesktopMainPageTextBlock046" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock047" x:Uid="chatAgentBridgeDesktopMainPageTextBlock047" />
                    </StackPanel>
                    <Button Grid.Row="2" Margin="0,0,0,12"  Click="ReloadSettings_Click"
                            IsEnabled="{x:Bind local:MainPage.CanReloadSettings(ViewModel.IsLoading, ViewModel.IsRunning), Mode=OneWay}"
                            Visibility="{x:Bind local:MainPage.ToHiddenVisibility(ViewModel.IsSettingsLoaded), Mode=OneWay}"
                            HorizontalAlignment="Left" AutomationProperties.AutomationId="ReloadSettings"  x:Uid="ReloadSettings" />

                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,0,0,12" Visibility="{x:Bind local:MainPage.ActionButtonsVisibility(IsAgentSelected, ViewModel.IsSettingsLoaded), Mode=OneWay}">
                        <Grid ColumnSpacing="8" Visibility="{x:Bind local:MainPage.SettingsAutoSaveRetryVisibility(ViewModel.HasUnsavedSettings, ViewModel.IsSensitiveConfirmationPending, ViewModel.IsStatusOpen, ViewModel.StatusSeverity), Mode=OneWay}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE74E;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Bind local:MainPage.SettingsAutoSaveStatus(ViewModel.HasUnsavedSettings, ViewModel.IsLoading, ViewModel.IsSensitiveConfirmationPending, ViewModel.IsStatusOpen, ViewModel.StatusSeverity), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AgentSettingsSaveState" />
                        </Grid>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="RetrySettingsAutoSave_Click" IsEnabled="{x:Bind ViewModel.CanSavePendingSettings, Mode=OneWay}" Visibility="{x:Bind local:MainPage.SettingsAutoSaveRetryVisibility(ViewModel.HasUnsavedSettings, ViewModel.IsSensitiveConfirmationPending, ViewModel.IsStatusOpen, ViewModel.StatusSeverity), Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SaveSettings" x:Uid="SettingsAutoSaveRetry" localization:LocalizedResourceKey.Key="SettingsAutoSaveRetry" />
                        <ComboBox Width="{x:Bind MainContentScroll.ViewportWidth, Mode=OneWay}" MaxWidth="440" HorizontalAlignment="Left" SelectedIndex="-1" SelectionChanged="AgentJump_SelectionChanged" AutomationProperties.AutomationId="AgentSettingsJump" x:Uid="AgentSettingsJump">
                            <ComboBoxItem Tag="basic" AutomationProperties.AutomationId="JumpAgentBasic" x:Uid="JumpAgentBasic" />
                            <ComboBoxItem Tag="common" AutomationProperties.AutomationId="JumpAgentCommon" x:Uid="JumpAgentCommon" />
                            <ComboBoxItem Tag="model" AutomationProperties.AutomationId="JumpAgentModel" x:Uid="JumpAgentModel" Visibility="{x:Bind local:MainPage.ToVisibility(ViewModel.SupportsModel), Mode=OneWay}" />
                            <ComboBoxItem Tag="permissions" AutomationProperties.AutomationId="JumpAgentPermissions" x:Uid="JumpAgentPermissions" Visibility="{x:Bind local:MainPage.ToHiddenVisibility(ViewModel.IsBasicProvider), Mode=OneWay}" />
                            <ComboBoxItem Tag="codex" AutomationProperties.AutomationId="JumpAgentCodex" x:Uid="JumpAgentCodex" Visibility="{x:Bind local:MainPage.ToVisibility(ViewModel.IsCodexProvider), Mode=OneWay}" />
                            <ComboBoxItem Tag="advanced" AutomationProperties.AutomationId="JumpAgentAdvanced" x:Uid="JumpAgentAdvanced" />
                            <ComboBoxItem Tag="registrations" AutomationProperties.AutomationId="JumpAgentRegistrations" x:Uid="JumpAgentRegistrations" />
                            <ComboBoxItem Tag="explanation" AutomationProperties.AutomationId="JumpAgentExplanation" x:Uid="JumpAgentExplanation" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,12" Spacing="8" Visibility="{x:Bind local:MainPage.ActionButtonsVisibility(IsConnectionsSelected, ViewModel.IsSettingsLoaded), Mode=OneWay}">
                        <Grid ColumnSpacing="8" Visibility="{x:Bind local:MainPage.SettingsAutoSaveRetryVisibility(ViewModel.HasUnsavedSettings, ViewModel.IsSensitiveConfirmationPending, ViewModel.IsStatusOpen, ViewModel.StatusSeverity), Mode=OneWay}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE74E;" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="{x:Bind local:MainPage.SettingsAutoSaveStatus(ViewModel.HasUnsavedSettings, ViewModel.IsLoading, ViewModel.IsSensitiveConfirmationPending, ViewModel.IsStatusOpen, ViewModel.StatusSeverity), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ConnectionSettingsSaveState" />
                        </Grid>
                        <Button Style="{StaticResource AccentButtonStyle}" Click="RetrySettingsAutoSave_Click" IsEnabled="{x:Bind ViewModel.CanSavePendingSettings, Mode=OneWay}" Visibility="{x:Bind local:MainPage.SettingsAutoSaveRetryVisibility(ViewModel.HasUnsavedSettings, ViewModel.IsSensitiveConfirmationPending, ViewModel.IsStatusOpen, ViewModel.StatusSeverity), Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SaveConnections" x:Uid="SettingsAutoSaveRetry" localization:LocalizedResourceKey.Key="SettingsAutoSaveRetry" />
                        <ComboBox x:Name="ConnectionsJump" Width="{x:Bind MainContentScroll.ViewportWidth, Mode=OneWay}" MaxWidth="440" HorizontalAlignment="Left" SelectionChanged="ConnectionsJump_SelectionChanged" AutomationProperties.AutomationId="ConnectionsJump" x:Uid="ConnectionsJump">
                            <ComboBoxItem Content="Mattermost" Tag="mattermost" AutomationProperties.AutomationId="JumpMattermost" />
                            <ComboBoxItem Content="Slack" Tag="slack" AutomationProperties.AutomationId="JumpSlack" />
                            <ComboBoxItem Tag="approval" AutomationProperties.AutomationId="JumpApproval" x:Uid="JumpApproval" />
                            <ComboBoxItem Tag="attachments" AutomationProperties.AutomationId="JumpAttachments" x:Uid="JumpAttachments" />
                            <ComboBoxItem Tag="codex-sharing" AutomationProperties.AutomationId="JumpCodexSharing" x:Uid="JumpCodexSharing" Visibility="{x:Bind local:MainPage.ToVisibility(ViewModel.IsCodexProvider), Mode=OneWay}" />
                        </ComboBox>
                    </StackPanel>
                    <ScrollViewer x:Name="MainContentScroll" Grid.Row="3" HorizontalContentAlignment="Stretch" Visibility="{x:Bind local:MainPage.ToVisibility(IsFormSelected), Mode=OneTime}" IsEnabled="{x:Bind local:MainPage.CanUseForm(IsOverviewSelected, ViewModel.IsSettingsLoaded, ViewModel.IsLoading), Mode=OneWay}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="MainContentScroll"  x:Uid="MainContentScroll">
                        <Grid Width="{x:Bind MainContentScroll.ViewportWidth, Mode=OneWay}" MaxWidth="1040" HorizontalAlignment="Left" AutomationProperties.AutomationId="FormContent">
                            <StackPanel Spacing="12" Visibility="{x:Bind local:MainPage.ToVisibility(IsOverviewSelected), Mode=OneTime}">
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="GeneralPageTitle" x:Uid="GeneralPageTitle" />
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="GeneralPageDescription" x:Uid="GeneralPageDescription" />
                                </StackPanel>
                                <Border Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="OverviewStatusHeading" x:Uid="OverviewStatusHeading" />
                                        <Grid ColumnSpacing="12" RowSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Click="OpenAgentSettings_Click" AutomationProperties.Name="{x:Bind ViewModel.OverviewAgentAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewAgentTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewAgentIconState), Mode=OneWay}" AutomationProperties.AutomationId="OverviewAgentIcon" Glyph="{x:Bind ViewModel.OverviewAgentGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewAgentLabel" x:Uid="OverviewAgentLabel" /><TextBlock Text="{x:Bind ViewModel.OverviewAgentStatus, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel></Grid>
                                            </Button>
                                            <Button Grid.Row="0" Grid.Column="1" Click="OpenConnections_Click" AutomationProperties.Name="{x:Bind ViewModel.OverviewConnectionAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewConnectionTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewConnectionIconState), Mode=OneWay}" AutomationProperties.AutomationId="OverviewConnectionIcon" Glyph="{x:Bind ViewModel.OverviewConnectionGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewConnectionLabel" x:Uid="OverviewConnectionLabel" /><TextBlock Text="{x:Bind ViewModel.OverviewConnectionStatus, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel></Grid>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="0" Click="OpenChat_Click" AutomationProperties.Name="{x:Bind ViewModel.OverviewChatAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewChatTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewChatIconState), Mode=OneWay}" AutomationProperties.AutomationId="OverviewChatIcon" Glyph="{x:Bind ViewModel.OverviewChatGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewChatLabel" x:Uid="OverviewChatLabel" /><TextBlock Text="{x:Bind ViewModel.OverviewChatStatus, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel></Grid>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="1" Click="OpenAgentSettings_Click" AutomationProperties.Name="{x:Bind ViewModel.OverviewCliAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewCliTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewCliIconState), Mode=OneWay}" AutomationProperties.AutomationId="OverviewCliIcon" Glyph="{x:Bind ViewModel.OverviewCliGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewCliLabel" x:Uid="OverviewCliLabel" /><TextBlock Text="{x:Bind ViewModel.OverviewCliStatus, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel></Grid>
                                            </Button>
                                            <Button Grid.Row="2" Grid.Column="0" Click="OpenStartupSettings_Click" ToolTipService.ToolTip="{x:Bind ViewModel.StartupStatus, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.OverviewStartupAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewStartupTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewStartupIconState), Mode=OneWay}" Glyph="{x:Bind ViewModel.OverviewStartupGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" x:Uid="OverviewStartupLabel" localization:LocalizedResourceKey.Key="OverviewStartupLabel" />
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" x:Uid="OverviewStartupHint" localization:LocalizedResourceKey.Key="OverviewStartupHint" />
                                                        <TextBlock Text="{x:Bind ViewModel.OverviewStartupStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewStartupStatus" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Row="2" Grid.Column="1" Click="OpenAutoConnectSettings_Click" AutomationProperties.Name="{x:Bind ViewModel.OverviewAutoConnectAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewAutoConnectTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewAutoConnectIconState), Mode=OneWay}" Glyph="{x:Bind ViewModel.OverviewAutoConnectGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" x:Uid="OverviewAutoConnectLabel" localization:LocalizedResourceKey.Key="OverviewAutoConnectLabel" />
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" x:Uid="OverviewAutoConnectHint" localization:LocalizedResourceKey.Key="OverviewAutoConnectHint" />
                                                        <TextBlock Text="{x:Bind ViewModel.OverviewAutoConnectStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewAutoConnectStatus" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.SetupNextAction, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewNextAction" />
                                        <TextBlock Text="{x:Bind ViewModel.SetupDraftNotice, Mode=OneWay}" Visibility="{x:Bind local:MainPage.ToVisibility(ViewModel.HasSetupDraftNotice), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewDraftNotice" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Spacing="8" x:Name="StartupSettingsCard" AutomationProperties.AutomationId="StartupCard">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="StartupHeading" x:Uid="StartupHeading" />
                                    <settings:SettingsCard layout:SettingsCardLayout.IsAdaptive="True" x:Uid="StartupSettingRow" AutomationProperties.AutomationId="StartupSettingRow">
                                        <settings:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E8;" /></settings:SettingsCard.HeaderIcon>
                                        <settings:SettingsCard.Description>
                                            <TextBlock Text="{x:Bind ViewModel.StartupStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="StartupStatus" />
                                        </settings:SettingsCard.Description>
                                        <ToggleSwitch x:Name="StartupToggle" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=OneWay}" Toggled="StartupToggle_Toggled" IsEnabled="{x:Bind ViewModel.CanChangeStartup, Mode=OneWay}" AutomationProperties.AutomationId="StartWithWindows" x:Uid="StartWithWindows" />
                                    </settings:SettingsCard>
                                    <settings:SettingsCard layout:SettingsCardLayout.IsAdaptive="True" x:Uid="AutoConnectSettingRow" AutomationProperties.AutomationId="AutoConnectSettingRow">
                                        <settings:SettingsCard.HeaderIcon><SymbolIcon Symbol="Message" /></settings:SettingsCard.HeaderIcon>
                                        <settings:SettingsCard.Description>
                                            <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock043" x:Uid="chatAgentBridgeDesktopMainPageTextBlock043" />
                                        </settings:SettingsCard.Description>
                                        <ComboBox x:Name="AutoConnectProviderPicker" IsEnabled="{x:Bind ViewModel.IsSettingsLoaded, Mode=OneWay}" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.AutoConnectProvider, Mode=OneWay}" SelectionChanged="AutoConnectProviderPicker_SelectionChanged" MinWidth="180" HorizontalAlignment="Left" AutomationProperties.AutomationId="AutoConnectProvider" x:Uid="AutoConnectProvider">
                                            <ComboBoxItem Tag="none" AutomationProperties.AutomationId="AutoConnectOptionNone" x:Uid="AutoConnectOptionNone" />
                                            <ComboBoxItem Content="Mattermost" Tag="mattermost" AutomationProperties.AutomationId="AutoConnectOptionMattermost" />
                                            <ComboBoxItem Content="Slack" Tag="slack" AutomationProperties.AutomationId="AutoConnectOptionSlack" />
                                        </ComboBox>
                                    </settings:SettingsCard>
                                    <TextBlock Visibility="{x:Bind local:MainPage.SettingsAutoSaveRetryVisibility(ViewModel.HasUnsavedSettings, ViewModel.IsSensitiveConfirmationPending, ViewModel.IsStatusOpen, ViewModel.StatusSeverity), Mode=OneWay}" TextWrapping="Wrap" Text="{x:Bind local:MainPage.SettingsAutoSaveStatus(ViewModel.HasUnsavedSettings, ViewModel.IsLoading, ViewModel.IsSensitiveConfirmationPending, ViewModel.IsStatusOpen, ViewModel.StatusSeverity), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="GeneralSettingsSaveState" />
                                    <Button Click="RetrySettingsAutoSave_Click" Visibility="{x:Bind local:MainPage.SettingsAutoSaveRetryVisibility(ViewModel.HasUnsavedSettings, ViewModel.IsSensitiveConfirmationPending, ViewModel.IsStatusOpen, ViewModel.StatusSeverity), Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanSavePendingSettings, Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="GeneralSettingsSaveRetry" x:Uid="SettingsAutoSaveRetry" localization:LocalizedResourceKey.Key="SettingsAutoSaveRetry" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="SaveGeneralSettingsHelp" x:Uid="SaveGeneralSettingsHelp" />
                                </StackPanel>
                                <tray:TraySettingsControl />
                                <deployment:PortableIdentityControl />
                                <StackPanel x:Name="GeneralAppearanceSection" Spacing="12" AutomationProperties.AutomationId="GeneralAppearanceSection">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="GeneralAppearanceSectionHeading" x:Uid="GeneralAppearanceSectionHeading" />
                                    <localization:LanguageSettings x:Name="SettingsLanguage" AutomationProperties.AutomationId="LanguageCard" />
                                    <appearance:AppearanceSettings />
                                </StackPanel>
                                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="OverviewDetailsExpander">
                                    <Expander.Header>
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewDetailsHeader" x:Uid="OverviewDetailsHeader" />
                                            <TextBlock Text="{x:Bind ViewModel.SetupCompletionSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewDetailsSummary" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                                        <Border Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock002" x:Uid="chatAgentBridgeDesktopMainPageTextBlock002" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SetupCompletionSummary, Mode=OneWay}" AutomationProperties.AutomationId="SetupCompletionSummary" /></Grid>
                                                <ProgressBar Value="{x:Bind ViewModel.SetupProgressValue, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Minimum="0" Maximum="100" AutomationProperties.AutomationId="SetupProgress" x:Uid="SetupProgress" />
                                                <Grid ColumnSpacing="12" RowSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock003" x:Uid="chatAgentBridgeDesktopMainPageTextBlock003" /><TextBlock Text="{x:Bind ViewModel.SetupStepOneStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="SetupStepOneStatus" /></StackPanel>
                                                    <Button Grid.Row="0" Grid.Column="2" Click="OpenAgentSettings_Click" AutomationProperties.AutomationId="SetupAgentLink" x:Uid="SetupAgentLink" />
                                                    <TextBlock Grid.Row="1" Text="2" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Top" />
