<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChatAgentBridge_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChatAgentBridge_Desktop"
    xmlns:inbox="using:ChatAgentBridge_Desktop.Inbox"
    xmlns:history="using:ChatAgentBridge_Desktop.History"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization"
    xmlns:appearance="using:ChatAgentBridge_Desktop.Appearance"
    xmlns:about="using:ChatAgentBridge_Desktop.About"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <NavigationView x:Name="MainNavigation" Visibility="{x:Bind local:MainPage.ToHiddenVisibility(ViewModel.IsOnboardingActive), Mode=OneWay}"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto" OpenPaneLength="240"
                        DisplayModeChanged="MainNavigation_DisplayModeChanged"
                        SelectionChanged="MainNavigation_SelectionChanged"

                        AutomationProperties.AutomationId="MainNavigation" x:Uid="MainNavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem  Tag="overview"  AutomationProperties.AutomationId="NavOverview" x:Uid="NavOverview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem  Tag="workbench"  AutomationProperties.AutomationId="NavWorkbench" x:Uid="NavWorkbench">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem  Tag="agent" AutomationProperties.AutomationId="NavAgentSettings" Icon="Setting"  x:Uid="NavAgentSettings" />
                <NavigationViewItem  Tag="connections"  AutomationProperties.AutomationId="NavConnections" x:Uid="NavConnections">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Link" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem  Tag="chat" AutomationProperties.AutomationId="NavChat" Icon="Message"  x:Uid="NavChat" />
                <NavigationViewItem  Tag="history" AutomationProperties.AutomationId="NavHistory" Icon="Clock"  x:Uid="NavHistory" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Tag="appearance" AutomationProperties.AutomationId="NavAppearance" x:Uid="NavAppearance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="about" AutomationProperties.AutomationId="NavAbout" x:Uid="NavAbout">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <NavigationView.Content>
                <Grid x:Name="MainContentGrid" Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <InfoBar Grid.Row="0" Margin="0,0,0,16" AutomationProperties.AutomationId="ExecutionStatus"
                             IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                             Severity="{x:Bind local:MainPage.ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}"
                             Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    <Button Grid.Row="2" Margin="0,0,0,12"  Click="ReloadSettings_Click"
                            IsEnabled="{x:Bind local:MainPage.CanReloadSettings(ViewModel.IsLoading, ViewModel.IsRunning), Mode=OneWay}"
                            Visibility="{x:Bind local:MainPage.ToHiddenVisibility(ViewModel.IsSettingsLoaded), Mode=OneWay}"
                            HorizontalAlignment="Left" AutomationProperties.AutomationId="ReloadSettings"  x:Uid="ReloadSettings" />

                    <Button Grid.Row="2"  Margin="0,0,0,12" Command="{x:Bind ViewModel.SaveSettingsCommand}" Visibility="{x:Bind local:MainPage.ActionButtonsVisibility(IsAgentSelected, ViewModel.IsSettingsLoaded), Mode=OneWay}" AutomationProperties.AutomationId="SaveSettings"  x:Uid="SaveSettings" />
                    <Grid Grid.Row="2" Margin="0,0,0,12" ColumnSpacing="12" Visibility="{x:Bind local:MainPage.ActionButtonsVisibility(IsConnectionsSelected, ViewModel.IsSettingsLoaded), Mode=OneWay}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Command="{x:Bind ViewModel.SaveSettingsCommand}" VerticalAlignment="Bottom" AutomationProperties.AutomationId="SaveConnections" x:Uid="SaveConnections" />
                        <ComboBox x:Name="ConnectionsJump" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" VerticalAlignment="Bottom" SelectionChanged="ConnectionsJump_SelectionChanged" AutomationProperties.AutomationId="ConnectionsJump" x:Uid="ConnectionsJump">
                            <ComboBoxItem Content="Mattermost" Tag="mattermost" AutomationProperties.AutomationId="JumpMattermost" />
                            <ComboBoxItem Content="Slack" Tag="slack" AutomationProperties.AutomationId="JumpSlack" />
                            <ComboBoxItem Tag="approval" AutomationProperties.AutomationId="JumpApproval" x:Uid="JumpApproval" />
                            <ComboBoxItem Tag="scope" AutomationProperties.AutomationId="JumpScope" x:Uid="JumpScope" />
                            <ComboBoxItem Tag="startup" AutomationProperties.AutomationId="JumpStartup" x:Uid="JumpStartup" />
                        </ComboBox>
                    </Grid>
                    <ScrollViewer x:Name="MainContentScroll" Grid.Row="3" Visibility="{x:Bind local:MainPage.ToVisibility(IsFormSelected), Mode=OneTime}" IsEnabled="{x:Bind local:MainPage.CanUseForm(IsAppearanceSelected, ViewModel.IsSettingsLoaded), Mode=OneWay}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="MainContentScroll"  x:Uid="MainContentScroll">
                        <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12" Visibility="{x:Bind local:MainPage.ToVisibility(IsOverviewSelected), Mode=OneTime}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Chat Agent Bridge" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock001" x:Uid="chatAgentBridgeDesktopMainPageTextBlock001" />
                                </StackPanel>
                                <Border Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="OverviewStatusHeading" x:Uid="OverviewStatusHeading" />
                                        <Grid ColumnSpacing="12" RowSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Button Grid.Row="0" Grid.Column="0" Click="OpenAgentSettings_Click" AutomationProperties.Name="{x:Bind ViewModel.OverviewAgentAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewAgentTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewAgentIconState), Mode=OneWay}" AutomationProperties.AutomationId="OverviewAgentIcon" Glyph="{x:Bind ViewModel.OverviewAgentGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewAgentLabel" x:Uid="OverviewAgentLabel" /><TextBlock Text="{x:Bind ViewModel.OverviewAgentStatus, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel></Grid>
                                            </Button>
                                            <Button Grid.Row="0" Grid.Column="1" Click="OpenConnections_Click" AutomationProperties.Name="{x:Bind ViewModel.OverviewConnectionAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewConnectionTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewConnectionIconState), Mode=OneWay}" AutomationProperties.AutomationId="OverviewConnectionIcon" Glyph="{x:Bind ViewModel.OverviewConnectionGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewConnectionLabel" x:Uid="OverviewConnectionLabel" /><TextBlock Text="{x:Bind ViewModel.OverviewConnectionStatus, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel></Grid>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="0" Click="OpenChat_Click" AutomationProperties.Name="{x:Bind ViewModel.OverviewChatAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewChatTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewChatIconState), Mode=OneWay}" AutomationProperties.AutomationId="OverviewChatIcon" Glyph="{x:Bind ViewModel.OverviewChatGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewChatLabel" x:Uid="OverviewChatLabel" /><TextBlock Text="{x:Bind ViewModel.OverviewChatStatus, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel></Grid>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="1" Click="OpenAgentSettings_Click" AutomationProperties.Name="{x:Bind ViewModel.OverviewCliAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewCliTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewCliIconState), Mode=OneWay}" AutomationProperties.AutomationId="OverviewCliIcon" Glyph="{x:Bind ViewModel.OverviewCliGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewCliLabel" x:Uid="OverviewCliLabel" /><TextBlock Text="{x:Bind ViewModel.OverviewCliStatus, Mode=OneWay}" TextWrapping="Wrap" /></StackPanel></Grid>
                                            </Button>
                                            <Button Grid.Row="2" Grid.Column="0" Click="OpenStartupSettings_Click" ToolTipService.ToolTip="{x:Bind ViewModel.StartupStatus, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.OverviewStartupAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewStartupTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewStartupIconState), Mode=OneWay}" Glyph="{x:Bind ViewModel.OverviewStartupGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" x:Uid="OverviewStartupLabel" />
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" x:Uid="OverviewStartupHint" />
                                                        <TextBlock Text="{x:Bind ViewModel.OverviewStartupStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewStartupStatus" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <Button Grid.Row="2" Grid.Column="1" Click="OpenAutoConnectSettings_Click" AutomationProperties.Name="{x:Bind ViewModel.OverviewAutoConnectAccessibleName, Mode=OneWay}" AutomationProperties.AutomationId="OverviewAutoConnectTile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <FontIcon Style="{x:Bind local:MainPage.OverviewIconStyle(ViewModel.OverviewAutoConnectIconState), Mode=OneWay}" Glyph="{x:Bind ViewModel.OverviewAutoConnectGlyph, Mode=OneWay}" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" />
                                                    <StackPanel Grid.Column="1" Spacing="2">
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" x:Uid="OverviewAutoConnectLabel" />
                                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" x:Uid="OverviewAutoConnectHint" />
                                                        <TextBlock Text="{x:Bind ViewModel.OverviewAutoConnectStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewAutoConnectStatus" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{x:Bind ViewModel.SetupNextAction, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewNextAction" />
                                        <TextBlock Text="{x:Bind ViewModel.SetupDraftNotice, Mode=OneWay}" Visibility="{x:Bind local:MainPage.ToVisibility(ViewModel.HasSetupDraftNotice), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewDraftNotice" />
                                    </StackPanel>
                                </Border>
                                <Expander IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="OverviewDetailsExpander">
                                    <Expander.Header>
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewDetailsHeader" x:Uid="OverviewDetailsHeader" />
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                                        <Border Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock002" x:Uid="chatAgentBridgeDesktopMainPageTextBlock002" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SetupCompletionSummary, Mode=OneWay}" AutomationProperties.AutomationId="SetupCompletionSummary" /></Grid>
                                                <ProgressBar Value="{x:Bind ViewModel.SetupProgressValue, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Minimum="0" Maximum="100" AutomationProperties.AutomationId="SetupProgress" x:Uid="SetupProgress" />
                                                <Grid ColumnSpacing="12" RowSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Text="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock003" x:Uid="chatAgentBridgeDesktopMainPageTextBlock003" /><TextBlock Text="{x:Bind ViewModel.SetupStepOneStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="SetupStepOneStatus" /></StackPanel>
                                                    <Button Grid.Row="0" Grid.Column="2" Click="OpenAgentSettings_Click" AutomationProperties.AutomationId="SetupAgentLink" x:Uid="SetupAgentLink" />
                                                    <TextBlock Grid.Row="1" Text="2" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock004" x:Uid="chatAgentBridgeDesktopMainPageTextBlock004" /><TextBlock Text="{x:Bind ViewModel.SetupStepTwoStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="SetupStepTwoStatus" /></StackPanel>
                                                    <Button Grid.Row="1" Grid.Column="2" Click="OpenConnections_Click" AutomationProperties.AutomationId="SetupConnectionsLink" x:Uid="SetupConnectionsLink" />
                                                    <TextBlock Grid.Row="2" Text="3" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Top" />
                                                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock005" x:Uid="chatAgentBridgeDesktopMainPageTextBlock005" /><TextBlock Text="{x:Bind ViewModel.SetupStepThreeStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="SetupStepThreeStatus" /></StackPanel>
                                                    <Button Grid.Row="2" Grid.Column="2" Click="OpenChat_Click" AutomationProperties.AutomationId="SetupChatLink" x:Uid="SetupChatLink" />
                                                </Grid>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="OverviewCliDetailsTitle" x:Uid="OverviewCliDetailsTitle" />
                                                    <TextBlock Text="{x:Bind ViewModel.CliVersion, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewCliVersion" />
                                                    <TextBlock Text="{x:Bind ViewModel.CliCheckSummary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="OverviewCliSummary" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind ViewModel.SetupNextAction, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="SetupNextAction" />
                                                <TextBlock Text="{x:Bind ViewModel.SetupDraftNotice, Mode=OneWay}" Visibility="{x:Bind local:MainPage.ToVisibility(ViewModel.HasSetupDraftNotice), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="SetupDraftNotice" />
                                                <Button Click="ReloadSettings_Click" IsEnabled="{x:Bind local:MainPage.CanReloadSettings(ViewModel.IsLoading, ViewModel.IsRunning), Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SetupReloadSettings" x:Uid="SetupReloadSettings" />
                                                <StackPanel Spacing="8" HorizontalAlignment="Left">
                                                    <Button Command="{x:Bind ViewModel.StartOnboardingCommand}" AutomationProperties.AutomationId="StartOnboarding" x:Uid="StartOnboarding" />
                                                    <Button Click="ShowTerms_Click" AutomationProperties.AutomationId="OverviewTerms" x:Uid="OverviewTerms" />
                                                    <Button Click="ShowPrivacy_Click" AutomationProperties.AutomationId="OverviewPrivacy" x:Uid="OverviewPrivacy" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="20" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="16">
                                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock006" x:Uid="chatAgentBridgeDesktopMainPageTextBlock006" />
                                                <Image Source="{x:Bind localization:LocalizedAssets.OverviewArchitecture, Mode=OneTime}" Stretch="Uniform" MaxWidth="1040" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="OverviewArchitecture" x:Uid="OverviewArchitecture" />
                                                <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock007" x:Uid="chatAgentBridgeDesktopMainPageTextBlock007" />
                                                <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock008" x:Uid="chatAgentBridgeDesktopMainPageTextBlock008" />
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="20" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock009" x:Uid="chatAgentBridgeDesktopMainPageTextBlock009" />
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock010" x:Uid="chatAgentBridgeDesktopMainPageTextBlock010" />
                                                <TextBlock Text="{x:Bind ViewModel.SavedAgentSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock011" x:Uid="chatAgentBridgeDesktopMainPageTextBlock011" />
                                                <TextBlock Text="{x:Bind ViewModel.WorkspaceRoot, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock012" x:Uid="chatAgentBridgeDesktopMainPageTextBlock012" />
                                                <TextBlock Text="{x:Bind ViewModel.SettingsLocation, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsLocation" />
                                            </StackPanel>
                                        </Border>
                                        <Button Click="OpenWorkbench_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="OpenWorkbench" x:Uid="OpenWorkbench" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <StackPanel Spacing="16" Visibility="{x:Bind local:MainPage.ToVisibility(IsAgentSelected), Mode=OneTime}">
                                <TextBlock  Style="{StaticResource TitleTextBlockStyle}"  AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock013" x:Uid="chatAgentBridgeDesktopMainPageTextBlock013" />
                                <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock014" x:Uid="chatAgentBridgeDesktopMainPageTextBlock014" />
                                <Border Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" AutomationProperties.AutomationId="WorkspaceCard">
                                    <StackPanel Spacing="8">
                                        <TextBlock  Style="{StaticResource SubtitleTextBlockStyle}"  AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock015" x:Uid="chatAgentBridgeDesktopMainPageTextBlock015" />
                                        <TextBox  Text="{x:Bind ViewModel.WorkspaceRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  AutomationProperties.AutomationId="WorkspaceRoot"   x:Uid="WorkspaceRoot" />
                                        <Button  Click="BrowseWorkspace_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="BrowseWorkspace"  x:Uid="BrowseWorkspace" />
                                        <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock016" x:Uid="chatAgentBridgeDesktopMainPageTextBlock016" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Spacing="12">
                                    <ComboBox  SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.AgentProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AgentProvider"  x:Uid="AgentProvider">
                                        <ComboBoxItem Content="Codex CLI" Tag="codex" AutomationProperties.AutomationId="ProviderOptionCodex" />
                                        <ComboBoxItem Content="Claude Code CLI" Tag="claude" AutomationProperties.AutomationId="ProviderOptionClaude" />
                                        <ComboBoxItem Content="Gemini CLI" Tag="gemini" AutomationProperties.AutomationId="ProviderOptionGemini" />
                                        <ComboBoxItem Content="GitHub Copilot CLI" Tag="github-copilot" AutomationProperties.AutomationId="ProviderOptionCopilot" />
                                        <ComboBoxItem  Tag="custom" AutomationProperties.AutomationId="ProviderOptionCustom"  x:Uid="ProviderOptionCustom" />
                                    </ComboBox>
                                    <TextBlock Text="{x:Bind ViewModel.BasicProviderHelp, Mode=OneWay}" Visibility="{x:Bind local:MainPage.ToVisibility(ViewModel.IsBasicProvider), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="BasicProviderHelp" />
                                    <Expander  HorizontalAlignment="Stretch" IsExpanded="True" AutomationProperties.AutomationId="AgentAdvanced" x:Uid="AgentAdvanced">
                                        <StackPanel Spacing="12">
                                            <TextBox  Text="{x:Bind ViewModel.AgentExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AgentExecutable" x:Uid="AgentExecutable" />
                                            <Button Click="BrowseAgentExecutable_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="BrowseAgentExecutable" x:Uid="BrowseAgentExecutable" />
                                            <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="BrowseAgentExecutableHelp" x:Uid="BrowseAgentExecutableHelp" />
                                            <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock017" x:Uid="chatAgentBridgeDesktopMainPageTextBlock017" />
                                            <TextBox  Text="{x:Bind ViewModel.AgentArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" IsEnabled="{x:Bind ViewModel.IsArgumentsEditable, Mode=OneWay}" AutomationProperties.AutomationId="AgentArguments"  x:Uid="AgentArguments" />
                                            <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock018" x:Uid="chatAgentBridgeDesktopMainPageTextBlock018" />
                                        </StackPanel>
                                    </Expander>
                                    <Button  Command="{x:Bind ViewModel.CheckCliCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SettingsCheckCli"  x:Uid="SettingsCheckCli" />
                                    <StackPanel Spacing="8">
                                        <Button Click="ReloadProcessEnvironment_Click" IsEnabled="{x:Bind local:MainPage.EnvironmentReloadAllowed(ViewModel.IsLoading, ViewModel.IsRunning, ViewModel.IsCheckingCli, ViewModel.ModelCatalog.IsLoading, ViewModel.IsOnboardingBusy, InboxPage.ViewModel.IsExecuting, ViewModel.SaveSettingsCommand.IsRunning), Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ReloadProcessEnvironment" x:Uid="ReloadProcessEnvironment" />
                                        <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="ReloadProcessEnvironmentHelp" x:Uid="ReloadProcessEnvironmentHelp" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind ViewModel.CliVersion, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.CliExecutablePath, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.CliCheckSummary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsCliCheckSummary" />
                                </StackPanel>
                                <StackPanel Spacing="12" Visibility="{x:Bind local:MainPage.ToHiddenVisibility(ViewModel.IsBasicProvider), Mode=OneWay}">

                                    <TextBox  MaxLength="256" Text="{x:Bind ViewModel.AgentModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.SupportsModel, Mode=OneWay}" AutomationProperties.AutomationId="AgentModel"   x:Uid="AgentModel" />
                                    <ComboBox  ItemsSource="{x:Bind ViewModel.ReasoningEffortCandidates, Mode=OneWay}" DisplayMemberPath="SelectionLabel" SelectedItem="{x:Bind ViewModel.SelectedReasoningEffort, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SupportsModel, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ReasoningEffortCandidates"   x:Uid="ReasoningEffortCandidates" />
