                                <Expander x:Name="CodexChatSharingSettings" AutomationProperties.AutomationId="CodexChatSharingSettings" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="{x:Bind local:MainPage.ToVisibility(ViewModel.IsCodexProvider), Mode=OneWay}" x:Uid="CodexChatSharingAccessible" localization:LocalizedResourceKey.Key="CodexChatSharingAccessible">
                                    <Expander.Header>
                                        <StackPanel Spacing="4" HorizontalAlignment="Stretch">
                                            <TextBlock TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="CodexChatSharingTitle" localization:LocalizedResourceKey.Key="CodexChatSharingTitle" />
                                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="CodexChatSharingHelp" localization:LocalizedResourceKey.Key="CodexChatSharingHelp" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="12">
                                        <TextBlock  Style="{StaticResource SubtitleTextBlockStyle}"  AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock059" x:Uid="chatAgentBridgeDesktopMainPageTextBlock059" />
                                        <ToggleSwitch  IsOn="{x:Bind ViewModel.ShareApprovalsInChat, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanShareApprovalsInChat, Mode=OneWay}" AutomationProperties.AutomationId="ShareApprovalsInChat"  x:Uid="ShareApprovalsInChat" />
                                        <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="chatAgentBridgeDesktopMainPageTextBlock060" x:Uid="chatAgentBridgeDesktopMainPageTextBlock060" />
                                        <ToggleSwitch IsOn="{x:Bind ViewModel.ShareAgentQuestionsInChat, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanShareApprovalsInChat, Mode=OneWay}" AutomationProperties.AutomationId="ShareAgentQuestionsInChat" x:Uid="ShareAgentQuestionsInChat" />
                                        <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="ShareAgentQuestionsInChatHelp" x:Uid="ShareAgentQuestionsInChatHelp" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <inbox:ChatInboxPage x:Name="InboxPage" Grid.Row="3" Visibility="{x:Bind local:MainPage.ToVisibility(IsChatSelected), Mode=OneTime}" IsEnabled="{x:Bind ViewModel.IsSettingsLoaded, Mode=OneWay}" />
                    <history:HistoryPage x:Name="HistoryPage" Grid.Row="3" Visibility="{x:Bind local:MainPage.ToVisibility(IsHistorySelected), Mode=OneTime}" />
                    <about:AboutPage x:Name="AboutPage" Grid.Row="3" Visibility="{x:Bind local:MainPage.ToVisibility(IsAboutSelected), Mode=OneTime}" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
        <ContentControl x:Name="WizardHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="{x:Bind local:MainPage.ToVisibility(ViewModel.IsOnboardingActive), Mode=OneWay}" AutomationProperties.AutomationId="WizardHost" />
    </Grid>
</Page>
