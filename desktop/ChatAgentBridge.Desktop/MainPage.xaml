<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChatAgentBridge_Desktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChatAgentBridge_Desktop"
    xmlns:inbox="using:ChatAgentBridge_Desktop.Inbox"
    xmlns:history="using:ChatAgentBridge_Desktop.History"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <NavigationView x:Name="MainNavigation"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto" OpenPaneLength="240"
                        SelectionChanged="MainNavigation_SelectionChanged"
                        AutomationProperties.Name="メイン ナビゲーション"
                        AutomationProperties.AutomationId="MainNavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概要" Tag="overview" AutomationProperties.Name="概要" AutomationProperties.AutomationId="NavOverview">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="手動で実行" Tag="workbench" AutomationProperties.Name="手動で実行" AutomationProperties.AutomationId="NavWorkbench">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="エージェント設定" Tag="agent" AutomationProperties.AutomationId="NavAgentSettings" Icon="Setting" />
                <NavigationViewItem Content="接続設定" Tag="connections" AutomationProperties.Name="接続設定" AutomationProperties.AutomationId="NavConnections">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="チャット受信" Tag="chat" AutomationProperties.AutomationId="NavChat" Icon="Message" />
                <NavigationViewItem Content="履歴と会話" Tag="history" AutomationProperties.AutomationId="NavHistory" Icon="Clock" />
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <InfoBar Grid.Row="0" Margin="0,0,0,16" AutomationProperties.AutomationId="ExecutionStatus"
                             IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                             Severity="{x:Bind local:MainPage.ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}"
                             Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                             Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    <Button Grid.Row="1" Margin="0,0,0,12" Content="設定を再読み込み" Click="ReloadSettings_Click"
                            IsEnabled="{x:Bind local:MainPage.CanReloadSettings(ViewModel.IsLoading, ViewModel.IsRunning), Mode=OneWay}"
                            Visibility="{x:Bind local:MainPage.ToHiddenVisibility(ViewModel.IsSettingsLoaded), Mode=OneWay}"
                            HorizontalAlignment="Left" AutomationProperties.AutomationId="ReloadSettings" />

                    <Button Grid.Row="1" Content="エージェント設定を保存" Margin="0,0,0,12" Command="{x:Bind ViewModel.SaveSettingsCommand}" Visibility="{x:Bind local:MainPage.ToVisibility(IsAgentSelected), Mode=OneTime}" AutomationProperties.AutomationId="SaveSettings" />
                    <ScrollViewer Grid.Row="2" Visibility="{x:Bind local:MainPage.ToVisibility(IsFormSelected), Mode=OneTime}" IsEnabled="{x:Bind ViewModel.IsSettingsLoaded, Mode=OneWay}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid MaxWidth="1040" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="16" Visibility="{x:Bind local:MainPage.ToVisibility(IsOverviewSelected), Mode=OneTime}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Chat Agent Bridge" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock Text="CodexやClaude Codeのデスクトップアプリを使えない端末から、Slack/Mattermostを窓口に、起動中のローカルPCのAIエージェントへ依頼できます。" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Padding="20" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="チャットを窓口に、ローカルPCへ依頼" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                        <Image Source="ms-appx:///Assets/OverviewArchitecture.png" Stretch="Uniform" MaxWidth="1040" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="OverviewArchitecture" AutomationProperties.Name="別の端末のSlackまたはMattermostから依頼し、起動中のPCのChat Agent Bridgeが受け取ります。PCで確認後、Codex CLIまたはClaude Code CLIを実行し、確認して共有した結果を同じスレッドで受け取ります。" />
                                        <TextBlock Text="図の説明：スマートフォンやブラウザーからSlackまたはMattermostへ送った依頼を、チャット経由で起動中のローカルPCのChat Agent Bridgeが受け取り、Codex CLIまたはClaude Code CLIを設定済みプロジェクトで実行します。結果は同じチャットへ返ります。AI処理の場所はCLIやモデルの提供形態によります。" TextWrapping="Wrap" />
                                        <TextBlock Text="1. エージェント設定でCLI・モデル・作業フォルダーを設定します。&#x0a;2. 接続設定を保存し、チャット受信からSlackまたはMattermostへ接続します。&#x0a;3. 別の端末から依頼を送ります。Mattermostは対象チャンネルで !cab 依頼内容、SlackはBotへのメンションまたはスレッドへの返信に !cab 依頼内容を含めます。&#x0a;4. PCで依頼を確認して実行し、結果を確認して共有を承認すると、同じスレッドへ返ります。&#x0a;&#x0a;ローカルPCではこのアプリを起動し、SlackまたはMattermostとの接続を保ってください。" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="20" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="保存済みの設定" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <TextBlock Text="エージェント" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SavedAgentSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Text="ワークスペース" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.WorkspaceRoot, Mode=OneWay}" TextWrapping="Wrap" />
                                        <TextBlock Text="設定の保存先" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind ViewModel.SettingsLocation, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="SettingsLocation" />
                                    </StackPanel>
                                </Border>
                                <Button Content="手動で実行する" Click="OpenWorkbench_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="OpenWorkbench" />
                            </StackPanel>

                            <StackPanel Spacing="16" Visibility="{x:Bind local:MainPage.ToVisibility(IsAgentSelected), Mode=OneTime}">
                                <TextBlock Text="エージェント設定" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="このアプリから次に実行するCLIとモデルを設定します。CLI自身の設定ファイルは変更しません。利用前にCLIのインストールとログインが必要です。" TextWrapping="Wrap" />
                                <StackPanel Spacing="12">
                                    <ComboBox Header="使うエージェント" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.AgentProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AgentProvider" AutomationProperties.Name="使うエージェント">
                                        <ComboBoxItem Content="Codex CLI" Tag="codex" AutomationProperties.AutomationId="ProviderOptionCodex" />
                                        <ComboBoxItem Content="Claude Code CLI" Tag="claude" AutomationProperties.AutomationId="ProviderOptionClaude" />
                                        <ComboBoxItem Content="その他のCLI（詳細設定）" Tag="custom" AutomationProperties.AutomationId="ProviderOptionCustom" />
                                    </ComboBox>
                                    <TextBox Header="モデル名（空欄ならCLIの既定値）" MaxLength="256" Text="{x:Bind ViewModel.AgentModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.SupportsModel, Mode=OneWay}" AutomationProperties.AutomationId="AgentModel" AutomationProperties.Name="モデル名" />
                                    <ComboBox Header="推論の強さ（CLIの候補）" ItemsSource="{x:Bind ViewModel.ReasoningEffortCandidates, Mode=OneWay}" DisplayMemberPath="SelectionLabel" SelectedItem="{x:Bind ViewModel.SelectedReasoningEffort, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SupportsModel, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ReasoningEffortCandidates" AutomationProperties.Name="推論レベル候補" />
                                    <TextBlock Text="{x:Bind ViewModel.ModelEffortStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="ReasoningEffortStatus" />
                                    <TextBlock Text="候補を取得すると、現在のモデルがCLIから報告した推論レベルだけを選べます。「CLIの既定値」を選ぶと、強さの指定をCLIに任せます。モデル別の対応が未取得の場合は保存値をそのまま保持します。" TextWrapping="Wrap" />
                                    <TextBlock Text="契約で使えるモデル名やエイリアスを入力します。モデルによって料金・速度・精度が変わります。保存済みの会話ごとに変える場合は「履歴と会話」から指定できます。" TextWrapping="Wrap" />
                                    <StackPanel Spacing="8">
                                        <Button Content="CLIモデル候補を取得" Command="{x:Bind ViewModel.ModelCatalog.FetchModelsCommand}" IsEnabled="{x:Bind ViewModel.CanFetchModelCandidates, Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="FetchModels" />
                                        <ProgressRing IsActive="{x:Bind ViewModel.ModelCatalog.IsLoading, Mode=OneWay}" Visibility="{x:Bind local:MainPage.ToVisibility(ViewModel.ModelCatalog.IsLoading), Mode=OneWay}" Width="20" Height="20" HorizontalAlignment="Left" />
                                        <Button Content="取得をキャンセル" Command="{x:Bind ViewModel.ModelCatalog.CancelFetchCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="CancelFetchModels" />
                                        <ComboBox Header="CLIが提示したモデル候補" ItemsSource="{x:Bind ViewModel.ModelCatalog.Models, Mode=OneWay}" DisplayMemberPath="SelectionLabel" SelectedItem="{x:Bind ViewModel.ModelCatalog.SelectedModel, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SupportsModel, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ModelCandidates" AutomationProperties.Name="モデル候補" />
                                        <TextBlock Text="{x:Bind ViewModel.ModelCatalog.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="ModelCatalogStatus" />
                                        <TextBlock Text="候補はCLIの報告値です。契約上の利用可否は実行時に確認されます。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBox Header="作業フォルダー" Text="{x:Bind ViewModel.WorkspaceRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例: C:\Projects\my-app" AutomationProperties.AutomationId="WorkspaceRoot" AutomationProperties.Name="作業フォルダー" />
                                    <TextBlock Text="エージェントがファイルを読み書きするプロジェクトのフォルダーです。チャットからこの場所を変更することはできません。" TextWrapping="Wrap" />
                                    <ToggleSwitch Header="実行中の操作許可・質問を画面で受け取る（Codex専用）" IsOn="{x:Bind ViewModel.UseAppServer, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsCodexProvider, Mode=OneWay}" AutomationProperties.AutomationId="UseAppServer" />
                                    <TextBlock Text="オンではCodex App Serverを利用します。オフではCLIへ依頼を渡して完了を待ちます。Claude Codeも会話を継続しますが、実行中の追加質問には対応しません。" TextWrapping="Wrap" />
                                    <ToggleSwitch Header="手動実行の前に内容を確認する" IsOn="{x:Bind ViewModel.RequireApproval, Mode=TwoWay}" AutomationProperties.AutomationId="RequireApproval" />
                                    <TextBlock Text="チャットから届いた依頼は、この設定にかかわらず毎回PCで確認します。" TextWrapping="Wrap" />
                                    <Expander Header="詳細：CLIの場所と起動引数" HorizontalAlignment="Stretch" IsExpanded="True" AutomationProperties.AutomationId="AgentAdvanced">
                                        <StackPanel Spacing="12">
                                            <TextBox Header="CLI実行ファイル" Text="{x:Bind ViewModel.AgentExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AgentExecutable" AutomationProperties.Name="CLI実行ファイル" />
                                            <TextBlock Text="通常はcodexまたはclaudeです。見つからない場合は実行ファイルのフルパスを指定してください。" TextWrapping="Wrap" />
                                            <TextBox Header="その他のCLIの起動引数" Text="{x:Bind ViewModel.AgentArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" IsEnabled="{x:Bind ViewModel.IsCustomProvider, Mode=OneWay}" AutomationProperties.AutomationId="AgentArguments" />
                                            <TextBlock Text="Codex・Claude Codeの標準引数とモデル指定はアプリが組み立てます。その他のCLIは標準入力から依頼文を受け取れる形式を指定してください。" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Expander>
                                    <TextBlock Text="起動と接続" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <ToggleSwitch Header="Windowsログイン時にこのアプリを起動" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=OneWay}" Toggled="StartupToggle_Toggled" IsEnabled="{x:Bind ViewModel.CanChangeStartup, Mode=OneWay}" AutomationProperties.AutomationId="StartWithWindows" />
                                    <TextBlock Text="{x:Bind ViewModel.StartupStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="StartupStatus" />
                                    <ComboBox Header="アプリ起動後に自動接続するチャット" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.AutoConnectProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="AutoConnectProvider">
                                        <ComboBoxItem Content="接続しない" Tag="none" AutomationProperties.AutomationId="AutoConnectOptionNone" />
                                        <ComboBoxItem Content="Mattermost" Tag="mattermost" AutomationProperties.AutomationId="AutoConnectOptionMattermost" />
                                        <ComboBoxItem Content="Slack" Tag="slack" AutomationProperties.AutomationId="AutoConnectOptionSlack" />
                                    </ComboBox>
                                    <TextBlock Text="接続情報を保存したチャットへ、次回のアプリ起動時に接続します。依頼の自動実行や、ウィンドウを閉じた後の常駐は行いません。" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="12" Visibility="{x:Bind local:MainPage.ToVisibility(IsWorkbenchSelected), Mode=OneTime}">
                                <TextBlock Text="手動で実行" Style="{StaticResource TitleTextBlockStyle}" />
                                <TextBlock Text="このPCからエージェントに依頼します。実行するCLI・モデル・作業フォルダーは「エージェント設定」で変更できます。" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.SavedAgentSummary, Mode=OneWay}" TextWrapping="Wrap" />
                                <HyperlinkButton Content="エージェント設定を開く" Click="OpenAgentSettings_Click" AutomationProperties.AutomationId="OpenAgentSettings" />
                                <TextBox Header="依頼内容" Text="{x:Bind ViewModel.Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180" AutomationProperties.AutomationId="Prompt" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="実行" Command="{x:Bind ViewModel.RunCommand}" AutomationProperties.AutomationId="RunAgent" />
                                    <Button Content="実行を停止" Command="{x:Bind ViewModel.CancelRunCommand}" AutomationProperties.AutomationId="CancelAgent" />
                                </StackPanel>
                                <TextBox Header="実行結果（このPCのみ）" Text="{x:Bind ViewModel.Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="400" AutomationProperties.AutomationId="AgentOutput" />
                                <TextBlock Text="{x:Bind ViewModel.UsageSummary, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="LocalUsageSummary" />
                            </StackPanel>
                            <StackPanel Spacing="16" Visibility="{x:Bind local:MainPage.ToVisibility(IsConnectionsSelected), Mode=OneTime}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="接続設定" Style="{StaticResource TitleTextBlockStyle}" />
                                    <TextBlock Text="Mattermost と Slack の認証情報をこのデバイスに保存します。保存後に「チャット受信」から接続してください。" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Padding="20" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Mattermost" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="サーバーURLは利用中のMattermostのアドレスです。チャンネルIDは表示名とは異なる識別子で、このチャンネルだけを受信します。接続するユーザーの権限で読み取り・投稿するため、そのユーザーを対象チャンネルへ参加させてください。" TextWrapping="Wrap" />
                                        <StackPanel Spacing="8"><TextBlock Text="サーバー URL" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBox Text="{x:Bind ViewModel.MattermostServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://chat.example.com" AutomationProperties.Name="Mattermost サーバー URL" AutomationProperties.AutomationId="MattermostServerUrl" /></StackPanel>
                                        <StackPanel Spacing="8"><TextBlock Text="受信するチャンネルのID" Style="{StaticResource BodyStrongTextBlockStyle}" /><TextBox Text="{x:Bind ViewModel.MattermostChannelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mattermost チャンネル ID" AutomationProperties.AutomationId="MattermostChannelId" /></StackPanel>
                                        <StackPanel Spacing="8"><TextBlock Text="接続するユーザーのアクセストークン" Style="{StaticResource BodyStrongTextBlockStyle}" /><PasswordBox x:Name="MattermostTokenBox" PasswordChanged="MattermostTokenBox_PasswordChanged" AutomationProperties.Name="Mattermost アクセストークン" AutomationProperties.AutomationId="MattermostToken" /></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Padding="20" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="Slack" Style="{StaticResource SubtitleTextBlockStyle}" /><TextBlock Text="Botトークンは投稿用、AppトークンはSocket Modeで依頼を受信するために使います。Slackアプリ側の権限・イベント購読の設定と、Botのチャンネル参加が必要です。" TextWrapping="Wrap" />
                                        <StackPanel Spacing="8"><TextBlock Text="Botトークン（xoxb-で始まる値）" Style="{StaticResource BodyStrongTextBlockStyle}" /><PasswordBox x:Name="SlackBotTokenBox" PasswordChanged="SlackBotTokenBox_PasswordChanged" AutomationProperties.Name="Slack Bot トークン" AutomationProperties.AutomationId="SlackBotToken" /></StackPanel>
                                        <StackPanel Spacing="8"><TextBlock Text="Socket Mode用Appトークン（xapp-で始まる値）" Style="{StaticResource BodyStrongTextBlockStyle}" /><PasswordBox x:Name="SlackAppTokenBox" PasswordChanged="SlackAppTokenBox_PasswordChanged" AutomationProperties.Name="Slack App トークン" AutomationProperties.AutomationId="SlackAppToken" /></StackPanel>
                                    </StackPanel>
                                </Border>
                                <Button Content="接続設定を保存" Command="{x:Bind ViewModel.SaveSettingsCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="SaveConnections" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                    <inbox:ChatInboxPage x:Name="InboxPage" Grid.Row="2" Visibility="{x:Bind local:MainPage.ToVisibility(IsChatSelected), Mode=OneTime}" IsEnabled="{x:Bind ViewModel.IsSettingsLoaded, Mode=OneWay}" />
                    <history:HistoryPage x:Name="HistoryPage" Grid.Row="2" Visibility="{x:Bind local:MainPage.ToVisibility(IsHistorySelected), Mode=OneTime}" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Page>
