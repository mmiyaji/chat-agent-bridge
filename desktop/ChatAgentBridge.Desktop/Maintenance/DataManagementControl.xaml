<UserControl x:Class="ChatAgentBridge_Desktop.Maintenance.DataManagementControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:settings="using:CommunityToolkit.WinUI.Controls">
 <settings:SettingsExpander x:Name="Group" AutomationProperties.AutomationId="DataManagementGroup">
  <settings:SettingsExpander.HeaderIcon><SymbolIcon Symbol="Save" /></settings:SettingsExpander.HeaderIcon>
  <settings:SettingsExpander.Items>
   <settings:SettingsCard x:Name="LocationCard">
    <settings:SettingsCard.Description><TextBlock x:Name="Location" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DataManagementLocation" /></settings:SettingsCard.Description>
    <Button x:Name="OpenButton" Click="Open_Click" AutomationProperties.AutomationId="DataOpenFolder" />
   </settings:SettingsCard>
   <settings:SettingsCard x:Name="ExportCard"><Button x:Name="ExportButton" Click="Export_Click" AutomationProperties.AutomationId="SettingsBackupExport" /></settings:SettingsCard>
   <settings:SettingsCard x:Name="ImportCard"><Button x:Name="ImportButton" Click="Import_Click" AutomationProperties.AutomationId="SettingsBackupImport" /></settings:SettingsCard>
   <settings:SettingsCard x:Name="ClearCard"><Button x:Name="ClearButton" Click="Clear_Click" AutomationProperties.AutomationId="DataClear" /></settings:SettingsCard>
   <settings:SettingsCard>
    <settings:SettingsCard.Description><TextBlock x:Name="Sizes" TextWrapping="Wrap" AutomationProperties.AutomationId="DataManagementSizes" /></settings:SettingsCard.Description>
    <Button x:Name="RefreshButton" Click="Refresh_Click" AutomationProperties.AutomationId="DataRefresh" />
   </settings:SettingsCard>
   <TextBlock x:Name="Status" Margin="16,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="DataManagementStatus" />
  </settings:SettingsExpander.Items>
 </settings:SettingsExpander>
</UserControl>
