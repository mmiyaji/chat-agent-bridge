<UserControl
    x:Class="ChatAgentBridge_Desktop.Maintenance.AdvancedSettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maintenance="using:ChatAgentBridge_Desktop.Maintenance"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="AdvancedSettingsControl">
    <settings:SettingsExpander x:Name="AdvancedExpander" IsExpanded="False"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                               AutomationProperties.AutomationId="AdvancedSettingsExpander">
        <settings:SettingsExpander.Header>
            <TextBlock x:Name="AdvancedHeading" Style="{StaticResource BodyTextBlockStyle}"
                       AutomationProperties.AutomationId="AdvancedSettingsHeading" />
        </settings:SettingsExpander.Header>
        <settings:SettingsExpander.Description>
            <TextBlock x:Name="AdvancedDescription" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="AdvancedSettingsDescription" />
        </settings:SettingsExpander.Description>
        <settings:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xE713;" />
        </settings:SettingsExpander.HeaderIcon>
        <settings:SettingsExpander.Items>
            <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="24" HorizontalAlignment="Stretch">
                    <!-- Keep future advanced sections as siblings of LogRetentionControl in this container. -->
                    <maintenance:LogRetentionControl x:Name="LogManagementControl" />
                </StackPanel>
            </settings:SettingsCard>
        </settings:SettingsExpander.Items>
    </settings:SettingsExpander>
</UserControl>
