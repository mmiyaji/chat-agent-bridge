<UserControl
    x:Class="ChatAgentBridge_Desktop.Maintenance.UpdateCacheMaintenanceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.AutomationId="UpdateCacheMaintenanceControl">
    <settings:SettingsExpander x:Uid="UpdateCacheMaintenanceSection" IsExpanded="False"
                               HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                               AutomationProperties.AutomationId="UpdateCacheMaintenanceSection">
        <settings:SettingsExpander.HeaderIcon>
            <FontIcon Glyph="&#xE713;" />
        </settings:SettingsExpander.HeaderIcon>
        <settings:SettingsExpander.Items>
            <settings:SettingsCard Padding="{StaticResource SettingsExpanderBodyPadding}" x:Uid="PortableUpdateCacheCleanupRow"
                                   AutomationProperties.AutomationId="AdvancedUpdateCacheCleanupRow">
                <settings:SettingsCard.Description>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="PortableUpdateCacheCleanupHelp" TextWrapping="Wrap" />
                        <TextBlock x:Name="CacheCleanupStatus" TextWrapping="Wrap" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.AutomationId="PortableUpdateCacheCleanupStatus" />
                    </StackPanel>
                </settings:SettingsCard.Description>
                <Button x:Name="CleanCacheButton" x:Uid="PortableUpdateCleanCache"
                        Click="CleanCache_Click"
                        AutomationProperties.AutomationId="PortableUpdateCleanCache" />
            </settings:SettingsCard>
        </settings:SettingsExpander.Items>
    </settings:SettingsExpander>
</UserControl>
