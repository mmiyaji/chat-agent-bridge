<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Lightweight overrides retain the platform template, focus and disabled states. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonBackground" Color="#0CA4262C" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#18A4262C" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24A4262C" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#409B3038" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#609B3038" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#609B3038" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#9B3038" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#9B3038" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#9B3038" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonBackground" Color="#14FFB4B8" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22FFB4B8" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#30FFB4B8" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#48FFB4B8" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#68FFB4B8" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#68FFB4B8" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFB4B8" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFB4B8" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFB4B8" />
        </ResourceDictionary>
        <!-- Use the platform's system-color pairs in Windows contrast themes. -->
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
