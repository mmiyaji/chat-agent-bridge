<Page
    x:Class="ChatAgentBridge_Desktop.About.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization"
    xmlns:deployment="using:ChatAgentBridge_Desktop.Deployment"
    xmlns:diagnostics="using:ChatAgentBridge_Desktop.Diagnostics"
    xmlns:maintenance="using:ChatAgentBridge_Desktop.Maintenance"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls">
    <Grid RowSpacing="16" AutomationProperties.AutomationId="AboutPage">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Uid="AboutHeading" Style="{StaticResource TitleTextBlockStyle}" localization:LocalizedResourceKey.Key="AboutHeading" />
            <TextBlock x:Uid="AboutDescription" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" localization:LocalizedResourceKey.Key="AboutDescription" />
        </StackPanel>
        <ScrollViewer x:Name="AboutScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="AboutScroll">
            <StackPanel Spacing="{StaticResource SettingsCardSpacing}" AutomationProperties.AutomationId="AboutContent">
                <!-- Like WinUI Gallery: name, author and version on the header; build details fold beneath. -->
                <settings:SettingsExpander x:Name="AppDetailsExpander" AutomationProperties.AutomationId="AboutTechnicalDetails">
                    <settings:SettingsExpander.Header>
                        <TextBlock x:Name="ProductValue" TextWrapping="Wrap" AutomationProperties.AutomationId="AboutProduct" />
                    </settings:SettingsExpander.Header>
                    <settings:SettingsExpander.Description>
                        <TextBlock x:Uid="AboutProviderValue" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AboutProvider" localization:LocalizedResourceKey.Key="AboutProviderValue" />
                    </settings:SettingsExpander.Description>
                    <settings:SettingsExpander.HeaderIcon>
                        <BitmapIcon UriSource="ms-appx:///Assets/Square150x150Logo.scale-200.png" ShowAsMonochrome="False" />
                    </settings:SettingsExpander.HeaderIcon>
                    <TextBlock x:Name="VersionValue" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.AutomationId="AboutVersion" />
                    <settings:SettingsExpander.Items>
                        <settings:SettingsCard x:Uid="AboutBuildTimestampLabel" AutomationProperties.AutomationId="AboutBuildTimestampRow" localization:LocalizedResourceKey.Key="AboutBuildTimestampLabel">
                            <TextBlock x:Name="BuildTimestampValue" TextWrapping="Wrap" AutomationProperties.AutomationId="AboutBuildTimestamp" />
                        </settings:SettingsCard>
                        <settings:SettingsCard x:Uid="AboutPackageLabel" AutomationProperties.AutomationId="AboutPackageRow" localization:LocalizedResourceKey.Key="AboutPackageLabel">
                            <TextBlock x:Name="PackageValue" TextWrapping="Wrap" AutomationProperties.AutomationId="AboutPackage" />
                        </settings:SettingsCard>
                    </settings:SettingsExpander.Items>
                </settings:SettingsExpander>

                <settings:SettingsCard x:Name="StoreUpdateCard" x:Uid="AboutStoreHeading"
                                       AutomationProperties.AutomationId="StoreUpdateCard" localization:LocalizedResourceKey.Key="AboutStoreHeading">
                        <settings:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE719;" /></settings:SettingsCard.HeaderIcon>
                        <settings:SettingsCard.Description>
                            <TextBlock x:Name="StoreStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="AboutStoreStatus" />
                        </settings:SettingsCard.Description>
                        <StackPanel Spacing="8">
                            <Button x:Name="StorePageButton" x:Uid="AboutStorePage" HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="AboutStorePage" Click="OpenStore_Click" />
                            <Button x:Name="CheckUpdatesButton" x:Uid="AboutCheckUpdates" HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="AboutCheckUpdates" Click="CheckUpdates_Click" />
                        </StackPanel>
                </settings:SettingsCard>

                <deployment:PortableUpdateControl />

                <HyperlinkButton x:Name="PackageReleaseNotesLink" x:Uid="PortableUpdateReleaseNotes"
                                 NavigateUri="https://github.com/mmiyaji/chat-agent-bridge/releases"
                                 HorizontalAlignment="Left" AutomationProperties.AutomationId="AboutReleaseNotes" localization:LocalizedResourceKey.Key="PortableUpdateReleaseNotes" />

                <TextBlock x:Uid="AboutLinksHeading" Style="{StaticResource SettingsSectionHeaderStyle}" localization:LocalizedResourceKey.Key="AboutLinksHeading" />
                <settings:SettingsCard x:Uid="AboutWebsite" IsClickEnabled="True" Click="OpenLink_Click"
                                       Tag="https://ruhenheim.org" AutomationProperties.AutomationId="AboutWebsite">
                    <settings:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE774;" /></settings:SettingsCard.HeaderIcon>
                    <settings:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></settings:SettingsCard.ActionIcon>
                </settings:SettingsCard>
                <settings:SettingsCard x:Uid="AboutSupport" IsClickEnabled="True" Click="OpenLink_Click"
                                       Tag="https://github.com/mmiyaji/chat-agent-bridge/issues" AutomationProperties.AutomationId="AboutSupport">
                    <settings:SettingsCard.HeaderIcon><SymbolIcon Symbol="Message" /></settings:SettingsCard.HeaderIcon>
                    <settings:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></settings:SettingsCard.ActionIcon>
                </settings:SettingsCard>
                <TextBlock x:Name="ActionStatus" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="AboutActionStatus"
                           AutomationProperties.LiveSetting="Polite" />

                <TextBlock x:Uid="AboutLegalHeading" Style="{StaticResource SettingsSectionHeaderStyle}" localization:LocalizedResourceKey.Key="AboutLegalHeading" />
                <TextBlock x:Uid="AboutDataHandling" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" localization:LocalizedResourceKey.Key="AboutDataHandling" />
                <settings:SettingsCard x:Uid="AboutTerms" IsClickEnabled="True" Click="Terms_Click"
                                       AutomationProperties.AutomationId="AboutTerms">
                    <settings:SettingsCard.HeaderIcon><SymbolIcon Symbol="Document" /></settings:SettingsCard.HeaderIcon>
                </settings:SettingsCard>
                <settings:SettingsCard x:Uid="AboutPrivacy" IsClickEnabled="True" Click="Privacy_Click"
                                       AutomationProperties.AutomationId="AboutPrivacy">
                    <settings:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE72E;" /></settings:SettingsCard.HeaderIcon>
                </settings:SettingsCard>
                <settings:SettingsCard x:Uid="AboutThirdPartyLicenses" IsClickEnabled="True" Click="ThirdPartyLicenses_Click"
                                       localization:LocalizedResourceKey.Key="AboutThirdPartyLicenses"
                                       AutomationProperties.AutomationId="AboutThirdPartyLicenses">
                    <settings:SettingsCard.HeaderIcon><SymbolIcon Symbol="Library" /></settings:SettingsCard.HeaderIcon>
                </settings:SettingsCard>

                <TextBlock x:Name="DiagnosticsAndSettingsHeading" Style="{StaticResource SettingsSectionHeaderStyle}"
                           AutomationProperties.AutomationId="DiagnosticsAndSettingsHeading" />
                <settings:SettingsExpander x:Uid="AboutDiagnostics" localization:LocalizedResourceKey.Key="AboutDiagnostics"
                                           AutomationProperties.AutomationId="AboutDiagnostics">
                    <settings:SettingsExpander.HeaderIcon><SymbolIcon Symbol="Help" /></settings:SettingsExpander.HeaderIcon>
                    <settings:SettingsExpander.Items>
                        <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <diagnostics:DiagnosticsControl />
                        </settings:SettingsCard>
                    </settings:SettingsExpander.Items>
                </settings:SettingsExpander>
                <maintenance:AdvancedSettingsControl x:Name="AdvancedSettings" />
                <Button x:Uid="AboutExit" HorizontalAlignment="Left" Margin="0,8,0,0"
                        AutomationProperties.AutomationId="AboutExit" Click="Exit_Click">
                            <Button.Resources><ResourceDictionary Source="ms-appx:///ImpactActionResources.xaml" /></Button.Resources>
                        </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
