<UserControl
    x:Class="ChatAgentBridge_Desktop.Diagnostics.DiagnosticsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:layout="using:ChatAgentBridge_Desktop.Layout"
    AutomationProperties.AutomationId="DiagnosticsControl">
    <UserControl.Resources>
        <Style x:Key="DiagnosticLabelStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <StackPanel Spacing="8" AutomationProperties.AutomationId="DiagnosticsContent">
        <settings:SettingsExpander x:Name="ReleaseCard" AutomationProperties.AutomationId="DiagnosticsReleaseCard" IsExpanded="True">
            <settings:SettingsExpander.Header><TextBlock x:Name="ReleaseAndSystemHeader" Style="{StaticResource BodyStrongTextBlockStyle}" /></settings:SettingsExpander.Header>
            <settings:SettingsExpander.Items>
                <settings:SettingsCard Padding="{StaticResource SettingsExpanderBodyPadding}" layout:SettingsCardLayout.IsAdaptive="True" AutomationProperties.AutomationId="DiagnosticsVersionRow"><settings:SettingsCard.Header><TextBlock x:Name="ApplicationVersionLabel" Style="{StaticResource DiagnosticLabelStyle}" /></settings:SettingsCard.Header><TextBlock x:Name="ProductVersion" AutomationProperties.AutomationId="DiagnosticsVersion" /></settings:SettingsCard>
                <settings:SettingsCard Padding="{StaticResource SettingsExpanderBodyPadding}" layout:SettingsCardLayout.IsAdaptive="True" AutomationProperties.AutomationId="DiagnosticsBuildRow"><settings:SettingsCard.Header><TextBlock x:Name="BuildMetadataLabel" Style="{StaticResource DiagnosticLabelStyle}" /></settings:SettingsCard.Header><TextBlock x:Name="BuildValue" TextWrapping="Wrap" AutomationProperties.AutomationId="DiagnosticsBuild" /></settings:SettingsCard>
                <settings:SettingsCard Padding="{StaticResource SettingsExpanderBodyPadding}" layout:SettingsCardLayout.IsAdaptive="True" AutomationProperties.AutomationId="DiagnosticsWindowsRow"><settings:SettingsCard.Header><TextBlock x:Name="WindowsRuntimeLabel" Style="{StaticResource DiagnosticLabelStyle}" /></settings:SettingsCard.Header><TextBlock x:Name="WindowsValue" TextWrapping="Wrap" AutomationProperties.AutomationId="DiagnosticsWindows" /></settings:SettingsCard>
            </settings:SettingsExpander.Items>
        </settings:SettingsExpander>
        <settings:SettingsExpander x:Name="ConnectionsCard" AutomationProperties.AutomationId="DiagnosticsConnectionsCard" IsExpanded="True">
            <settings:SettingsExpander.Header><TextBlock x:Name="ConfigurationStatusHeader" Style="{StaticResource BodyStrongTextBlockStyle}" /></settings:SettingsExpander.Header>
            <settings:SettingsExpander.Items>
                <settings:SettingsCard Padding="{StaticResource SettingsExpanderBodyPadding}" layout:SettingsCardLayout.IsAdaptive="True" AutomationProperties.AutomationId="DiagnosticsProviderRow"><settings:SettingsCard.Header><TextBlock x:Name="SavedCliProviderLabel" Style="{StaticResource DiagnosticLabelStyle}" /></settings:SettingsCard.Header><TextBlock x:Name="ProviderValue" AutomationProperties.AutomationId="DiagnosticsProvider" /></settings:SettingsCard>
                <settings:SettingsCard Padding="{StaticResource SettingsExpanderBodyPadding}" layout:SettingsCardLayout.IsAdaptive="True" AutomationProperties.AutomationId="DiagnosticsCliRow"><settings:SettingsCard.Header><TextBlock x:Name="CliVerificationLabel" Style="{StaticResource DiagnosticLabelStyle}" /></settings:SettingsCard.Header><TextBlock x:Name="CliValue" TextWrapping="Wrap" AutomationProperties.AutomationId="DiagnosticsCliVerification" /></settings:SettingsCard>
                <settings:SettingsCard Padding="{StaticResource SettingsExpanderBodyPadding}" layout:SettingsCardLayout.IsAdaptive="True" AutomationProperties.AutomationId="DiagnosticsChatRow"><settings:SettingsCard.Header><TextBlock x:Name="ChatConnectionLabel" Style="{StaticResource DiagnosticLabelStyle}" /></settings:SettingsCard.Header><TextBlock x:Name="ChatValue" TextWrapping="Wrap" AutomationProperties.AutomationId="DiagnosticsChatStatus" /></settings:SettingsCard>
                <settings:SettingsCard Padding="{StaticResource SettingsExpanderBodyPadding}" layout:SettingsCardLayout.IsAdaptive="True" AutomationProperties.AutomationId="DiagnosticsUpdaterRow"><settings:SettingsCard.Header><TextBlock x:Name="UpdaterLabel" Style="{StaticResource DiagnosticLabelStyle}" /></settings:SettingsCard.Header><TextBlock x:Name="UpdaterValue" TextWrapping="Wrap" AutomationProperties.AutomationId="DiagnosticsUpdaterStatus" /></settings:SettingsCard>
                <settings:SettingsCard Padding="{StaticResource SettingsExpanderBodyPadding}" layout:SettingsCardLayout.IsAdaptive="True" AutomationProperties.AutomationId="DiagnosticsNotificationsRow"><settings:SettingsCard.Header><TextBlock x:Name="NotificationsLabel" Style="{StaticResource DiagnosticLabelStyle}" /></settings:SettingsCard.Header><TextBlock x:Name="NotificationsValue" TextWrapping="Wrap" AutomationProperties.AutomationId="DiagnosticsNotificationStatus" /></settings:SettingsCard>
            </settings:SettingsExpander.Items>
        </settings:SettingsExpander>
        <TextBlock x:Name="SummaryStatus" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   AutomationProperties.AutomationId="DiagnosticsStatus" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Spacing="8">
            <Button x:Name="RefreshButton" HorizontalAlignment="Stretch" Click="Refresh_Click" AutomationProperties.AutomationId="DiagnosticsRefreshButton">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressRing x:Name="RefreshProgress" x:Uid="DiagnosticsRefreshProgress" Width="16" Height="16" IsActive="False"
                                  AutomationProperties.AutomationId="DiagnosticsRefreshProgress" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="RefreshButtonText" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="TestNotificationButton" HorizontalAlignment="Stretch" Click="TestNotification_Click" AutomationProperties.AutomationId="DiagnosticsTestNotificationButton" />
            <Button x:Name="ExportButton" HorizontalAlignment="Stretch" Click="Export_Click" AutomationProperties.AutomationId="DiagnosticsExportButton" />
        </StackPanel>
    </StackPanel>
</UserControl>
