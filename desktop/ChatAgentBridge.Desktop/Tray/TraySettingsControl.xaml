<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ChatAgentBridge_Desktop.Tray.TraySettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:layout="using:ChatAgentBridge_Desktop.Layout"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Spacing="{StaticResource SettingsCardSpacing}" AutomationProperties.AutomationId="TraySettingsCard">
        <TextBlock Style="{StaticResource SettingsSectionHeaderStyle}" x:Uid="TraySettingsHeading" AutomationProperties.AutomationId="TraySettingsHeading" />
        <settings:SettingsCard layout:SettingsCardLayout.IsAdaptive="True" AutomationProperties.AutomationId="TrayBehaviorSettingRow">
            <settings:SettingsCard.Header><TextBlock x:Uid="CloseBehaviorLabel" TextWrapping="Wrap" localization:LocalizedResourceKey.Key="CloseBehaviorLabel" /></settings:SettingsCard.Header>
            <settings:SettingsCard.HeaderIcon><SymbolIcon Symbol="DockBottom" /></settings:SettingsCard.HeaderIcon>
            <settings:SettingsCard.Description><TextBlock x:Uid="TraySettingsDescription" TextWrapping="Wrap" AutomationProperties.AutomationId="TraySettingsDescription" /></settings:SettingsCard.Description>
            <ComboBox x:Name="CloseBehaviorComboBox" x:Uid="CloseBehaviorComboBox" SelectionChanged="CloseBehaviorComboBox_SelectionChanged" AutomationProperties.AutomationId="CloseBehaviorComboBox" MinWidth="220">
                <ComboBoxItem x:Uid="CloseBehaviorAskEveryTime" AutomationProperties.AutomationId="CloseBehaviorAskEveryTime" />
                <ComboBoxItem x:Uid="CloseBehaviorMoveToTray" AutomationProperties.AutomationId="CloseBehaviorMoveToTray" />
                <ComboBoxItem x:Uid="CloseBehaviorExitApp" AutomationProperties.AutomationId="CloseBehaviorExitApp" />
            </ComboBox>
        </settings:SettingsCard>
        <Expander x:Uid="TrayActions" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="TrayActionsExpander" localization:LocalizedResourceKey.Key="TrayActions">
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="MoveToTrayButton" x:Uid="MoveToTrayButton" Click="MoveToTrayButton_Click" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="MoveToTrayButton" />
                    <Button Grid.Column="1" x:Name="ExitCompletelyButton" x:Uid="ExitCompletelyButton" Click="ExitCompletelyButton_Click" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ExitCompletelyButton">
                        <Button.Resources><ResourceDictionary Source="ms-appx:///ExitActionResources.xaml" /></Button.Resources>
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7E8;" AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </Grid>
                <TextBlock x:Uid="TrayExitDescription" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="TrayExitDescription" />
            </StackPanel>
        </Expander>
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="TraySettingsStatus" />
    </StackPanel>
</UserControl>
