<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ChatAgentBridge_Desktop.Tray.TraySettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border Padding="20"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            AutomationProperties.AutomationId="TraySettingsCard">
        <StackPanel Spacing="12">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                       x:Uid="TraySettingsHeading"
                       AutomationProperties.AutomationId="TraySettingsHeading" />
            <ToggleSwitch x:Name="CloseToTrayToggle"
                          x:Uid="CloseToTrayToggle"
                          Toggled="CloseToTrayToggle_Toggled"
                          AutomationProperties.AutomationId="CloseToTrayToggle">
                <ToggleSwitch.Header>
                    <TextBlock x:Uid="CloseToTrayLabel" TextWrapping="Wrap" />
                </ToggleSwitch.Header>
            </ToggleSwitch>
            <TextBlock x:Uid="TraySettingsDescription"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="TraySettingsDescription" />
            <StackPanel Spacing="8">
                <Button x:Name="MoveToTrayButton"
                        x:Uid="MoveToTrayButton"
                        Click="MoveToTrayButton_Click"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="MoveToTrayButton" />
                <TextBlock x:Uid="TrayExitDescription"
                           TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           AutomationProperties.AutomationId="TrayExitDescription" />
                <Button x:Name="ExitCompletelyButton"
                        x:Uid="ExitCompletelyButton"
                        Click="ExitCompletelyButton_Click"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="ExitCompletelyButton" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.AutomationId="TraySettingsStatus" />
        </StackPanel>
    </Border>
</UserControl>
