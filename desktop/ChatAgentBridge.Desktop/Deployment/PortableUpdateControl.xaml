<UserControl
    x:Class="ChatAgentBridge_Desktop.Deployment.PortableUpdateControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls">
    <StackPanel Spacing="8" AutomationProperties.AutomationId="PortableUpdateCard">
        <settings:SettingsExpander x:Uid="PortableUpdateSection" IsExpanded="True"
                                   AutomationProperties.AutomationId="PortableUpdateSection">
            <settings:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE895;" /></settings:SettingsExpander.HeaderIcon>
            <settings:SettingsExpander.Items>
                <settings:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch"
                                       AutomationProperties.AutomationId="PortableUpdateSectionContent">
                    <StackPanel Spacing="8">
                        <InfoBar x:Name="UpdateNotice" IsOpen="False" IsClosable="False"
                                 AutomationProperties.AutomationId="PortableUpdateNotice"
                                 AutomationProperties.LiveSetting="Polite">
                            <InfoBar.ActionButton>
                                <Button x:Name="UpdateNoticeAction" AutomationProperties.AutomationId="PortableUpdateNoticeAction"
                                        Style="{StaticResource AccentButtonStyle}" Click="UpdateNoticeAction_Click" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <settings:SettingsCard x:Uid="PortableUpdateHeading">
                            <settings:SettingsCard.Description>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Uid="PortableUpdateDescription" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="PortableUpdateStatus"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0"
                                                 Visibility="Collapsed" AutomationProperties.AutomationId="PortableUpdateProgress" />
                                </StackPanel>
                            </settings:SettingsCard.Description>
                            <Button x:Name="CheckUpdatesButton" x:Uid="PortableCheckUpdates" AutomationProperties.AutomationId="PortableCheckUpdates"
                                    Click="CheckUpdates_Click" />
                        </settings:SettingsCard>
                        <HyperlinkButton x:Name="ReleaseNotesLink" x:Uid="PortableUpdateReleaseNotes"
                                         AutomationProperties.AutomationId="PortableUpdateReleaseNotes" HorizontalAlignment="Left" />
                        <settings:SettingsExpander x:Uid="PortableUpdatePreferences" IsExpanded="False"
                                                   AutomationProperties.AutomationId="PortableUpdatePreferences">
                            <settings:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE713;" /></settings:SettingsExpander.HeaderIcon>
                            <settings:SettingsExpander.Items>
                                <settings:SettingsCard AutomationProperties.AutomationId="PortableUpdateAutomaticChecksRow">
                                    <settings:SettingsCard.Header>
                                        <CheckBox x:Name="AutomaticChecksCheckBox" x:Uid="PortableUpdateAutomaticChecks"
                                                  AutomationProperties.AutomationId="PortableUpdateAutomaticChecks"
                                                  Checked="AutomaticChecks_Changed" Unchecked="AutomaticChecks_Changed" />
                                    </settings:SettingsCard.Header>
                                    <settings:SettingsCard.Description>
                                        <TextBlock x:Uid="PortableUpdateAutomaticHelp" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </settings:SettingsCard.Description>
                                </settings:SettingsCard>
                                <settings:SettingsCard AutomationProperties.AutomationId="PortableUpdatePrereleasesRow">
                                    <settings:SettingsCard.Header>
                                        <CheckBox x:Name="IncludePrereleasesCheckBox" x:Uid="PortableUpdateIncludePrereleases"
                                                  AutomationProperties.AutomationId="PortableUpdateIncludePrereleases"
                                                  Checked="IncludePrereleases_Changed" Unchecked="IncludePrereleases_Changed" />
                                    </settings:SettingsCard.Header>
                                    <settings:SettingsCard.Description>
                                        <TextBlock x:Uid="PortableUpdatePrereleasesHelp" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </settings:SettingsCard.Description>
                                </settings:SettingsCard>
                            </settings:SettingsExpander.Items>
                        </settings:SettingsExpander>
                        <TextBlock x:Name="PreferenceError" Visibility="Collapsed" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   AutomationProperties.AutomationId="PortableUpdatePreferenceError" AutomationProperties.LiveSetting="Polite" />
                        <StackPanel x:Name="UpdateActions" Spacing="8">
                            <Button x:Name="DownloadUpdateButton" x:Uid="PortableDownloadUpdate" AutomationProperties.AutomationId="PortableDownloadUpdate"
                                    Click="DownloadUpdate_Click" HorizontalAlignment="Stretch" />
                            <Button x:Name="ApplyUpdateButton" x:Uid="PortableApplyUpdate" AutomationProperties.AutomationId="PortableApplyUpdate"
                                    Click="ApplyUpdate_Click" HorizontalAlignment="Stretch" />
                            <Button x:Name="CancelUpdateButton" x:Uid="PortableCancelUpdate" AutomationProperties.AutomationId="PortableCancelUpdate"
                                    Click="CancelUpdate_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </settings:SettingsCard>
            </settings:SettingsExpander.Items>
        </settings:SettingsExpander>
    </StackPanel>
</UserControl>
