<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonBackground" Color="#FFF1D5D9" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFEBC3C9" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE8BEC5" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFB95265" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF9F354B" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF9F354B" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FF8A2031" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF8A2031" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF8A2031" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonBackground" Color="#FF57464A" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF604B50" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF654F54" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFBB7584" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFD28A99" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFD28A99" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFB9C5" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFB9C5" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFB9C5" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
