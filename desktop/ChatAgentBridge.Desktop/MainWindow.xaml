<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChatAgentBridge_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChatAgentBridge_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Chat Agent Bridge"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Keep the global shortcut active without generating a tooltip over the entire window. -->
    <Grid x:Name="WindowRoot" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="SettingsSearchFlyout" Placement="Bottom"
                    Opening="SettingsSearchFlyout_Opening" Opened="SettingsSearchFlyout_Opened" Closed="SettingsSearchFlyout_Closed">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MaxWidth" Value="560" />
                        <Setter Property="Padding" Value="16" />
                        <Setter Property="AutomationProperties.AutomationId" Value="SettingsSearchPanel" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <Grid x:Name="SettingsSearchPanel" MaxWidth="480">
                    <AutoSuggestBox x:Name="SettingsSearchBox" x:Uid="SettingsSearchBox" QueryIcon="Find"
                                    HorizontalAlignment="Stretch" UpdateTextOnSelect="False"
                                    TextChanged="SettingsSearchBox_TextChanged" SuggestionChosen="SettingsSearchBox_SuggestionChosen"
                                    QuerySubmitted="SettingsSearchBox_QuerySubmitted"
                                    AutomationProperties.AutomationId="SettingsSearchBox">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="local:SettingsSearchEntry">
                                <StackPanel Padding="0,6" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Location}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </Grid>
            </Flyout>
        </FlyoutBase.AttachedFlyout>

        <TitleBar x:Name="AppTitleBar" Title="Chat Agent Bridge">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/StoreLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
        <Border x:Name="StartupMigrationShell" Grid.Row="1" Visibility="Collapsed" Padding="32"
                Background="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.AutomationId="StartupMigrationShell">
            <StackPanel MaxWidth="560" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StartupMigrationTitle" Visibility="Collapsed" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <StackPanel x:Name="StartupMigrationLoading" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <ProgressRing x:Name="StartupMigrationRing" IsActive="True" Width="32" Height="32" />
                    <TextBlock x:Name="StartupMigrationProgress" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.AutomationId="StartupMigrationProgress" />
                </StackPanel>
                <InfoBar x:Name="StartupMigrationError" Severity="Error" IsOpen="False" IsClosable="False"
                         AutomationProperties.AutomationId="StartupMigrationError" />
                <StackPanel x:Name="StartupMigrationActions" Visibility="Collapsed" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="StartupMigrationExit" Click="StartupMigrationExit_Click" AutomationProperties.AutomationId="StartupMigrationExit" />
                    <Button x:Name="StartupMigrationRetry" Click="StartupMigrationRetry_Click" Visibility="Collapsed"
                            Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="StartupMigrationRetry" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="SettingsSearchAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>
