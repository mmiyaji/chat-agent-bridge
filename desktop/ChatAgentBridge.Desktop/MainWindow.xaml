<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ChatAgentBridge_Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChatAgentBridge_Desktop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Chat Agent Bridge"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="WindowRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="SettingsSearchFlyout" Placement="Bottom"
                    Opening="SettingsSearchFlyout_Opening" Opened="SettingsSearchFlyout_Opened" Closed="SettingsSearchFlyout_Closed">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="MaxWidth" Value="560" />
                        <Setter Property="Padding" Value="16" />
                        <Setter Property="AutomationProperties.AutomationId" Value="SettingsSearchPanel" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <Grid x:Name="SettingsSearchPanel" MaxWidth="480">
                    <AutoSuggestBox x:Name="SettingsSearchBox" x:Uid="SettingsSearchBox" QueryIcon="Find"
                                    HorizontalAlignment="Stretch" UpdateTextOnSelect="False"
                                    TextChanged="SettingsSearchBox_TextChanged" SuggestionChosen="SettingsSearchBox_SuggestionChosen"
                                    QuerySubmitted="SettingsSearchBox_QuerySubmitted"
                                    AutomationProperties.AutomationId="SettingsSearchBox">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="local:SettingsSearchEntry">
                                <StackPanel Padding="0,6" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Location}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </Grid>
            </Flyout>
        </FlyoutBase.AttachedFlyout>

        <TitleBar x:Name="AppTitleBar" Title="Chat Agent Bridge">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/StoreLogo.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="SettingsSearchAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>
