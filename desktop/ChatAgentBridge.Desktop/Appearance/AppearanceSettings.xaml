<UserControl
    x:Class="ChatAgentBridge_Desktop.Appearance.AppearanceSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:layout="using:ChatAgentBridge_Desktop.Layout">
    <settings:SettingsCard layout:SettingsCardLayout.IsAdaptive="True" AutomationProperties.AutomationId="ThemeSettingRow">
        <settings:SettingsCard.Header><TextBlock x:Uid="AppThemeCardHeading" AutomationProperties.AutomationId="AppThemeCardHeading" /></settings:SettingsCard.Header>
        <settings:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></settings:SettingsCard.HeaderIcon>
        <settings:SettingsCard.Description>
            <TextBlock x:Name="ThemeStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="AppThemeStatus" />
        </settings:SettingsCard.Description>
        <!-- One row sized by each label: long localized labels cannot overlap and the card stays one line high. -->
        <StackPanel x:Name="ThemeChoices" x:Uid="AppTheme" Orientation="Horizontal" Spacing="20">
            <RadioButton x:Uid="ThemeSystem" Tag="system" GroupName="AppTheme" MinWidth="0" Checked="ThemeChoice_Checked" AutomationProperties.AutomationId="ThemeSystem" />
            <RadioButton x:Uid="ThemeLight" Tag="light" GroupName="AppTheme" MinWidth="0" Checked="ThemeChoice_Checked" AutomationProperties.AutomationId="ThemeLight" />
            <RadioButton x:Uid="ThemeDark" Tag="dark" GroupName="AppTheme" MinWidth="0" Checked="ThemeChoice_Checked" AutomationProperties.AutomationId="ThemeDark" />
        </StackPanel>
    </settings:SettingsCard>
</UserControl>
