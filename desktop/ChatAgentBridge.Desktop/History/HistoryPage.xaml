<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChatAgentBridge_Desktop.History.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:ChatAgentBridge_Desktop.History"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="20,12,20,18" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="HistoryTitle" Style="{StaticResource TitleTextBlockStyle}" x:Uid="historyHistoryPageTextBlock001" />
                <TextBlock x:Name="HistoryDescription" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" x:Uid="historyHistoryPageTextBlock002" />
            </StackPanel>
            <StackPanel x:Name="HistoryHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="HistoryAgentSettingsButton" Click="AgentSettingsRequested_Click" AutomationProperties.AutomationId="AgentSettingsFromHistory" x:Uid="AgentSettingsFromHistory" />
                <Button Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.AutomationId="RefreshHistory" x:Uid="RefreshHistory" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="HistoryStatusText" Grid.Row="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}"
                   AutomationProperties.AutomationId="HistoryStatus" />

        <Pivot Grid.Row="2" x:Name="HistoryPivot" SelectionChanged="HistoryPivot_SelectionChanged" AutomationProperties.AutomationId="HistorySectionSelector">
            <Pivot.HeaderTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </DataTemplate>
            </Pivot.HeaderTemplate>
            <PivotItem x:Name="ConversationsTab" Header="{x:Bind ViewModel.ConversationsTabTitle, Mode=OneWay}" AutomationProperties.AutomationId="SavedConversationsTab">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SessionFilters" ColumnSpacing="8" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="ProviderFilterColumn" Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SessionSearchBox" VerticalAlignment="Top" Header="{x:Bind ViewModel.SearchLabel, Mode=OneWay}"
                                 PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SavedSessionsSearch" />
                        <ComboBox x:Name="ProviderFilter" Grid.Column="1" Header="{x:Bind ViewModel.ProviderLabel, Mode=OneWay}"
                                  ItemsSource="{x:Bind ViewModel.ProviderFilters, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.ProviderFilter, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                  AutomationProperties.AutomationId="SavedSessionsProviderFilter" />
                        <Grid x:Name="AdvancedFiltersGrid" Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="AdvancedSortColumn" Width="180" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="WorkspaceFilter" Header="{x:Bind ViewModel.WorkspaceFilterLabel, Mode=OneWay}"
                                  ItemsSource="{x:Bind ViewModel.WorkspaceFilters, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.WorkspaceFilter, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" ToolTipService.ToolTip="{x:Bind ViewModel.WorkspaceFilter, Mode=OneWay}"
                                  AutomationProperties.AutomationId="SavedSessionsWorkspaceFilter" />
                        <ComboBox x:Name="SessionSort" Grid.Column="1" Header="{x:Bind ViewModel.SortLabel, Mode=OneWay}"
                                  ItemsSource="{x:Bind ViewModel.SessionSortOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SessionSort, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" AutomationProperties.AutomationId="SavedSessionsSort" />
                        </Grid>
                        <Expander x:Name="CompactFiltersExpander" Grid.Column="1" IsExpanded="False"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Bottom"
                                  Visibility="Collapsed" x:Uid="HistoryCompactFilters" AutomationProperties.AutomationId="SavedSessionsAdvancedFilters" />
                    </Grid>

                    <Grid x:Name="SessionBrowser" Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SessionListColumn" Width="380" />
                            <ColumnDefinition x:Name="SessionDetailColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="SessionListPane" RowSpacing="5" AutomationProperties.AutomationId="SavedSessionListPane">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.SessionResultSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="SavedSessionsCount" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearSessionFiltersCommand}"
                                        Content="{x:Bind ViewModel.ClearSessionFiltersLabel, Mode=OneWay}"
                                        Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasSessionFilters), Mode=OneWay}"
                                        AutomationProperties.AutomationId="ClearSessionFilters" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <ListView x:Name="SessionList" ItemsSource="{x:Bind ViewModel.FilteredSessions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=OneWay}" SelectionChanged="SavedSessionsList_SelectionChanged"
                                          SelectionMode="Single" IsItemClickEnabled="True" ItemClick="SavedSessionsList_ItemClick" KeyDown="SavedSessionsList_KeyDown"
                                          AutomationProperties.AutomationId="SavedSessionsList"
                                          AutomationProperties.Name="{x:Bind ViewModel.ConversationsTabTitle, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionHistoryRow">
                                            <Grid Margin="8,8" RowSpacing="4" ToolTipService.ToolTip="{x:Bind ConversationLabel}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind ListTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ListTitle}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind UpdatedCompact}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind UpdatedTooltip}" />
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{x:Bind ListIdentity}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ListIdentity}" />
                                                <TextBlock Grid.Row="2" Text="{x:Bind ListLocation}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ListLocation}" />
                                                <TextBlock Grid.Row="3" Text="{x:Bind ListContext}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Workspace}" />
                                                <Grid Grid.Row="4" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{x:Bind StatusGlyph}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ActivitySummary}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ActivitySummary}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Margin="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Visibility="{x:Bind vm:HistoryPage.EmptyToVisibility(ViewModel.HasFilteredSessions), Mode=OneWay}"
                                           Text="{x:Bind ViewModel.SessionListEmptyText, Mode=OneWay}" AutomationProperties.AutomationId="EmptySavedSessions" />
                            </Grid>
                        </Grid>

                        <Grid x:Name="SessionDetailPane" Grid.Column="1" RowSpacing="8" AutomationProperties.AutomationId="SavedSessionDetails">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="BackToSessionsButton" Click="BackToSessions_Click" AutomationProperties.AutomationId="BackToSessionsButton"
                                        Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.IsNarrow), Mode=OneWay}"
                                        Content="{x:Bind ViewModel.BackToConversationsLabel, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedSessionTitle, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.SelectedSessionTitle, Mode=OneWay}" />
                                <Button Grid.Column="2" Command="{x:Bind ViewModel.RenameSelectedSessionCommand}"
                                        Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasSelectedSession), Mode=OneWay}"
                                        AutomationProperties.AutomationId="RenameSession" AutomationProperties.Name="{x:Bind ViewModel.RenameSessionLabel, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.RenameSessionLabel, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE70F;" />
                                </Button>
                            </Grid>
                            <ScrollViewer x:Name="SessionDetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid x:Name="SessionDetailContent" Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasSelectedSession), Mode=OneWay}" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.ConversationHeading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ListIdentity, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ListLocation, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ActivitySummary, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Updated, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.ContinueInOriginalThreadHint, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.RuntimeHeading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.WorkspacePathLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Workspace, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind ViewModel.AgentLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Agent, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Model, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ReasoningEffort, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.PolicyHeading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ExecutionPolicy, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                        <Expander Grid.Row="3" Header="{x:Bind ViewModel.IdentifiersHeading, Mode=OneWay}" IsExpanded="False" AutomationProperties.AutomationId="SessionIdentifiers">
                                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind ViewModel.UserIdLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.UserId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ViewModel.ChannelIdLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.ChannelId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ViewModel.ThreadIdLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.ThreadId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ViewModel.OriginLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.Origin, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ViewModel.SessionIdLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock x:Name="SelectedSessionIdText" Text="{x:Bind ViewModel.SelectedSession.SessionId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="SelectedSessionId" />
                                            </StackPanel>
                                        </Expander>
                                    </Grid>
                                    <TextBlock x:Name="NoSessionSelectedText" Text="{x:Bind ViewModel.NoSessionSelectedText, Mode=OneWay}"
                                               TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"
                                               Visibility="{x:Bind vm:HistoryPage.EmptyToVisibility(ViewModel.HasSelectedSession), Mode=OneWay}" />
                                </Grid>
                            </ScrollViewer>
                            <Grid Grid.Row="2" ColumnSpacing="8" RowSpacing="8" Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasSelectedSession), Mode=OneWay}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Button Command="{x:Bind ViewModel.EditSelectedSessionModelCommand}" HorizontalAlignment="Stretch" Content="{x:Bind ViewModel.EditModelLabel, Mode=OneWay}" AutomationProperties.AutomationId="EditSessionModel" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.EditSelectedSessionPolicyCommand}" HorizontalAlignment="Stretch" Content="{x:Bind ViewModel.EditPolicyLabel, Mode=OneWay}" AutomationProperties.AutomationId="EditSessionExecutionPolicy" />
                                <Button Grid.Row="1" Grid.ColumnSpan="2" Command="{x:Bind ViewModel.DetachSelectedSessionCommand}" HorizontalAlignment="Stretch" Content="{x:Bind ViewModel.StartFreshLabel, Mode=OneWay}" AutomationProperties.AutomationId="DetachSession" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem Header="{x:Bind ViewModel.ActivityTabTitle, Mode=OneWay}" AutomationProperties.AutomationId="ActivityTab">
                <ContentControl x:Name="ActivityHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </PivotItem>

            <PivotItem x:Name="ExecutionsTab" Header="{x:Bind ViewModel.ExecutionsTabTitle, Mode=OneWay}" AutomationProperties.AutomationId="ExecutionHistoryTab">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.ExecutionSummary, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button Grid.Row="1" Command="{x:Bind ViewModel.ClearExecutionDayFilterCommand}" Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasExecutionDayFilter), Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ClearExecutionDayFilter" x:Uid="ClearExecutionDayFilter" />
                    <Grid Grid.Row="2">
                        <ListView ItemsSource="{x:Bind ViewModel.Executions, Mode=OneWay}" AutomationProperties.AutomationId="ExecutionHistoryList"
                                  AutomationProperties.Name="{x:Bind ViewModel.ExecutionsTabTitle, Mode=OneWay}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExecutionHistoryRow">
                                    <StackPanel Margin="8,6" Spacing="3">
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Conversation}" TextWrapping="Wrap" />
                                        <Expander Header="{x:Bind Model}" IsExpanded="False">
                                            <StackPanel Spacing="3" Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind Workspace}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ReasoningEffort}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind Usage}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind Session}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind Identifiers}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="{x:Bind ViewModel.NoExecutionsText, Mode=OneWay}" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"
                                   Visibility="{x:Bind vm:HistoryPage.EmptyToVisibility(ViewModel.HasExecutions), Mode=OneWay}" AutomationProperties.AutomationId="EmptyExecutionHistory" />
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem Header="{x:Bind ViewModel.AuditTabTitle, Mode=OneWay}" AutomationProperties.AutomationId="AuditHistoryTab">
                <Grid>
                    <ListView ItemsSource="{x:Bind ViewModel.AuditEvents, Mode=OneWay}" AutomationProperties.AutomationId="AuditHistoryList"
                              AutomationProperties.Name="{x:Bind ViewModel.AuditTabTitle, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AuditHistoryRow">
                                <StackPanel Margin="8,6" Spacing="3">
                                    <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind Conversation}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    <Expander Header="{x:Bind IdentifiersHeading}" IsExpanded="False" AutomationProperties.AutomationId="AuditIdentifiers">
                                        <TextBlock Text="{x:Bind Identifiers}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </Expander>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind ViewModel.NoAuditText, Mode=OneWay}" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"
                               Visibility="{x:Bind vm:HistoryPage.EmptyToVisibility(ViewModel.HasAuditEvents), Mode=OneWay}" AutomationProperties.AutomationId="EmptyAuditHistory" />
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
