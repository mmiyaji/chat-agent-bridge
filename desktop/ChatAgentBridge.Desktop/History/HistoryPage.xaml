<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChatAgentBridge_Desktop.History.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:ChatAgentBridge_Desktop.History"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24,18,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock Text="履歴と会話" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="日時・状態・作業フォルダーを保存します。本文や実行結果は保存しません。"
                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            <StackPanel Spacing="6">
                <Button Content="エージェント設定を開く" HorizontalAlignment="Left" Click="AgentSettingsRequested_Click"
                        AutomationProperties.AutomationId="AgentSettingsFromHistory" />
                <Button Content="更新" HorizontalAlignment="Left" Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.AutomationId="RefreshHistory" />
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="HistoryStatus" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled" IsVerticalScrollChainingEnabled="True"
                      AutomationProperties.AutomationId="HistoryScroll">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock Text="実行履歴" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="実行した日時、状態、作業フォルダー、会話とセッション ID を表示します。"
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock Text="トークン数はプロバイダーの報告値で、料金そのものではありません。未報告の項目は「未取得」と表示します。観測範囲は今回のターン・直近の依頼・スレッド累計で異なる場合があります。"
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.Executions, Mode=OneWay}" MaxHeight="220"
                                  AutomationProperties.Name="実行履歴" AutomationProperties.AutomationId="ExecutionHistoryList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExecutionHistoryRow">
                                    <StackPanel Margin="8,6" Spacing="4">
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Workspace}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Conversation}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Model}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Usage}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Session}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="実行履歴はまだありません。チャットの依頼を承認して実行すると、メタデータがここに表示されます。"
                                   TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"
                                   Visibility="{x:Bind vm:HistoryPage.EmptyToVisibility(ViewModel.HasExecutions), Mode=OneWay}"
                                   AutomationProperties.AutomationId="EmptyExecutionHistory" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="保存済みセッション" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="セッションは会話の継続先です。切り離すと次回は新しい会話になり、過去の実行履歴は残ります。モデル欄が空なら既定モデルを使います。"
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <StackPanel Spacing="6">
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.EditSelectedSessionModelCommand}"
                                AutomationProperties.AutomationId="EditSessionModel">
                            <Button.Content><TextBlock Text="次回の実行モデルを設定" TextWrapping="Wrap" /></Button.Content>
                        </Button>
                        <Button HorizontalAlignment="Stretch" ToolTipService.ToolTip="選択したセッションを切り離す"
                                Command="{x:Bind ViewModel.DetachSelectedSessionCommand}"
                                AutomationProperties.AutomationId="DetachSession">
                            <Button.Content><TextBlock Text="セッションを切り離す" TextWrapping="Wrap" /></Button.Content>
                        </Button>
                    </StackPanel>
                    <Grid>
                        <ListView MaxHeight="250" ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                                  AutomationProperties.Name="保存済みセッション" AutomationProperties.AutomationId="SavedSessionsList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionHistoryRow">
                                    <StackPanel Margin="8,6" Spacing="4">
                                        <TextBlock Text="{x:Bind Provider}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Conversation}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Workspace}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind AgentAndSession}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Model}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Updated}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="保存済みセッションはありません。実行履歴があっても、セッションが保存されない実行があります。"
                                   TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"
                                   Visibility="{x:Bind vm:HistoryPage.EmptyToVisibility(ViewModel.HasSessions), Mode=OneWay}"
                                   AutomationProperties.AutomationId="EmptySavedSessions" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="監査イベント" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="依頼の受信、承認、拒否、実行、切り離しなどの操作記録です。メッセージ本文は含みません。"
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Grid>
                        <ListView MaxHeight="220" ItemsSource="{x:Bind ViewModel.AuditEvents, Mode=OneWay}"
                                  AutomationProperties.Name="監査イベント" AutomationProperties.AutomationId="AuditHistoryList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AuditHistoryRow">
                                    <StackPanel Margin="8,6" Spacing="4">
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Conversation}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock Text="監査イベントはまだありません。チャット操作を行うと、この一覧にメタデータが追加されます。"
                                   TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"
                                   Visibility="{x:Bind vm:HistoryPage.EmptyToVisibility(ViewModel.HasAuditEvents), Mode=OneWay}"
                                   AutomationProperties.AutomationId="EmptyAuditHistory" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
