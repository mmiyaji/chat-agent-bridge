<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChatAgentBridge_Desktop.History.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:ChatAgentBridge_Desktop.History"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:presentation="using:ChatAgentBridge_Desktop.Presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Top">
                <TextBlock x:Name="HistoryTitle" Style="{StaticResource TitleTextBlockStyle}" x:Uid="historyHistoryPageTextBlock001" localization:LocalizedResourceKey.Key="historyHistoryPageTextBlock001" />
                <TextBlock x:Name="HistoryDescription" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" x:Uid="historyHistoryPageTextBlock002" localization:LocalizedResourceKey.Key="historyHistoryPageTextBlock002" />
            </StackPanel>
            <StackPanel x:Name="HistoryHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="HistoryAgentSettingsButton" Click="AgentSettingsRequested_Click" AutomationProperties.AutomationId="AgentSettingsFromHistory" x:Uid="AgentSettingsFromHistory" />
                <Button x:Name="ExportAuditButton" Click="ExportAudit_Click" AutomationProperties.AutomationId="ExportAuditHistory" x:Uid="ExportAuditHistory" />
                <Button Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.AutomationId="RefreshHistory" x:Uid="RefreshHistory" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="HistoryStatusText" Grid.Row="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}"
                   AutomationProperties.AutomationId="HistoryStatus" />

        <Pivot Grid.Row="2" x:Name="HistoryPivot" SelectionChanged="HistoryPivot_SelectionChanged" AutomationProperties.AutomationId="HistorySectionSelector">
            <Pivot.HeaderTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </DataTemplate>
            </Pivot.HeaderTemplate>
            <PivotItem x:Name="ConversationsTab" Header="{x:Bind ViewModel.ConversationsTabTitle, Mode=OneWay}" AutomationProperties.AutomationId="SavedConversationsTab">
                <Grid Margin="0,14,0,0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SessionFilters" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SessionSearchBox" VerticalAlignment="Top" Header="{x:Bind ViewModel.SearchLabel, Mode=OneWay}"
                                 PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SavedSessionsSearch" />
                        <Button x:Name="SessionFiltersButton" Grid.Column="1"
                                Content="{x:Bind ViewModel.FiltersLabel, Mode=OneWay}"
                                VerticalAlignment="Bottom" AutomationProperties.AutomationId="SavedSessionsAdvancedFilters">
                            <Button.Flyout>
                                <Flyout x:Name="SessionFiltersFlyout">
                                    <StackPanel Spacing="8" MinWidth="280">
                                        <ComboBox x:Name="ProviderFilter" Header="{x:Bind ViewModel.ProviderLabel, Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.ProviderFilters, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.ProviderFilter, Mode=TwoWay}" HorizontalAlignment="Stretch"
                                                  AutomationProperties.AutomationId="SavedSessionsProviderFilter" />
                                        <ComboBox x:Name="WorkspaceFilter" Header="{x:Bind ViewModel.WorkspaceFilterLabel, Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.WorkspaceFilters, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.WorkspaceFilter, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" ToolTipService.ToolTip="{x:Bind ViewModel.WorkspaceFilter, Mode=OneWay}"
                                                  AutomationProperties.AutomationId="SavedSessionsWorkspaceFilter" />
                                        <ComboBox x:Name="SessionSort" Header="{x:Bind ViewModel.SortLabel, Mode=OneWay}"
                                                  ItemsSource="{x:Bind ViewModel.SessionSortOptions, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.SessionSort, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" AutomationProperties.AutomationId="SavedSessionsSort" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <Grid x:Name="SessionBrowser" Grid.Row="1" ColumnSpacing="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SessionListColumn" Width="380" MinWidth="280" />
                            <ColumnDefinition x:Name="SessionSplitterColumn" Width="12" />
                            <ColumnDefinition x:Name="SessionDetailColumn" Width="*" MinWidth="320" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="SessionListPane" RowSpacing="5" AutomationProperties.AutomationId="SavedSessionListPane">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Style="{StaticResource ActivityCardStyle}" Padding="0" IsHitTestVisible="False" />
                            <Grid Margin="12,12,12,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.SessionResultSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="SavedSessionsCount" />
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearSessionFiltersCommand}"
                                        Content="{x:Bind ViewModel.ClearSessionFiltersLabel, Mode=OneWay}"
                                        Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.ShowSessionFilterHeaderClearButton), Mode=OneWay}"
                                        AutomationProperties.AutomationId="ClearSessionFilters" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="4,0,4,4">
                                <ListView x:Name="SessionList" ItemsSource="{x:Bind ViewModel.FilteredSessions, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=OneWay}" SelectionChanged="SavedSessionsList_SelectionChanged"
                                          SelectionMode="Single" IsItemClickEnabled="True" ItemClick="SavedSessionsList_ItemClick" KeyDown="SavedSessionsList_KeyDown"
                                          AutomationProperties.AutomationId="SavedSessionsList"
                                          AutomationProperties.Name="{x:Bind ViewModel.ConversationsTabTitle, Mode=OneWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SessionHistoryRow">
                                            <Grid Margin="8" RowSpacing="4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind ListTitle}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ListTitle}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind UpdatedCompact}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind UpdatedTooltip}" />
                                                </Grid>
                                                <Grid Grid.Row="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xE77B;" FontSize="14" VerticalAlignment="Center"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"
                                                              AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ListConversation}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ListConversation}" />
                                                </Grid>
                                                <TextBlock Grid.Row="2" Text="{x:Bind ListContext}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ListContext}" />
                                                <Grid Grid.Row="3" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <presentation:StatusIcon Tone="{x:Bind StatusTone}" Width="24" Height="24"
                                                                             VerticalAlignment="Center" IsHitTestVisible="False"
                                                                             AutomationProperties.AccessibilityView="Raw" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind ListActivity}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ListActivity}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <ScrollViewer x:Name="SavedSessionsEmptyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                              Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.ShowEmptySessionList), Mode=OneWay}">
                                    <Border Padding="16" Margin="12" MaxWidth="460"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="SavedSessionsEmptyCard">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                                        <Viewbox Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                 AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                                            <SymbolIcon Symbol="People" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Viewbox>
                                        <TextBlock Text="{x:Bind ViewModel.SessionListEmptyHeading, Mode=OneWay}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                                   AutomationProperties.AutomationId="EmptySavedSessions" />
                                        <TextBlock Text="{x:Bind ViewModel.SessionListEmptyDescription, Mode=OneWay}"
                                                   Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                                   AutomationProperties.AutomationId="SavedSessionsEmptyBody" />
                                        <Button Command="{x:Bind ViewModel.ClearSessionFiltersCommand}"
                                                Content="{x:Bind ViewModel.ClearSessionFiltersLabel, Mode=OneWay}"
                                                Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.ShowSessionFilterEmptyAction), Mode=OneWay}"
                                                AutomationProperties.AutomationId="ClearSessionFiltersEmpty" />
                                    </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <controls:GridSplitter x:Name="SessionSplitter" Grid.Column="1" Width="12"
                                               ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                               AutomationProperties.AutomationId="SavedSessionsSplitter"
                                               x:Uid="SavedSessionsSplitter" />

                        <Grid x:Name="SessionDetailPane" Grid.Column="2" RowSpacing="8" AutomationProperties.AutomationId="SavedSessionDetails">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" Style="{StaticResource ActivityCardStyle}" Padding="0" IsHitTestVisible="False" />
                            <Grid Margin="8,8,8,0" ColumnSpacing="8"
                                  Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasSelectedSession), Mode=OneWay}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Button x:Name="BackToSessionsButton" Click="BackToSessions_Click" AutomationProperties.AutomationId="BackToSessionsButton"
                                        Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.IsNarrow), Mode=OneWay}"
                                        Content="{x:Bind ViewModel.BackToConversationsLabel, Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedSessionTitle, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.SelectedSessionTitle, Mode=OneWay}" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="8,0">
                                <ScrollViewer x:Name="SessionDetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid>
                                    <Grid x:Name="SessionDetailContent" Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasSelectedSession), Mode=OneWay}" RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.ConversationHeading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ListIdentity, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ListLocation, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ActivitySummary, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Updated, Mode=OneWay, FallbackValue=''}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.ContinueInOriginalThreadHint, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.RuntimeHeading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.WorkspacePathLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Workspace, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind ViewModel.AgentLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Agent, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.Model, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ReasoningEffort, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.PolicyHeading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedSession.ExecutionPolicy, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                        <Expander Grid.Row="3" IsExpanded="False" AutomationProperties.AutomationId="SessionIdentifiers">
                                            <Expander.Header>
                                                <TextBlock Text="{x:Bind ViewModel.IdentifiersSummary, Mode=OneWay}"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                            </Expander.Header>
                                            <StackPanel Spacing="4" Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind ViewModel.UserIdLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.UserId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ViewModel.ChannelIdLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.ChannelId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ViewModel.ThreadIdLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.ThreadId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ViewModel.OriginLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedSession.Origin, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock Text="{x:Bind ViewModel.SessionIdLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                                <TextBlock x:Name="SelectedSessionIdText" Text="{x:Bind ViewModel.SelectedSession.SessionId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="SelectedSessionId" />
                                            </StackPanel>
                                        </Expander>
                                    </Grid>
                                    </Grid>
                                </ScrollViewer>
                                <ScrollViewer x:Name="SavedSessionDetailEmptyScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                              Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.ShowEmptySessionDetail), Mode=OneWay}">
                                    <Border Padding="20" Margin="12" MaxWidth="460"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="SavedSessionDetailEmptyCard">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                                        <Viewbox Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                                 AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                                            <SymbolIcon Symbol="People" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Viewbox>
                                        <TextBlock Text="{x:Bind ViewModel.SessionDetailEmptyHeading, Mode=OneWay}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                                   AutomationProperties.AutomationId="SavedSessionDetailEmpty" />
                                        <TextBlock Text="{x:Bind ViewModel.SessionDetailEmptyDescription, Mode=OneWay}"
                                                   Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                                                   AutomationProperties.AutomationId="SavedSessionDetailEmptyBody" />
                                    </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </Grid>
                            <CommandBar Grid.Row="2" Margin="4,0,4,4" Background="Transparent" DefaultLabelPosition="Right"
                                        IsDynamicOverflowEnabled="True" OverflowButtonVisibility="Auto"
                                        Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasSelectedSession), Mode=OneWay}"
                                        AutomationProperties.AutomationId="SessionActionsCommandBar">
                                <CommandBar.PrimaryCommands>
                                    <AppBarButton Command="{x:Bind ViewModel.EditSelectedSessionModelCommand}"
                                                  Label="{x:Bind ViewModel.EditModelLabel, Mode=OneWay}"
                                                  AutomationProperties.AutomationId="EditSessionModel">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Edit" /></AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Command="{x:Bind ViewModel.SwitchSelectedAgentCommand}"
                                                  Label="{x:Bind ViewModel.SwitchAgentLabel, Mode=OneWay}"
                                                  AutomationProperties.AutomationId="SwitchSessionAgent">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Switch" /></AppBarButton.Icon>
                                    </AppBarButton>
                                </CommandBar.PrimaryCommands>
                                <CommandBar.SecondaryCommands>
                                    <AppBarButton Command="{x:Bind ViewModel.EditSelectedSessionPolicyCommand}"
                                                  Label="{x:Bind ViewModel.EditPolicyLabel, Mode=OneWay}"
                                                  AutomationProperties.AutomationId="EditSessionExecutionPolicy">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Setting" /></AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Command="{x:Bind ViewModel.RenameSelectedSessionCommand}"
                                                  Label="{x:Bind ViewModel.RenameSessionLabel, Mode=OneWay}"
                                                  AutomationProperties.AutomationId="RenameSession">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Rename" /></AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Command="{x:Bind ViewModel.DetachSelectedSessionCommand}"
                                                  Label="{x:Bind ViewModel.StartFreshLabel, Mode=OneWay}"
                                                  AutomationProperties.AutomationId="DetachSession">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Remove" /></AppBarButton.Icon>
                                    </AppBarButton>
                                </CommandBar.SecondaryCommands>
                            </CommandBar>
                        </Grid>
                    </Grid>
                </Grid>
            </PivotItem>

            <PivotItem Header="{x:Bind ViewModel.ActivityTabTitle, Mode=OneWay}" AutomationProperties.AutomationId="ActivityTab">
                <ContentControl x:Name="ActivityHost" Margin="0,14,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </PivotItem>

            <PivotItem x:Name="ExecutionsTab" Header="{x:Bind ViewModel.ExecutionsTabTitle, Mode=OneWay}" AutomationProperties.AutomationId="ExecutionHistoryTab">
                <Grid Margin="0,14,0,0" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <SelectorBar x:Name="ExecutionHistoryMode" SelectionChanged="ExecutionHistoryMode_SelectionChanged">
                        <SelectorBarItem x:Name="ExecutionsModeItem" x:Uid="HistoryRunsMode" IsSelected="True" AutomationProperties.AutomationId="ExecutionHistoryModeItem" />
                        <SelectorBarItem x:Name="AllOperationsModeItem" x:Uid="HistoryAllOperationsMode" AutomationProperties.AutomationId="AuditHistoryTab" />
                    </SelectorBar>
                    <Grid x:Name="ExecutionHistoryPanel" Grid.Row="1" RowSpacing="6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.ExecutionSummary, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                        <Button Grid.Row="1" Command="{x:Bind ViewModel.ClearExecutionDayFilterCommand}" Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.ShowExecutionFilterClearButton), Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ClearExecutionDayFilter" x:Uid="ClearExecutionDayFilter" />
                        <Grid Grid.Row="2">
                            <Grid SizeChanged="ExecutionBrowser_SizeChanged" ColumnSpacing="12" RowSpacing="8"
                                  Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasExecutions), Mode=OneWay}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ExecutionDetailColumn" Width="280" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="2*" /><RowDefinition x:Name="ExecutionDetailRow" Height="0" /></Grid.RowDefinitions>
                                <ListView x:Name="ExecutionHistoryList" ItemsSource="{x:Bind ViewModel.Executions, Mode=OneWay}" SelectionChanged="ExecutionHistoryList_SelectionChanged"
                                          AutomationProperties.AutomationId="ExecutionHistoryList" AutomationProperties.Name="{x:Bind ViewModel.ExecutionsTabTitle, Mode=OneWay}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ExecutionHistoryRow">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Summary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Conversation}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Conversation}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Border x:Name="ExecutionDetailPane" Grid.Column="1" BorderThickness="1" CornerRadius="6" Padding="12"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="8">
                                            <TextBlock x:Uid="ExecutionDetailTitle" localization:LocalizedResourceKey.Key="ExecutionDetailTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock x:Uid="ExecutionSelectRow" localization:LocalizedResourceKey.Key="ExecutionSelectRow" TextWrapping="Wrap"
                                                       Visibility="{x:Bind vm:HistoryPage.AuditSelectionHint(ViewModel.SelectedExecution), Mode=OneWay}" />
                                            <StackPanel Spacing="8" Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasSelectedExecution), Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ViewModel.SelectedExecution.Summary, Mode=OneWay}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedExecution.ExecutionIdentifier, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                <TextBlock x:Uid="ExecutionOperationsTitle" localization:LocalizedResourceKey.Key="ExecutionOperationsTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock x:Uid="ExecutionNoOperations" localization:LocalizedResourceKey.Key="ExecutionNoOperations" TextWrapping="Wrap"
                                                           Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.ShowEmptyExecutionOperations), Mode=OneWay}" />
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.ExecutionOperations, Mode=OneWay}" AutomationProperties.AutomationId="ExecutionOperationsList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:AuditHistoryRow">
                                                            <StackPanel Spacing="4" Padding="0,4">
                                                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" AutomationProperties.AutomationId="ExecutionOperation" />
                                                                <TextBlock Text="{x:Bind Diagnostic}" Visibility="{x:Bind HasDiagnostic}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Expander Header="{x:Bind ViewModel.SelectedExecution.Model, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedExecution.Workspace, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedExecution.ReasoningEffort, Mode=OneWay}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedExecution.Usage, Mode=OneWay}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedExecution.Session, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedExecution.Identifiers, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    </StackPanel>
                                                </Expander>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                          Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.ShowEmptyExecutionHistory), Mode=OneWay}">
                            <Border Padding="20" Margin="12" MaxWidth="460"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ExecutionHistoryEmptyCard">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <Viewbox Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                             AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                                        <SymbolIcon Symbol="Clock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind ViewModel.ExecutionEmptyHeading, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="EmptyExecutionHistory" />
                                    <TextBlock Text="{x:Bind ViewModel.ExecutionEmptyDescription, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="ExecutionHistoryEmptyBody" />
                                    <Button Command="{x:Bind ViewModel.ClearExecutionDayFilterCommand}"
                                            Content="{x:Bind ViewModel.ClearExecutionDayFilterLabel, Mode=OneWay}"
                                            Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.ShowEmptyExecutionDayClearAction), Mode=OneWay}"
                                            AutomationProperties.AutomationId="ClearExecutionDayFilterEmpty" />
                                </StackPanel>
                            </Border>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    <Grid x:Name="AllOperationsPanel" Grid.Row="1" RowSpacing="8" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasAuditEvents), Mode=OneWay}">
                            <ComboBox x:Uid="AuditServiceFilter" AutomationProperties.AutomationId="AuditServiceFilter" Width="150"
                                      ItemsSource="{x:Bind ViewModel.AuditServiceOptions, Mode=OneWay}" DisplayMemberPath="Label"
                                      SelectedItem="{x:Bind ViewModel.AuditServiceFilter, Mode=TwoWay}" />
                            <ComboBox x:Uid="AuditKindFilter" AutomationProperties.AutomationId="AuditKindFilter" Width="158"
                                      ItemsSource="{x:Bind ViewModel.AuditKindOptions, Mode=OneWay}" DisplayMemberPath="Label"
                                      SelectedItem="{x:Bind ViewModel.AuditKindFilter, Mode=TwoWay}" />
                        </StackPanel>
                        <Grid Grid.Row="1" x:Name="AuditBrowser" SizeChanged="AuditBrowser_SizeChanged" ColumnSpacing="12" RowSpacing="8"
                              Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.HasAuditEvents), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="AuditDetailColumn" Width="280" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition x:Name="AuditDetailRow" Height="0" />
                            </Grid.RowDefinitions>
                            <ListView x:Name="AuditHistoryList" ItemsSource="{x:Bind ViewModel.FilteredAuditEvents, Mode=OneWay}" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      AutomationProperties.AutomationId="AuditHistoryList" SelectionMode="Single" SelectionChanged="AuditHistoryList_SelectionChanged"
                                      AutomationProperties.Name="{x:Bind ViewModel.AuditTabTitle, Mode=OneWay}">
                                <ListView.Resources>
                                    <Style x:Key="AuditColumnThumbStyle" TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid Background="Transparent">
                                                        <Border Width="1" HorizontalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.Header>
                                    <Grid ColumnSpacing="8" Padding="12,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="{x:Bind ViewModel.AuditColumns.Time, Mode=OneWay}" /><ColumnDefinition Width="{x:Bind ViewModel.AuditColumns.Action, Mode=OneWay}" /><ColumnDefinition Width="{x:Bind ViewModel.AuditColumns.Service, Mode=OneWay}" /><ColumnDefinition Width="{x:Bind ViewModel.AuditColumns.Conversation, Mode=OneWay}" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="AuditTimeColumn" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" localization:LocalizedResourceKey.Key="AuditTimeColumn" />
                                        <TextBlock Grid.Column="1" x:Uid="AuditActionColumn" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" localization:LocalizedResourceKey.Key="AuditActionColumn" />
                                        <TextBlock Grid.Column="2" x:Uid="AuditServiceColumn" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" localization:LocalizedResourceKey.Key="AuditServiceColumn" />
                                        <TextBlock Grid.Column="3" x:Uid="AuditConversationColumn" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" localization:LocalizedResourceKey.Key="AuditConversationColumn" />
                                        <Thumb Grid.Column="0" HorizontalAlignment="Right" Width="8" IsTabStop="True" Tag="Time"
                                                             x:Uid="AuditResizeTime" AutomationProperties.AutomationId="AuditResizeTime"
                                                             DragDelta="AuditColumn_DragDelta" KeyDown="AuditColumn_KeyDown" Style="{StaticResource AuditColumnThumbStyle}" />
                                        <Thumb Grid.Column="1" HorizontalAlignment="Right" Width="8" IsTabStop="True" Tag="Action"
                                                             x:Uid="AuditResizeAction" AutomationProperties.AutomationId="AuditResizeAction"
                                                             DragDelta="AuditColumn_DragDelta" KeyDown="AuditColumn_KeyDown" Style="{StaticResource AuditColumnThumbStyle}" />
                                        <Thumb Grid.Column="2" HorizontalAlignment="Right" Width="8" IsTabStop="True" Tag="Service"
                                                             x:Uid="AuditResizeService" AutomationProperties.AutomationId="AuditResizeService"
                                                             DragDelta="AuditColumn_DragDelta" KeyDown="AuditColumn_KeyDown" Style="{StaticResource AuditColumnThumbStyle}" />
                                        <Thumb Grid.Column="3" HorizontalAlignment="Right" Width="8" IsTabStop="True" Tag="Conversation"
                                                             x:Uid="AuditResizeConversation" AutomationProperties.AutomationId="AuditResizeConversation"
                                                             DragDelta="AuditColumn_DragDelta" KeyDown="AuditColumn_KeyDown" Style="{StaticResource AuditColumnThumbStyle}" />
                                    </Grid>
                                </ListView.Header>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AuditHistoryRow">
                                        <Grid ColumnSpacing="8" Padding="12,5" AutomationProperties.Name="{x:Bind Summary}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="{x:Bind Columns.Time, Mode=OneWay}" /><ColumnDefinition Width="{x:Bind Columns.Action, Mode=OneWay}" /><ColumnDefinition Width="{x:Bind Columns.Service, Mode=OneWay}" /><ColumnDefinition Width="{x:Bind Columns.Conversation, Mode=OneWay}" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Time}" ToolTipService.ToolTip="{x:Bind Timestamp}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Kind}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Kind}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Source}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Conversation}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Conversation}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Border x:Name="AuditDetailPane" Grid.Column="1" BorderThickness="1" CornerRadius="6" Padding="12"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" AutomationProperties.AutomationId="AuditDetailPane">
                                <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="8">
                                        <TextBlock x:Uid="AuditDetailTitle" localization:LocalizedResourceKey.Key="AuditDetailTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Uid="AuditSelectRow" localization:LocalizedResourceKey.Key="AuditSelectRow" TextWrapping="Wrap"
                                                   Visibility="{x:Bind vm:HistoryPage.AuditSelectionHint(ViewModel.SelectedAuditRow), Mode=OneWay}" />
                                        <ContentControl Content="{x:Bind ViewModel.SelectedAuditRow, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                                            <ContentControl.ContentTemplate>
                                                <DataTemplate x:DataType="vm:AuditHistoryRow">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="{x:Bind Kind}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                        <TextBlock Text="{x:Bind Timestamp}" />
                                                        <TextBlock Text="{x:Bind Source}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Conversation}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Identifiers}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="AuditIdentifiers" />
                                                        <TextBlock Text="{x:Bind ExecutionIdentifier}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind HasExecutionIdentifier}" />
                                                        <TextBlock Text="{x:Bind Diagnostic}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="{x:Bind HasDiagnostic}" AutomationProperties.AutomationId="AuditDiagnostic" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ContentControl.ContentTemplate>
                                        </ContentControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="1" x:Uid="AuditNoMatches" localization:LocalizedResourceKey.Key="AuditNoMatches"
                                   Margin="12,44,12,0" TextWrapping="Wrap" IsHitTestVisible="False"
                                   Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.ShowEmptyAuditFilter), Mode=OneWay}" />
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                      Visibility="{x:Bind vm:HistoryPage.BoolToVisibility(ViewModel.ShowEmptyAuditHistory), Mode=OneWay}">
                        <Border Padding="20" Margin="12" MaxWidth="460"
                                HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="AuditHistoryEmptyCard">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <Viewbox Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                         AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                                    <SymbolIcon Symbol="Document" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Viewbox>
                                <TextBlock Text="{x:Bind ViewModel.NoAuditText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="EmptyAuditHistory" />
                                <TextBlock Text="{x:Bind ViewModel.AuditEmptyDescription, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="AuditHistoryEmptyBody" />
                            </StackPanel>
                        </Border>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
