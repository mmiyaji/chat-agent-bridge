<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChatAgentBridge_Desktop.History.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:ChatAgentBridge_Desktop.History"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24,18,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="8">
            <TextBlock  Style="{StaticResource TitleTextBlockStyle}"  x:Uid="historyHistoryPageTextBlock001" />
            <TextBlock
                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"  x:Uid="historyHistoryPageTextBlock002" />
            <StackPanel Spacing="6">
                <Button  HorizontalAlignment="Left" Click="AgentSettingsRequested_Click"
                        AutomationProperties.AutomationId="AgentSettingsFromHistory"  x:Uid="AgentSettingsFromHistory" />
                <Button  HorizontalAlignment="Left" Command="{x:Bind ViewModel.RefreshCommand}"
                        AutomationProperties.AutomationId="RefreshHistory"  x:Uid="RefreshHistory" />
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="HistoryStatus" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled" IsVerticalScrollChainingEnabled="True"
                      AutomationProperties.AutomationId="HistoryScroll">
            <StackPanel Spacing="18">
                <StackPanel Spacing="6">
                    <TextBlock  Style="{StaticResource SubtitleTextBlockStyle}"  x:Uid="historyHistoryPageTextBlock003" />
                    <TextBlock
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"  x:Uid="historyHistoryPageTextBlock004" />
                    <TextBlock
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"  x:Uid="historyHistoryPageTextBlock005" />
                    <Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.Executions, Mode=OneWay}" MaxHeight="220"
                                   AutomationProperties.AutomationId="ExecutionHistoryList" x:Uid="ExecutionHistoryList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ExecutionHistoryRow">
                                    <StackPanel Margin="8,6" Spacing="4">
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Workspace}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Conversation}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Model}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind ReasoningEffort}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Usage}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Session}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                                   TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"
                                   Visibility="{x:Bind vm:HistoryPage.EmptyToVisibility(ViewModel.HasExecutions), Mode=OneWay}"
                                   AutomationProperties.AutomationId="EmptyExecutionHistory"  x:Uid="EmptyExecutionHistory" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock  Style="{StaticResource SubtitleTextBlockStyle}"  x:Uid="historyHistoryPageTextBlock006" />
                    <TextBlock
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"  x:Uid="historyHistoryPageTextBlock007" />
                    <StackPanel Spacing="6">
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.EditSelectedSessionModelCommand}"
                                AutomationProperties.AutomationId="EditSessionModel">
                            <Button.Content><TextBlock  TextWrapping="Wrap"  x:Uid="historyHistoryPageTextBlock008" /></Button.Content>
                        </Button>
                        <Button HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.EditSelectedSessionPolicyCommand}"
                                AutomationProperties.AutomationId="EditSessionExecutionPolicy">
                            <Button.Content><TextBlock  TextWrapping="Wrap"  x:Uid="historyHistoryPageTextBlock009" /></Button.Content>
                        </Button>
                        <Button HorizontalAlignment="Stretch"
                                Command="{x:Bind ViewModel.DetachSelectedSessionCommand}"
                                AutomationProperties.AutomationId="DetachSession" x:Uid="DetachSession">
                            <Button.Content><TextBlock  TextWrapping="Wrap"  x:Uid="historyHistoryPageTextBlock010" /></Button.Content>
                        </Button>
                    </StackPanel>
                    <Grid>
                        <ListView MaxHeight="250" ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                                   AutomationProperties.AutomationId="SavedSessionsList" x:Uid="SavedSessionsList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionHistoryRow">
                                    <StackPanel Margin="8,6" Spacing="4">
                                        <TextBlock Text="{x:Bind Provider}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Conversation}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Workspace}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind AgentAndSession}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Model}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ReasoningEffort}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ExecutionPolicy}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Updated}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                                   TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"
                                   Visibility="{x:Bind vm:HistoryPage.EmptyToVisibility(ViewModel.HasSessions), Mode=OneWay}"
                                   AutomationProperties.AutomationId="EmptySavedSessions"  x:Uid="EmptySavedSessions" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock  Style="{StaticResource SubtitleTextBlockStyle}"  x:Uid="historyHistoryPageTextBlock011" />
                    <TextBlock
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"  x:Uid="historyHistoryPageTextBlock012" />
                    <Grid>
                        <ListView MaxHeight="220" ItemsSource="{x:Bind ViewModel.AuditEvents, Mode=OneWay}"
                                   AutomationProperties.AutomationId="AuditHistoryList" x:Uid="AuditHistoryList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:AuditHistoryRow">
                                    <StackPanel Margin="8,6" Spacing="4">
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind Conversation}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                                   TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"
                                   Visibility="{x:Bind vm:HistoryPage.EmptyToVisibility(ViewModel.HasAuditEvents), Mode=OneWay}"
                                   AutomationProperties.AutomationId="EmptyAuditHistory"  x:Uid="EmptyAuditHistory" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
