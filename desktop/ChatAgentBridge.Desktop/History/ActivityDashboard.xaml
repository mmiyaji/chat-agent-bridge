<UserControl
    x:Class="ChatAgentBridge_Desktop.History.ActivityDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization"
    xmlns:local="using:ChatAgentBridge_Desktop.History"
    xmlns:pricing="using:ChatAgentBridge_Desktop.Pricing">
    <UserControl.Resources>
        <DataTemplate x:Key="ActivityBarTemplate" x:DataType="local:ActivityBarRow">
            <StackPanel Spacing="4" Margin="0,0,0,12" AutomationProperties.Name="{x:Bind AccessibleLabel}">
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{x:Bind CountLabel}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Percent}" Height="8" AutomationProperties.Name="{x:Bind AccessibleLabel}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="ActivityScroll">
        <StackPanel Spacing="16" Padding="0,8,8,16">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" x:Uid="ActivityHeading" localization:LocalizedResourceKey.Key="ActivityHeading" />
                    <TextBlock Text="{x:Bind ViewModel.ActivityRange, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="ActivityDateRange" />
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedIndex="{x:Bind ViewModel.ActivityRangeIndex, Mode=TwoWay}"
                          VerticalAlignment="Center" AutomationProperties.AutomationId="ActivityPeriod" x:Uid="ActivityPeriod">
                    <ComboBoxItem Content="{x:Bind ViewModel.Activity30DaysLabel}" AutomationProperties.AutomationId="ActivityPeriod30" />
                    <ComboBoxItem Content="{x:Bind ViewModel.Activity90DaysLabel}" AutomationProperties.AutomationId="ActivityPeriod90" />
                    <ComboBoxItem Content="{x:Bind ViewModel.Activity365DaysLabel}" AutomationProperties.AutomationId="ActivityPeriod365" />
                </ComboBox>
            </Grid>

            <TextBlock Text="{x:Bind ViewModel.ActivityStatisticsNotice, Mode=OneWay}" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.HasActivityStatisticsNotice), Mode=OneWay}"
                       AutomationProperties.AutomationId="ActivityStatisticsNotice" />

            <Border Style="{StaticResource ActivityCardStyle}" Padding="16" MaxWidth="460"
                    HorizontalAlignment="Center"
                    Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ShowActivityEmptyState), Mode=OneWay}"
                    AutomationProperties.AutomationId="ActivityEmptyCard">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Viewbox Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                             AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                        <SymbolIcon Symbol="Clock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Viewbox>
                    <TextBlock Text="{x:Bind ViewModel.ActivityEmptyHeading, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                               AutomationProperties.AutomationId="ActivityEmpty" />
                    <TextBlock Text="{x:Bind ViewModel.ActivityEmptyDescription, Mode=OneWay}"
                               Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                               AutomationProperties.AutomationId="ActivityEmptyBody" />
                </StackPanel>
            </Border>

            <Grid x:Name="SummaryGrid" ColumnSpacing="8" RowSpacing="8"
                  Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ActivityStatisticsAvailable), Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource ActivityCardStyle}">
                    <StackPanel Spacing="4"><TextBlock Style="{StaticResource CaptionTextBlockStyle}" x:Uid="ActivityTotalLabel" localization:LocalizedResourceKey.Key="ActivityTotalLabel" /><TextBlock Text="{x:Bind ViewModel.ActivityTotal, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="ActivityTotal" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ActivityCardStyle}">
                    <StackPanel Spacing="4"><TextBlock Style="{StaticResource CaptionTextBlockStyle}" x:Uid="ActivityActiveDaysLabel" localization:LocalizedResourceKey.Key="ActivityActiveDaysLabel" /><TextBlock Text="{x:Bind ViewModel.ActivityActiveDays, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="ActivityActiveDays" /></StackPanel>
                </Border>
                <Border x:Name="StreakCard" Grid.Column="2" Style="{StaticResource ActivityCardStyle}">
                    <StackPanel Spacing="4"><TextBlock Style="{StaticResource CaptionTextBlockStyle}" x:Uid="ActivityStreakLabel" localization:LocalizedResourceKey.Key="ActivityStreakLabel" /><TextBlock Text="{x:Bind ViewModel.ActivityStreak, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.AutomationId="ActivityStreak" /></StackPanel>
                </Border>
                <Border x:Name="PeakCard" Grid.Column="3" Style="{StaticResource ActivityCardStyle}">
                    <StackPanel Spacing="4"><TextBlock Style="{StaticResource CaptionTextBlockStyle}" x:Uid="ActivityPeakLabel" localization:LocalizedResourceKey.Key="ActivityPeakLabel" /><TextBlock Text="{x:Bind ViewModel.ActivityPeak, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="ActivityPeak" /></StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource ActivityCardStyle}"
                    Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ActivityStatisticsAvailable), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="ActivityCalendarHeading" localization:LocalizedResourceKey.Key="ActivityCalendarHeading" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="ActivityCalendarHelp" localization:LocalizedResourceKey.Key="ActivityCalendarHelp" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ItemsControl ItemsSource="{x:Bind WeekdayLabels}">
                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" Height="24" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <GridView x:Name="CalendarGrid" Grid.Column="1" Height="192" Padding="0" ItemsSource="{x:Bind ViewModel.ActivityCalendar, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedActivityDay, Mode=OneWay}" SelectionChanged="CalendarGrid_SelectionChanged" ContainerContentChanging="CalendarGrid_ContainerContentChanging"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollMode="Disabled"
                                  SelectionMode="Single" AutomationProperties.AutomationId="ActivityCalendar" x:Uid="ActivityCalendar">
                            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Vertical" MaximumRowsOrColumns="7" /></ItemsPanelTemplate></GridView.ItemsPanel>
                            <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="MinWidth" Value="24" /><Setter Property="MinHeight" Value="24" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="2" /></Style></GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="local:ActivityCalendarCell">
                                    <Border Width="18" Height="18" Style="{x:Bind local:ActivityDashboard.HeatStyle(Level)}" ToolTipService.ToolTip="{x:Bind Label}"
                                            AutomationProperties.Name="{x:Bind Label}" AutomationProperties.AutomationId="ActivityDayCell">
                                        <TextBlock Text="{x:Bind OutsideText}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                    <TextBlock x:Uid="ActivityOutsideLegend" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" localization:LocalizedResourceKey.Key="ActivityOutsideLegend" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" AutomationProperties.AutomationId="ActivityLegend">
                        <Border Width="12" Height="12" Style="{StaticResource ActivityHeat0}" /><TextBlock Text="0" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,8,0" />
                        <Border Width="12" Height="12" Style="{StaticResource ActivityHeat1}" /><TextBlock Text="1" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,8,0" />
                        <Border Width="12" Height="12" Style="{StaticResource ActivityHeat2}" /><TextBlock Text="2–3" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,8,0" />
                        <Border Width="12" Height="12" Style="{StaticResource ActivityHeat3}" /><TextBlock Text="4–7" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,0,8,0" />
                        <Border Width="12" Height="12" Style="{StaticResource ActivityHeat4}" /><TextBlock Text="8+" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SelectedActivityDayText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="ActivitySelectedDay" />
                    <Button Click="OpenDay_Click" IsEnabled="{x:Bind ViewModel.CanOpenActivityDay, Mode=OneWay}" AutomationProperties.AutomationId="ActivityOpenDay" x:Uid="ActivityOpenDay" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ActivityCardStyle}" AutomationProperties.AutomationId="ActivityDailyHistogram" x:Uid="ActivityHistogramContainer" localization:LocalizedResourceKey.Key="ActivityHistogramContainer"
                    Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ActivityStatisticsAvailable), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" x:Uid="ActivityDailyHeading" localization:LocalizedResourceKey.Key="ActivityDailyHeading" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActivityDailyScale, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="ActivityDailyScale" />
                    </Grid>
                    <ScrollViewer x:Name="ActivityDailyViewport" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" AutomationProperties.AutomationId="ActivityDailyScroll"><ItemsControl x:Name="ActivityDailyPlot" ItemsSource="{x:Bind ViewModel.ActivityDaily}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:ActivityDailyBar">
                                <Grid Height="100" ToolTipService.ToolTip="{x:Bind Label}" AutomationProperties.Name="{x:Bind Label}">
                                    <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                    <Border Height="{x:Bind Height}" MinWidth="4" MaxWidth="16" Margin="2,0" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl></ScrollViewer>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ViewModel.ActivityDailyStart, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" /><TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActivityDailyEnd, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" /></Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ActivityCardStyle}"
                    Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ActivityStatisticsAvailable), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <TextBlock x:Uid="UsageHeading" Style="{StaticResource SubtitleTextBlockStyle}" localization:LocalizedResourceKey.Key="UsageHeading" />
                    <Grid x:Name="UsageFilters" ColumnSpacing="12" RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="UsageMetricControl" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.UsageMetricIndex, Mode=TwoWay}" AutomationProperties.AutomationId="UsageMetric" x:Uid="UsageMetric">
                            <ComboBoxItem Content="{x:Bind ViewModel.UsageTokenOption}" AutomationProperties.AutomationId="UsageMetricTokens" />
                            <ComboBoxItem Content="{x:Bind ViewModel.UsageCacheOption}" AutomationProperties.AutomationId="UsageMetricCache" />
                            <ComboBoxItem Content="{x:Bind ViewModel.UsageCostOption}" AutomationProperties.AutomationId="UsageMetricCost" />
                        </ComboBox>
                        <ComboBox x:Name="UsageScopeControl" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="{x:Bind ViewModel.UsageScopeIndex, Mode=TwoWay}" AutomationProperties.AutomationId="UsageScope" x:Uid="UsageScope">
                            <ComboBoxItem Content="{x:Bind ViewModel.UsageTurnOption}" AutomationProperties.AutomationId="UsageScopeTurn" />
                            <ComboBoxItem Content="{x:Bind ViewModel.UsageRequestOption}" AutomationProperties.AutomationId="UsageScopeRequest" />
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.UsageHeadline, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="UsageHeadline" />
                    <TextBlock Text="{x:Bind ViewModel.UsageCoverage, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="UsageCoverage" />
                    <TextBlock Text="{x:Bind ViewModel.UsageCostHeadline, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="UsageCostHeadline" />
                    <TextBlock Text="{x:Bind ViewModel.UsageCostCoverage, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="UsageCostCoverage" />
                    <TextBlock Text="{x:Bind ViewModel.UsageScopeNote, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                    <Border AutomationProperties.AutomationId="UsageDailyChart" x:Uid="UsageDailyChart">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.UsageDailyRange, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.UsageDailyScale, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                            <ScrollViewer x:Name="UsageDailyViewport" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled" AutomationProperties.AutomationId="UsageDailyScroll"><ItemsControl x:Name="UsageDailyPlot" ItemsSource="{x:Bind ViewModel.UsageDaily, Mode=OneWay}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ActivityUsageBar">
                                    <Grid Height="100" ToolTipService.ToolTip="{x:Bind AccessibleLabel}" AutomationProperties.Name="{x:Bind AccessibleLabel}">
                                        <Border Height="1" VerticalAlignment="Bottom" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                                        <Border Height="{x:Bind Height}" MinWidth="4" MaxWidth="16" Margin="2,0" VerticalAlignment="Bottom" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="2" />
                                        <TextBlock Text="{x:Bind Marker}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl></ScrollViewer>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Uid="UsageDailyHelp" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" localization:LocalizedResourceKey.Key="UsageDailyHelp" />
                    <Border AutomationProperties.AutomationId="UsageModelChart" x:Uid="UsageModelChart">
                        <StackPanel Spacing="8">
                            <TextBlock x:Uid="UsageModelsHeading" Style="{StaticResource BodyStrongTextBlockStyle}" localization:LocalizedResourceKey.Key="UsageModelsHeading" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.UsageModels, Mode=OneWay}">
                                <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ActivityUsageBar">
                                    <StackPanel Spacing="4" Margin="0,0,0,12" ToolTipService.ToolTip="{x:Bind AccessibleLabel}" AutomationProperties.Name="{x:Bind AccessibleLabel}">
                                    <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ValueLabel}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Percent}" Height="8" AutomationProperties.Name="{x:Bind AccessibleLabel}" />
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Uid="UsageCostMethod" AutomationProperties.AutomationId="UsageCostMethod">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.UsageCostMethodDate, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="UsageCostMethodDate" />
                            <TextBlock x:Uid="UsageCostMethodDetails" TextWrapping="Wrap" AutomationProperties.AutomationId="UsageCostMethodDetails" />
                            <TextBlock x:Uid="UsageCostLimitations" TextWrapping="Wrap" AutomationProperties.AutomationId="UsageCostLimitations" />
                            <HyperlinkButton NavigateUri="https://developers.openai.com/api/docs/pricing" AutomationProperties.AutomationId="UsageOpenAIPricing" x:Uid="UsageOpenAIPricing" />
                            <HyperlinkButton NavigateUri="https://platform.claude.com/docs/en/about-claude/pricing" AutomationProperties.AutomationId="UsageClaudePricing" x:Uid="UsageClaudePricing" />
                        </StackPanel>
                    </Expander>
                    <pricing:PricingSettings />
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Uid="UsageDayExpander" AutomationProperties.AutomationId="UsageDayExpander">
                        <StackPanel Spacing="8">
                            <ComboBox ItemsSource="{x:Bind ViewModel.UsageDays, Mode=OneWay}" DisplayMemberPath="Label" SelectedItem="{x:Bind ViewModel.SelectedUsageDay, Mode=TwoWay}" x:Uid="UsageDay" AutomationProperties.AutomationId="UsageDay" />
                            <TextBlock Text="{x:Bind ViewModel.UsageSelectedDetails, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="UsageDayDetails" />
                            <TextBlock Text="{x:Bind ViewModel.UsageSelectedCoverage, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.UsageSelectedCost, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="UsageDayCostDetails" />
                        </StackPanel>
                    </Expander>
                    <TextBlock x:Uid="UsageAccountingNote" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" localization:LocalizedResourceKey.Key="UsageAccountingNote" />
                </StackPanel>
            </Border>

            <Grid x:Name="BreakdownGrid" ColumnSpacing="16" RowSpacing="16"
                  Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ActivityStatisticsAvailable), Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="WeekdayCard" Style="{StaticResource ActivityCardStyle}" AutomationProperties.AutomationId="ActivityWeekdayChart" x:Uid="ActivityWeekdayContainer" localization:LocalizedResourceKey.Key="ActivityWeekdayContainer">
                    <StackPanel Spacing="12"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="ActivityWeekdaysHeading" localization:LocalizedResourceKey.Key="ActivityWeekdaysHeading" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ActivityWeekdays}" ItemTemplate="{StaticResource ActivityBarTemplate}" />
                    </StackPanel>
                </Border>
                <Border x:Name="ModelCard" Grid.Column="1" Style="{StaticResource ActivityCardStyle}" AutomationProperties.AutomationId="ActivityModelChart" x:Uid="ActivityModelContainer" localization:LocalizedResourceKey.Key="ActivityModelContainer">
                    <StackPanel Spacing="12"><TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="ActivityModelsHeading" localization:LocalizedResourceKey.Key="ActivityModelsHeading" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="ActivityModelsHelp" localization:LocalizedResourceKey.Key="ActivityModelsHelp" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ActivityModels}" ItemTemplate="{StaticResource ActivityBarTemplate}" />
                        <StackPanel Spacing="8" Margin="0,4" HorizontalAlignment="Center"
                                    Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ShowActivityModelEmptyState), Mode=OneWay}"
                                    AutomationProperties.AutomationId="ActivityModelsEmptyCard">
                            <Viewbox Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                     AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                                <SymbolIcon Symbol="Document" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Viewbox>
                            <TextBlock Text="{x:Bind ViewModel.ActivityModelEmptyHeading, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                       AutomationProperties.AutomationId="ActivityEmptyModels" />
                            <TextBlock Text="{x:Bind ViewModel.ActivityModelEmptyDescription, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                       AutomationProperties.AutomationId="ActivityModelsEmptyBody" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{x:Bind ViewModel.ActivityOutcomes, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="ActivityOutcomes"
                       Visibility="{x:Bind local:HistoryPage.BoolToVisibility(ViewModel.ActivityStatisticsAvailable), Mode=OneWay}" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="ActivityScopeNote" localization:LocalizedResourceKey.Key="ActivityScopeNote" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
