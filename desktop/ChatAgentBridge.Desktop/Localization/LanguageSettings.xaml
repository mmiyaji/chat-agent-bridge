<UserControl
    x:Class="ChatAgentBridge_Desktop.Localization.LanguageSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    xmlns:layout="using:ChatAgentBridge_Desktop.Layout">
    <settings:SettingsCard layout:SettingsCardLayout.IsAdaptive="True" Header="Language / 表示言語" AutomationProperties.AutomationId="LanguageSettingRow">
        <settings:SettingsCard.HeaderIcon><FontIcon Glyph="&#xF2B7;" /></settings:SettingsCard.HeaderIcon>
        <settings:SettingsCard.Description>
            <TextBlock x:Name="LanguageStatus" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="DisplayLanguageStatus" />
        </settings:SettingsCard.Description>
        <ComboBox x:Name="LanguagePicker" MinWidth="220" HorizontalAlignment="Left"
                  SelectedValuePath="Tag" SelectionChanged="LanguagePicker_SelectionChanged"
                  AutomationProperties.AutomationId="DisplayLanguage" AutomationProperties.Name="Language / 表示言語">
            <ComboBoxItem x:Name="SystemLanguageOption" Content="システムに合わせる (System default)" Tag="system" />
            <ComboBoxItem Content="日本語 (Japanese)" Tag="ja" />
            <ComboBoxItem Content="English" Tag="en" />
        </ComboBox>
    </settings:SettingsCard>
</UserControl>
