<Page
    x:Class="ChatAgentBridge_Desktop.Inbox.ChatInboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inbox="using:ChatAgentBridge_Desktop.Inbox">
    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Text="チャット受信" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="依頼をこのPCで承認して実行します。標準のCodex exec設定ではスレッドごとに会話を継続します。本文は確認してから共有できます。自動再接続は未対応です。" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="Mattermostに接続" Command="{x:Bind ViewModel.ConnectMattermostCommand}" AutomationProperties.AutomationId="ConnectMattermost"/>
            <Button Content="Slackに接続" Command="{x:Bind ViewModel.ConnectSlackCommand}" AutomationProperties.AutomationId="ConnectSlack"/>
            <Button Content="切断" Command="{x:Bind ViewModel.DisconnectCommand}" AutomationProperties.AutomationId="DisconnectChat"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="ChatStatus"/>
            <TextBlock Text="{x:Bind ViewModel.OverflowNotice, Mode=OneWay}" TextWrapping="Wrap"/>
        </StackPanel>
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Requests}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single" AutomationProperties.AutomationId="ChatRequests" AutomationProperties.Name="受信した依頼">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="inbox:InboxItem">
                    <StackPanel Spacing="4" Padding="4">
                        <TextBlock Text="{x:Bind Source}" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Text="{x:Bind Prompt}" TextWrapping="Wrap" MaxLines="4"/>
                        <TextBlock Text="{x:Bind Workspace}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind SessionLabel, Mode=OneWay}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind State, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
            <Button Content="内容を確認して実行" Command="{x:Bind ViewModel.ApproveCommand}" AutomationProperties.AutomationId="ApproveChat"/>
            <Button Content="拒否" Command="{x:Bind ViewModel.RejectCommand}" AutomationProperties.AutomationId="RejectChat"/>
            <Button Content="実行を停止" Command="{x:Bind ViewModel.CancelCommand}" AutomationProperties.AutomationId="CancelChat"/>
            <Button Content="結果をスレッドに送信" Command="{x:Bind ViewModel.SendResultCommand}" AutomationProperties.AutomationId="SendChatResult"/>
        </StackPanel>
        <TextBox Grid.Row="5" Header="実行結果（このPCにのみ表示）" Text="{x:Bind ViewModel.Output, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ChatOutput"/>
    </Grid>
</Page>
