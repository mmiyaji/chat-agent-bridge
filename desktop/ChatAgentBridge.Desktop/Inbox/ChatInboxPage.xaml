<Page
    x:Class="ChatAgentBridge_Desktop.Inbox.ChatInboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization"
    xmlns:inbox="using:ChatAgentBridge_Desktop.Inbox"
    xmlns:presentation="using:ChatAgentBridge_Desktop.Presentation"
    xmlns:executionUi="using:ChatAgentBridge_Desktop.ExecutionUi"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    SizeChanged="Page_SizeChanged"
    AutomationProperties.AutomationId="ChatScroll">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" x:Uid="inboxChatInboxPageTextBlock001" localization:LocalizedResourceKey.Key="inboxChatInboxPageTextBlock001" />
            <TextBlock TextWrapping="Wrap" x:Uid="inboxChatInboxPageTextBlock002"
                       Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.IsWideLayout), Mode=OneWay}" localization:LocalizedResourceKey.Key="inboxChatInboxPageTextBlock002" />
            <StackPanel x:Name="ConnectionActions" Orientation="Horizontal" Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8"
                          Visibility="{x:Bind inbox:ChatInboxPage.ConnectCommandsVisibility(ViewModel.IsWideLayout, ViewModel.IsConnected), Mode=OneWay}">
                <Button Command="{x:Bind ViewModel.ConnectMattermostCommand}" AutomationProperties.AutomationId="ConnectMattermost" x:Uid="ConnectMattermost" />
                <Button Command="{x:Bind ViewModel.ConnectSlackCommand}" AutomationProperties.AutomationId="ConnectSlack" x:Uid="ConnectSlack" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8"
                          Visibility="{x:Bind inbox:ChatInboxPage.ConnectCommandsVisibility(ViewModel.IsWideLayout, ViewModel.IsConnected), Mode=OneWay}">
                <Button Command="{x:Bind ViewModel.ConnectDiscordCommand}" AutomationProperties.AutomationId="ConnectDiscord" x:Uid="ConnectDiscord" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.ReconnectCommand}" AutomationProperties.AutomationId="ReconnectChat"
                        AutomationProperties.Name="{x:Bind ViewModel.ReconnectLabel, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.ReconnectHint, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ReconnectHint, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Text="{x:Bind ViewModel.ReconnectLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
                <Button Command="{x:Bind ViewModel.DisconnectCommand}" AutomationProperties.AutomationId="DisconnectChat" x:Uid="DisconnectChat"
                        Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.IsConnected), Mode=OneWay}">
                    <Button.Resources><ResourceDictionary Source="ms-appx:///DisconnectActionResources.xaml" /></Button.Resources>
                </Button>
              </StackPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="{x:Bind ViewModel.ShowPendingApprovalNotice, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Message="{x:Bind ViewModel.PendingApprovalMessage, Mode=OneWay}"
                     AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="InboxPendingApprovalsNotice">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.OpenPendingApprovalCommand}" x:Uid="InboxOpenPendingApproval"
                            AutomationProperties.AutomationId="InboxOpenPendingApproval" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="NotificationActionNotice" IsOpen="False" IsClosable="True" Severity="Warning"
                     Message="{x:Bind ViewModel.NotificationStatus, Mode=OneWay}"
                     AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="NotificationActionNotice" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasConnectionError, Mode=OneWay}" IsClosable="False"
                     Severity="Error" Message="{x:Bind ViewModel.Status, Mode=OneWay}"
                     AutomationProperties.AutomationId="InboxConnectionError">
                <InfoBar.ActionButton>
                    <Button Click="OpenConnectionSettings_Click" x:Uid="InboxOpenConnectionSettings"
                            AutomationProperties.AutomationId="InboxOpenConnectionSettings" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar IsOpen="{x:Bind ViewModel.HasConversationPersistenceWarning, Mode=OneWay}" IsClosable="False"
                     Severity="Warning" Message="{x:Bind ViewModel.ConversationPersistenceWarning, Mode=OneWay}"
                     AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="InboxConversationPersistenceWarning" />
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      AutomationProperties.AutomationId="InboxConnectionDetails" x:Uid="InboxConnectionSummary" localization:LocalizedResourceKey.Key="InboxConnectionSummary">
                <Expander.Header>
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <presentation:StatusIcon Tone="{x:Bind ViewModel.ConnectionTone, Mode=OneWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ConnectionLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="InboxConnectionLabel" />
                            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}" AutomationProperties.AutomationId="ChatStatus" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.QueueSummary, Mode=OneWay}" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="InboxQueueSummary"
                                   Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.IsWideLayout), Mode=OneWay}" />
                    </Grid>
                </Expander.Header>
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" x:Uid="InboxConnectionHelp" localization:LocalizedResourceKey.Key="InboxConnectionHelp" />
                        <TextBlock Text="{x:Bind ViewModel.NotificationStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="NotificationStatus" />
                    </StackPanel>
                </ScrollViewer>
            </Expander>
            <TextBlock Text="{x:Bind ViewModel.OverflowNotice, Mode=OneWay}" TextWrapping="Wrap"
                       Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasOverflowNotice), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.ProgressNotice, Mode=OneWay}" TextWrapping="Wrap"
                       Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasProgressNotice), Mode=OneWay}"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ChatProgressNotice" />
            <Button Command="{x:Bind ViewModel.ReturnToActiveRequestCommand, Mode=OneWay}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasOtherRequestRunning), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.ActiveRequestBannerText, Mode=OneWay}"
                    AutomationProperties.AutomationId="ActiveRequestBanner" x:Uid="InboxActiveRequestBannerButton" localization:LocalizedResourceKey.Key="InboxActiveRequestBannerButton">
                <TextBlock Text="{x:Bind ViewModel.ActiveRequestBannerText, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </Button>
        </StackPanel>
        <Grid x:Name="BodyGrid" Grid.Row="2" ColumnSpacing="0">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ConversationColumn" Width="2*" /><ColumnDefinition x:Name="ConversationSplitterColumn" Width="12" /><ColumnDefinition x:Name="DetailColumn" Width="3*" /></Grid.ColumnDefinitions>
            <Grid x:Name="ConversationPane" RowSpacing="8"
                  Visibility="{x:Bind inbox:ChatInboxPage.ConversationPaneVisibility(ViewModel.IsWideLayout, ViewModel.IsDetailOpen), Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.RowSpan="3" Style="{StaticResource ActivityCardStyle}" Padding="0" IsHitTestVisible="False" />
                <StackPanel Margin="12,12,12,0" Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" x:Uid="InboxConversationsHeading" localization:LocalizedResourceKey.Key="InboxConversationsHeading" />
                    <TextBlock Text="{x:Bind ViewModel.ConversationCountLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="InboxConversationCount" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="12,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="InboxSearchBox" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                                    TextMemberPath="SuggestionTitle" UpdateTextOnSelect="False"
                                    QueryIcon="Find"
                                    TextChanged="InboxSearch_TextChanged"
                                    QuerySubmitted="InboxSearch_QuerySubmitted"
                                    KeyDown="InboxSearch_KeyDown"
                                    AutomationProperties.AutomationId="InboxSearch" x:Uid="InboxSearch">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="inbox:InboxConversation">
                                <StackPanel Spacing="2" Padding="8,4">
                                    <TextBlock Text="{x:Bind SuggestionTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SuggestionSubtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <ComboBox Grid.Column="1" SelectedValue="{x:Bind ViewModel.StateFilter, Mode=TwoWay}"
                              SelectedValuePath="Tag" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="InboxStateFilter" x:Uid="InboxStateFilter">
                        <ComboBoxItem Tag="all" x:Uid="InboxFilterAll" localization:LocalizedResourceKey.Key="InboxFilterAll" />
                        <ComboBoxItem Tag="pending" x:Uid="InboxFilterPending" localization:LocalizedResourceKey.Key="InboxFilterPending" />
                        <ComboBoxItem Tag="active" x:Uid="InboxFilterActive" localization:LocalizedResourceKey.Key="InboxFilterActive" />
                        <ComboBoxItem Tag="completed" x:Uid="InboxFilterCompleted" localization:LocalizedResourceKey.Key="InboxFilterCompleted" />
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="2" Margin="4,0,4,4">
                <ListView x:Name="ConversationList" ItemsSource="{x:Bind ViewModel.VisibleConversations, Mode=OneWay}"
                          SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedConversation, Mode=OneWay}"
                          IsItemClickEnabled="True" ItemClick="Conversation_ItemClick" SelectionChanged="Conversation_SelectionChanged" KeyDown="Conversation_KeyDown" AutomationProperties.AutomationId="InboxConversations">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="inbox:InboxConversation">
                            <Grid Padding="8,12" RowSpacing="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid Width="32" Height="32" Loaded="ConversationPersonPicture_Loaded" Unloaded="ConversationPersonPicture_Unloaded" DataContextChanged="ConversationPersonPicture_DataContextChanged">
                                    <PersonPicture Width="32" Height="32" DisplayName="{x:Bind AvatarDisplayName, Mode=OneWay}"
                                                   AutomationProperties.Name="{x:Bind PersonName, Mode=OneWay}"
                                                   AutomationProperties.AccessibilityView="Control"
                                                   AutomationProperties.AutomationId="InboxConversationPersonPicture" />
                                    <PersonPicture Width="32" Height="32" DisplayName="{x:Bind AvatarDisplayName, Mode=OneWay}"
                                                   ProfilePicture="{x:Bind inbox:ChatInboxPage.AvatarImage(AvatarCachePath), Mode=OneWay}"
                                                   Visibility="{x:Bind inbox:ChatInboxPage.AvatarVisibility(AvatarCachePath), Mode=OneWay}"
                                                   IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ListTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ListTitle, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind TitleLocation, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind TitleLocation, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ActivityCompact, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Activity, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind LatestPrompt, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(HasSeveralRequests), Mode=OneWay}" />
                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <presentation:StatusIcon Tone="{x:Bind StateTone, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind StateSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind RequestCountLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ScrollViewer x:Name="InboxEmptyListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                              Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.ShowEmptyConversationList), Mode=OneWay}">
                    <Border Style="{StaticResource ActivityCardStyle}" Padding="20" Margin="12" MaxWidth="460"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="InboxEmptyListCard">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <Viewbox Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                         AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                                    <SymbolIcon Symbol="Message" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Viewbox>
                                <TextBlock Text="{x:Bind ViewModel.EmptyConversationHeading, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                           AutomationProperties.AutomationId="InboxEmptyList" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyConversationDescription, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                           AutomationProperties.AutomationId="InboxEmptyListBody" />
                                <Button Command="{x:Bind ViewModel.ClearConversationFiltersCommand}"
                                        Content="{x:Bind ViewModel.ClearConversationFiltersLabel, Mode=OneWay}"
                                        Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasConversationFilters), Mode=OneWay}"
                                        AutomationProperties.AutomationId="ClearInboxFilters" />
                            </StackPanel>
                    </Border>
                </ScrollViewer>
                </Grid>
            </Grid>
            <controls:GridSplitter x:Name="ConversationSplitter" Grid.Column="1" Width="12"
                                   ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                   AutomationProperties.AutomationId="InboxConversationsSplitter"
                                   x:Uid="InboxConversationsSplitter" />
            <Grid x:Name="DetailPane" Grid.Column="2" RowSpacing="8"
                  Visibility="{x:Bind inbox:ChatInboxPage.DetailPaneVisibility(ViewModel.IsWideLayout, ViewModel.IsDetailOpen), Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.RowSpan="3" Style="{StaticResource ActivityCardStyle}" Padding="0" IsHitTestVisible="False" />
                <ScrollViewer Grid.Row="2" x:Name="InboxDetailEmptyScroll" MaxWidth="460" HorizontalAlignment="Center"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                              Visibility="{x:Bind inbox:ChatInboxPage.HiddenWhen(ViewModel.HasSelectedConversation), Mode=OneWay}">
                    <Border Style="{StaticResource ActivityCardStyle}" Padding="20" Margin="12" MaxWidth="460"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="InboxDetailEmptyCard">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <Viewbox Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                         AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                                    <SymbolIcon Symbol="Message" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Viewbox>
                                <TextBlock Text="{x:Bind ViewModel.EmptyDetailHeading, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                           AutomationProperties.AutomationId="InboxDetailEmpty" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyDetailDescription, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                           AutomationProperties.AutomationId="InboxDetailEmptyBody" />
                            </StackPanel>
                    </Border>
                </ScrollViewer>
                <Grid Margin="12,12,12,0" ColumnSpacing="8" Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedConversation), Mode=OneWay}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="InboxBackButton" Click="BackToConversations_Click" Visibility="{x:Bind inbox:ChatInboxPage.BackButtonVisibility(ViewModel.IsWideLayout), Mode=OneWay}"
                                    AutomationProperties.AutomationId="InboxBackToConversations" x:Uid="InboxBackToConversations" />
                            <Grid Grid.Column="1" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid Width="32" Height="32">
                                <PersonPicture x:Name="InboxSelectedPersonPicture" Width="32" Height="32"
                                               DisplayName="{x:Bind ViewModel.SelectedConversation.AvatarDisplayName, Mode=OneWay, FallbackValue=''}"
                                               AutomationProperties.Name="{x:Bind ViewModel.SelectedConversation.PersonName, Mode=OneWay, FallbackValue=''}"
                                               AutomationProperties.AccessibilityView="Control"
                                               AutomationProperties.AutomationId="InboxSelectedPersonPicture" />
                                <PersonPicture Width="32" Height="32" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"
                                               DisplayName="{x:Bind ViewModel.SelectedConversation.AvatarDisplayName, Mode=OneWay, FallbackValue=''}"
                                               ProfilePicture="{x:Bind inbox:ChatInboxPage.AvatarImage(ViewModel.SelectedConversation.AvatarCachePath), Mode=OneWay, FallbackValue={x:Null}}"
                                               Visibility="{x:Bind inbox:ChatInboxPage.AvatarVisibility(ViewModel.SelectedConversation.AvatarCachePath), Mode=OneWay, FallbackValue=Collapsed}"
                                               AutomationProperties.AutomationId="InboxSelectedProfileImage" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SelectedConversation.ListTitle, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedConversation.TitleLocation, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>

                <Grid Grid.Row="1" Margin="12,0" ColumnSpacing="4" Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedRequest), Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"
                                Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.IsSelectedPending), Mode=OneWay}">
                        <Button Command="{x:Bind ViewModel.ApproveCommand}" Style="{StaticResource AccentButtonStyle}"
                                x:Uid="InboxApproveAction" AutomationProperties.AutomationId="ApproveChat" />
                        <Button Command="{x:Bind ViewModel.RejectCommand}" x:Uid="InboxRejectAction"
                                AutomationProperties.AutomationId="RejectChat" />
                    </StackPanel>
                    <CommandBar x:Name="InboxCommandBar" Grid.Row="1" Background="Transparent" DefaultLabelPosition="Right"
                                Visibility="{x:Bind inbox:ChatInboxPage.HiddenWhen(ViewModel.IsSelectedPending), Mode=OneWay}"
                                IsDynamicOverflowEnabled="True" AutomationProperties.AutomationId="InboxCommandBar">
                        <AppBarButton Command="{x:Bind ViewModel.CancelCommand}"
                                      Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.IsSelectedActiveExecution), Mode=OneWay}"
                                      AutomationProperties.AutomationId="CancelChat" x:Uid="InboxStopBar">
                            <AppBarButton.Icon><SymbolIcon Symbol="Stop" /></AppBarButton.Icon>
                        </AppBarButton>
                            <AppBarButton Command="{x:Bind ViewModel.SendResultCommand}" AutomationProperties.AutomationId="SendChatResult" x:Uid="InboxShareBar"
                                          Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedResult), Mode=OneWay}">
                                <AppBarButton.Icon><SymbolIcon Symbol="Send" /></AppBarButton.Icon>
                            </AppBarButton>
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Command="{x:Bind ViewModel.SendAttachmentsCommand}" AutomationProperties.AutomationId="SendChatAttachments" x:Uid="InboxAttachmentsBar">
                                <AppBarButton.Icon><SymbolIcon Symbol="Attach" /></AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <Button x:Name="InboxApprovalHelpButton" Grid.Row="1" Grid.Column="1" Click="ApprovalHelp_Click"
                            AutomationProperties.AutomationId="InboxApprovalHelp" x:Uid="InboxApprovalHelpButton">
                        <SymbolIcon Symbol="Help" />
                    </Button>
                    <TeachingTip x:Name="InboxApprovalHelpTip" Target="{x:Bind InboxApprovalHelpButton}"
                                 CloseButtonClick="ApprovalHelp_Close"
                                 IsLightDismissEnabled="True" AutomationProperties.AutomationId="InboxApprovalHelpTip"
                                 x:Uid="InboxApprovalHelpTip">
                        <StackPanel Spacing="8" MaxWidth="360">
                            <TextBlock Text="{x:Bind ViewModel.SelectedApprovalPolicyHelp, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedResultPolicyHelp, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedAttachmentPolicyHelp, Mode=OneWay}" TextWrapping="Wrap" />
                        </StackPanel>
                    </TeachingTip>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Bind ViewModel.SelectedAttachmentStatus, Mode=OneWay}"
                               Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedResult), Mode=OneWay}"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SelectedAttachmentStatus" />
                </Grid>
                <ScrollViewer x:Name="InboxDetailScroll" Grid.Row="2" Margin="12,0,12,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedRequest), Mode=OneWay}">
                    <StackPanel Spacing="12" AutomationProperties.AutomationId="InboxConversationDetail">
                        <InfoBar IsOpen="{x:Bind ViewModel.IsSelectedPending, Mode=OneWay}"
                                 IsClosable="False" Severity="Warning" x:Uid="InboxApprovalNotice"
                                 AutomationProperties.AutomationId="InboxApprovalNotice" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <presentation:StatusIcon Tone="{x:Bind ViewModel.Selected.StateTone, Mode=OneWay, FallbackValue='neutral'}" />
                            <TextBlock Text="{x:Bind ViewModel.Selected.StateDisplay, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="InboxSelectedState" />
                        </StackPanel>
                        <TextBlock x:Name="InboxRequestCountText" Text="{x:Bind ViewModel.SelectedRequestCountLabel, Mode=OneWay}" AutomationProperties.AutomationId="InboxRequestCount" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.ConversationRequests, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" DisplayMemberPath="RequestLabel"
                                  HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{x:Bind InboxRequestCountText}"
                                  AutomationProperties.AutomationId="ChatRequests" x:Uid="InboxRequestPicker" localization:LocalizedResourceKey.Key="InboxRequestPicker" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="InboxPromptLabel" localization:LocalizedResourceKey.Key="InboxPromptLabel" />
                        <TextBox Text="{x:Bind ViewModel.Selected.PromptDisplay, Mode=OneWay, FallbackValue=''}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" MinHeight="80" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="InboxSelectedPrompt" />
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Uid="InboxRequestContext" AutomationProperties.AutomationId="InboxRequestContext">
                            <StackPanel Spacing="8">
                                <TextBlock TextWrapping="Wrap" x:Uid="InboxSameThreadHelp" localization:LocalizedResourceKey.Key="InboxSameThreadHelp" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Source, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" AutomationProperties.AutomationId="InboxSelectedIdentity" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Request.ThreadId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Workspace, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.SessionLabel, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <executionUi:LiveOutputView ViewModel="{x:Bind ViewModel.SelectedLiveOutput, Mode=OneWay}"
                                                    CancelCommand="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                                                    AutomationProperties.AutomationId="ChatLiveOutput" />
                        <StackPanel Spacing="8" Visibility="{x:Bind inbox:ChatInboxPage.HiddenWhen(ViewModel.IsSelectedPending), Mode=OneWay}">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="InboxResultLabel" localization:LocalizedResourceKey.Key="InboxResultLabel" />
                        <TextBox Text="{x:Bind ViewModel.SelectedOutput, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" MinHeight="120" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="ChatOutput" x:Uid="ChatOutput" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedUsage, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   AutomationProperties.AutomationId="ChatUsageSummary" x:Uid="ChatUsageSummary" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="InboxRestoredConversationScroll" Grid.Row="2" Margin="12,0,12,12"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedRestoredConversation), Mode=OneWay}"
                              AutomationProperties.AutomationId="InboxRestoredConversationDetails">
                    <Border Style="{StaticResource ActivityCardStyle}" Padding="20" Margin="0,0,0,4" MaxWidth="560"
                            HorizontalAlignment="Stretch" AutomationProperties.AutomationId="InboxRestoredConversation">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <presentation:StatusIcon Tone="{x:Bind ViewModel.SelectedConversation.StateTone, Mode=OneWay, FallbackValue='neutral'}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedConversation.StateSummary, Mode=OneWay, FallbackValue=''}"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="InboxRestoredState" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.SelectedConversation.RequestCountLabel, Mode=OneWay, FallbackValue=''}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       AutomationProperties.AutomationId="InboxRestoredRequestCount" />
                            <TextBlock Text="{x:Bind ViewModel.RestoredConversationDescription, Mode=OneWay}"
                                       Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="InboxRestoredConversationDescription" />
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           x:Uid="InboxRestoredTitleLabel" localization:LocalizedResourceKey.Key="InboxRestoredTitleLabel" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedConversation.Title, Mode=OneWay, FallbackValue=''}"
                                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="InboxRestoredTitle" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           x:Uid="InboxRestoredLocationLabel" localization:LocalizedResourceKey.Key="InboxRestoredLocationLabel" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedConversation.Location, Mode=OneWay, FallbackValue=''}"
                                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="InboxRestoredLocation" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           x:Uid="InboxRestoredActivityLabel" localization:LocalizedResourceKey.Key="InboxRestoredActivityLabel" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedConversation.Activity, Mode=OneWay, FallbackValue=''}"
                                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="InboxRestoredActivity" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           x:Uid="InboxRestoredWorkspaceLabel" localization:LocalizedResourceKey.Key="InboxRestoredWorkspaceLabel" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedConversation.Workspace, Mode=OneWay, FallbackValue=''}"
                                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           AutomationProperties.AutomationId="InboxRestoredWorkspace" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
