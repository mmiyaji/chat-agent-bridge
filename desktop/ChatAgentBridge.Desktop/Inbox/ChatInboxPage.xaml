<Page
    x:Class="ChatAgentBridge_Desktop.Inbox.ChatInboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization"
    xmlns:inbox="using:ChatAgentBridge_Desktop.Inbox"
    xmlns:presentation="using:ChatAgentBridge_Desktop.Presentation"
    xmlns:executionUi="using:ChatAgentBridge_Desktop.ExecutionUi"
    SizeChanged="Page_SizeChanged"
    AutomationProperties.AutomationId="ChatScroll">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" x:Uid="inboxChatInboxPageTextBlock001" localization:LocalizedResourceKey.Key="inboxChatInboxPageTextBlock001" />
            <TextBlock TextWrapping="Wrap" x:Uid="inboxChatInboxPageTextBlock002"
                       Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.IsWideLayout), Mode=OneWay}" localization:LocalizedResourceKey.Key="inboxChatInboxPageTextBlock002" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.ConnectMattermostCommand}" AutomationProperties.AutomationId="ConnectMattermost" x:Uid="ConnectMattermost" />
                <Button Command="{x:Bind ViewModel.ConnectSlackCommand}" AutomationProperties.AutomationId="ConnectSlack" x:Uid="ConnectSlack" />
                <Button Command="{x:Bind ViewModel.DisconnectCommand}" AutomationProperties.AutomationId="DisconnectChat" x:Uid="DisconnectChat">
                    <Button.Resources><ResourceDictionary Source="ms-appx:///ImpactActionResources.xaml" /></Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="NotificationActionNotice" IsOpen="False" IsClosable="True" Severity="Warning"
                     Message="{x:Bind ViewModel.NotificationStatus, Mode=OneWay}"
                     AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="NotificationActionNotice" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasConnectionError, Mode=OneWay}" IsClosable="False"
                     Severity="Error" Message="{x:Bind ViewModel.Status, Mode=OneWay}"
                     AutomationProperties.AutomationId="InboxConnectionError">
                <InfoBar.ActionButton>
                    <Button Click="OpenConnectionSettings_Click" x:Uid="InboxOpenConnectionSettings"
                            AutomationProperties.AutomationId="InboxOpenConnectionSettings" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      AutomationProperties.AutomationId="InboxConnectionDetails" x:Uid="InboxConnectionSummary" localization:LocalizedResourceKey.Key="InboxConnectionSummary">
                <Expander.Header>
                    <Grid ColumnSpacing="12" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <presentation:StatusIcon Tone="{x:Bind ViewModel.ConnectionTone, Mode=OneWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ConnectionLabel, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.AutomationId="InboxConnectionLabel" />
                            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}" AutomationProperties.AutomationId="ChatStatus" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.QueueSummary, Mode=OneWay}" VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="InboxQueueSummary"
                                   Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.IsWideLayout), Mode=OneWay}" />
                    </Grid>
                </Expander.Header>
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <TextBlock TextWrapping="Wrap" x:Uid="InboxConnectionHelp" localization:LocalizedResourceKey.Key="InboxConnectionHelp" />
                        <TextBlock Text="{x:Bind ViewModel.NotificationStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="NotificationStatus" />
                    </StackPanel>
                </ScrollViewer>
            </Expander>
            <TextBlock Text="{x:Bind ViewModel.OverflowNotice, Mode=OneWay}" TextWrapping="Wrap"
                       Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasOverflowNotice), Mode=OneWay}" />
            <TextBlock Text="{x:Bind ViewModel.ProgressNotice, Mode=OneWay}" TextWrapping="Wrap"
                       Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasProgressNotice), Mode=OneWay}"
                       AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ChatProgressNotice" />
            <Button Command="{x:Bind ViewModel.ReturnToActiveRequestCommand, Mode=OneWay}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasOtherRequestRunning), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.ActiveRequestBannerText, Mode=OneWay}"
                    AutomationProperties.AutomationId="ActiveRequestBanner" x:Uid="InboxActiveRequestBannerButton" localization:LocalizedResourceKey.Key="InboxActiveRequestBannerButton">
                <TextBlock Text="{x:Bind ViewModel.ActiveRequestBannerText, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </Button>
        </StackPanel>
        <Grid x:Name="BodyGrid" Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
            <Grid x:Name="ConversationPane" RowSpacing="8"
                  Visibility="{x:Bind inbox:ChatInboxPage.ConversationPaneVisibility(ViewModel.IsWideLayout, ViewModel.IsDetailOpen), Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.RowSpan="3" Style="{StaticResource ActivityCardStyle}" Padding="0" IsHitTestVisible="False" />
                <StackPanel Margin="12,12,12,0" Spacing="4">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" x:Uid="InboxConversationsHeading" localization:LocalizedResourceKey.Key="InboxConversationsHeading" />
                    <TextBlock Text="{x:Bind ViewModel.ConversationCountLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="InboxConversationCount" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="12,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="InboxSearchBox" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.AutomationId="InboxSearch" x:Uid="InboxSearch" />
                    <ComboBox Grid.Column="1" SelectedValue="{x:Bind ViewModel.StateFilter, Mode=TwoWay}"
                              SelectedValuePath="Tag" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="InboxStateFilter" x:Uid="InboxStateFilter">
                        <ComboBoxItem Tag="all" x:Uid="InboxFilterAll" localization:LocalizedResourceKey.Key="InboxFilterAll" />
                        <ComboBoxItem Tag="pending" x:Uid="InboxFilterPending" localization:LocalizedResourceKey.Key="InboxFilterPending" />
                        <ComboBoxItem Tag="active" x:Uid="InboxFilterActive" localization:LocalizedResourceKey.Key="InboxFilterActive" />
                        <ComboBoxItem Tag="completed" x:Uid="InboxFilterCompleted" localization:LocalizedResourceKey.Key="InboxFilterCompleted" />
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="2" Margin="4,0,4,4">
                <ListView x:Name="ConversationList" ItemsSource="{x:Bind ViewModel.VisibleConversations, Mode=OneWay}"
                          SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedConversation, Mode=OneWay}"
                          IsItemClickEnabled="True" ItemClick="Conversation_ItemClick" SelectionChanged="Conversation_SelectionChanged" KeyDown="Conversation_KeyDown" AutomationProperties.AutomationId="InboxConversations">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="inbox:InboxConversation">
                            <Grid Padding="8,12" RowSpacing="8" ToolTipService.ToolTip="{x:Bind ListTooltip, Mode=OneWay}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ListTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ActivityCompact, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Text="{x:Bind LatestPrompt, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                           Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(HasSeveralRequests), Mode=OneWay}" />
                                <Grid Grid.Row="3" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <presentation:StatusIcon Tone="{x:Bind StateTone, Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind StateSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind RequestCountLabel, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ScrollViewer x:Name="InboxEmptyListScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                              Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.ShowEmptyConversationList), Mode=OneWay}">
                    <Border Style="{StaticResource ActivityCardStyle}" Padding="20" Margin="12" MaxWidth="460"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="InboxEmptyListCard">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <Viewbox Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                         AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                                    <SymbolIcon Symbol="Message" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Viewbox>
                                <TextBlock Text="{x:Bind ViewModel.EmptyConversationHeading, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                           AutomationProperties.AutomationId="InboxEmptyList" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyConversationDescription, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                           AutomationProperties.AutomationId="InboxEmptyListBody" />
                                <Button Command="{x:Bind ViewModel.ClearConversationFiltersCommand}"
                                        Content="{x:Bind ViewModel.ClearConversationFiltersLabel, Mode=OneWay}"
                                        Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasConversationFilters), Mode=OneWay}"
                                        AutomationProperties.AutomationId="ClearInboxFilters" />
                            </StackPanel>
                    </Border>
                </ScrollViewer>
                </Grid>
            </Grid>
            <Grid x:Name="DetailPane" Grid.Column="1" RowSpacing="8"
                  Visibility="{x:Bind inbox:ChatInboxPage.DetailPaneVisibility(ViewModel.IsWideLayout, ViewModel.IsDetailOpen), Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.RowSpan="3" Style="{StaticResource ActivityCardStyle}" Padding="0" IsHitTestVisible="False" />
                <ScrollViewer Grid.Row="2" x:Name="InboxDetailEmptyScroll" MaxWidth="460" HorizontalAlignment="Center"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                              Visibility="{x:Bind inbox:ChatInboxPage.HiddenWhen(ViewModel.HasSelectedConversation), Mode=OneWay}">
                    <Border Style="{StaticResource ActivityCardStyle}" Padding="20" Margin="12" MaxWidth="460"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            AutomationProperties.AutomationId="InboxDetailEmptyCard">
                            <StackPanel Spacing="12" HorizontalAlignment="Center">
                                <Viewbox Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center"
                                         AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False">
                                    <SymbolIcon Symbol="Message" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Viewbox>
                                <TextBlock Text="{x:Bind ViewModel.EmptyDetailHeading, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                           AutomationProperties.AutomationId="InboxDetailEmpty" />
                                <TextBlock Text="{x:Bind ViewModel.EmptyDetailDescription, Mode=OneWay}"
                                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                                           AutomationProperties.AutomationId="InboxDetailEmptyBody" />
                            </StackPanel>
                    </Border>
                </ScrollViewer>
                <Grid Margin="12,12,12,0" ColumnSpacing="8" Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedConversation), Mode=OneWay}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="InboxBackButton" Click="BackToConversations_Click" Visibility="{x:Bind inbox:ChatInboxPage.BackButtonVisibility(ViewModel.IsWideLayout), Mode=OneWay}"
                                    AutomationProperties.AutomationId="InboxBackToConversations" x:Uid="InboxBackToConversations" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SelectedConversation.ListTitle, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedConversation.Title, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>

                <Grid Grid.Row="1" Margin="12,0" ColumnSpacing="8" RowSpacing="8" Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedConversation), Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button Command="{x:Bind ViewModel.ApproveCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ApproveChat" x:Uid="InboxApprove" localization:LocalizedResourceKey.Key="InboxApprove" />
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.RejectCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RejectChat" x:Uid="InboxReject" localization:LocalizedResourceKey.Key="InboxReject">
                        <Button.Resources><ResourceDictionary Source="ms-appx:///ImpactActionResources.xaml" /></Button.Resources>
                    </Button>
                    <Button Grid.Row="1" Command="{x:Bind ViewModel.CancelCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CancelChat" x:Uid="InboxStop" localization:LocalizedResourceKey.Key="InboxStop">
                        <Button.Resources><ResourceDictionary Source="ms-appx:///ImpactActionResources.xaml" /></Button.Resources>
                    </Button>
                    <Button Grid.Row="1" Grid.Column="1" Command="{x:Bind ViewModel.SendResultCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="SendChatResult" x:Uid="InboxShare" localization:LocalizedResourceKey.Key="InboxShare" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Command="{x:Bind ViewModel.SendAttachmentsCommand}" AutomationProperties.AutomationId="SendChatAttachments" x:Uid="InboxSendAttachments" localization:LocalizedResourceKey.Key="InboxSendAttachments" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedAttachmentStatus, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SelectedAttachmentStatus" />
                    </Grid>
                </Grid>
                <ScrollViewer x:Name="InboxDetailScroll" Grid.Row="2" Margin="12,0,12,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedConversation), Mode=OneWay}">
                    <StackPanel Spacing="12" AutomationProperties.AutomationId="InboxConversationDetail">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <presentation:StatusIcon Tone="{x:Bind ViewModel.Selected.StateTone, Mode=OneWay, FallbackValue='neutral'}" />
                            <TextBlock Text="{x:Bind ViewModel.Selected.StateDisplay, Mode=OneWay, FallbackValue=''}" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="InboxSelectedState" />
                        </StackPanel>
                        <TextBlock x:Name="InboxRequestCountText" Text="{x:Bind ViewModel.SelectedRequestCountLabel, Mode=OneWay}" AutomationProperties.AutomationId="InboxRequestCount" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.ConversationRequests, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" DisplayMemberPath="RequestLabel"
                                  HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{x:Bind InboxRequestCountText}"
                                  AutomationProperties.AutomationId="ChatRequests" x:Uid="InboxRequestPicker" localization:LocalizedResourceKey.Key="InboxRequestPicker" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="InboxPromptLabel" localization:LocalizedResourceKey.Key="InboxPromptLabel" />
                        <TextBox Text="{x:Bind ViewModel.Selected.Prompt, Mode=OneWay, FallbackValue=''}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" MinHeight="80" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="InboxSelectedPrompt" />
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Uid="InboxRequestContext" AutomationProperties.AutomationId="InboxRequestContext">
                            <StackPanel Spacing="8">
                                <TextBlock TextWrapping="Wrap" x:Uid="InboxSameThreadHelp" localization:LocalizedResourceKey.Key="InboxSameThreadHelp" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Source, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" AutomationProperties.AutomationId="InboxSelectedIdentity" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Request.ThreadId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Workspace, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.SessionLabel, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <executionUi:LiveOutputView ViewModel="{x:Bind ViewModel.SelectedLiveOutput, Mode=OneWay}"
                                                    CancelCommand="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                                                    AutomationProperties.AutomationId="ChatLiveOutput" />
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="InboxResultLabel" localization:LocalizedResourceKey.Key="InboxResultLabel" />
                        <TextBox Text="{x:Bind ViewModel.SelectedOutput, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" MinHeight="120" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="ChatOutput" x:Uid="ChatOutput" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedUsage, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   AutomationProperties.AutomationId="ChatUsageSummary" x:Uid="ChatUsageSummary" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
