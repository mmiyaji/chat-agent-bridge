<Page
    x:Class="ChatAgentBridge_Desktop.Inbox.ChatInboxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inbox="using:ChatAgentBridge_Desktop.Inbox"
    SizeChanged="Page_SizeChanged"
    AutomationProperties.AutomationId="ChatScroll">
    <Grid Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" x:Uid="inboxChatInboxPageTextBlock001" />
            <TextBlock TextWrapping="Wrap" x:Uid="inboxChatInboxPageTextBlock002"
                       Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.IsWideLayout), Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.ConnectMattermostCommand}" AutomationProperties.AutomationId="ConnectMattermost" x:Uid="ConnectMattermost" />
                <Button Command="{x:Bind ViewModel.ConnectSlackCommand}" AutomationProperties.AutomationId="ConnectSlack" x:Uid="ConnectSlack" />
                <Button Command="{x:Bind ViewModel.DisconnectCommand}" AutomationProperties.AutomationId="DisconnectChat" x:Uid="DisconnectChat" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="3">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.Status, Mode=OneWay}" AutomationProperties.AutomationId="ChatStatus" />
            <StackPanel Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.IsWideLayout), Mode=OneWay}">
                <TextBlock Text="{x:Bind ViewModel.OverflowNotice, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.NotificationStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="NotificationStatus" />
                <TextBlock Text="{x:Bind ViewModel.ProgressNotice, Mode=OneWay}" TextWrapping="Wrap"
                           Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasProgressNotice), Mode=OneWay}"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ChatProgressNotice" />
            </StackPanel>
            <Expander HorizontalAlignment="Stretch" x:Uid="InboxConnectionDetails" AutomationProperties.AutomationId="InboxConnectionDetails"
                      Visibility="{x:Bind inbox:ChatInboxPage.HiddenWhen(ViewModel.IsWideLayout), Mode=OneWay}">
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.OverflowNotice, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.NotificationStatus, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressNotice, Mode=OneWay}" TextWrapping="Wrap"
                                   Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasProgressNotice), Mode=OneWay}"
                                   AutomationProperties.AutomationId="ChatProgressNoticeCompact" />
                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </StackPanel>
        <Grid x:Name="BodyGrid" Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
            <Grid x:Name="ConversationPane" RowSpacing="8"
                  Visibility="{x:Bind inbox:ChatInboxPage.ConversationPaneVisibility(ViewModel.IsWideLayout, ViewModel.IsDetailOpen), Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" x:Uid="InboxConversationsHeading" />
                    <TextBlock TextWrapping="Wrap" x:Uid="InboxConversationHelp"
                               Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.IsWideLayout), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ConversationCountLabel, Mode=OneWay}" AutomationProperties.AutomationId="InboxConversationCount" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="InboxSearchBox" Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.AutomationId="InboxSearch" x:Uid="InboxSearch" />
                    <ComboBox Grid.Column="1" SelectedValue="{x:Bind ViewModel.StateFilter, Mode=TwoWay}"
                              SelectedValuePath="Tag" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="InboxStateFilter" x:Uid="InboxStateFilter">
                        <ComboBoxItem Tag="all" x:Uid="InboxFilterAll" />
                        <ComboBoxItem Tag="pending" x:Uid="InboxFilterPending" />
                        <ComboBoxItem Tag="active" x:Uid="InboxFilterActive" />
                        <ComboBoxItem Tag="completed" x:Uid="InboxFilterCompleted" />
                    </ComboBox>
                </Grid>
                <Grid Grid.Row="2">
                <ListView x:Name="ConversationList" ItemsSource="{x:Bind ViewModel.VisibleConversations, Mode=OneWay}"
                          SelectionMode="Single" SelectedItem="{x:Bind ViewModel.SelectedConversation, Mode=OneWay}"
                          IsItemClickEnabled="True" ItemClick="Conversation_ItemClick" SelectionChanged="Conversation_SelectionChanged" KeyDown="Conversation_KeyDown" AutomationProperties.AutomationId="InboxConversations">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="inbox:InboxConversation">
                            <Grid Padding="8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Location, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind LatestPrompt, Mode=OneWay}" TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock Text="{x:Bind Activity, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{x:Bind StateSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" MaxWidth="130" />
                                    <TextBlock Text="{x:Bind RequestCountLabel, Mode=OneWay}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="{x:Bind ViewModel.EmptyListMessage, Mode=OneWay}" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center"
                           Visibility="{x:Bind inbox:ChatInboxPage.HiddenWhen(ViewModel.HasVisibleConversations), Mode=OneWay}"
                           AutomationProperties.AutomationId="InboxEmptyList" />
                </Grid>
            </Grid>
            <Grid x:Name="DetailPane" Grid.Column="1" RowSpacing="8"
                  Visibility="{x:Bind inbox:ChatInboxPage.DetailPaneVisibility(ViewModel.IsWideLayout, ViewModel.IsDetailOpen), Mode=OneWay}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{x:Bind ViewModel.SelectedOutput, Mode=OneWay}" TextWrapping="Wrap" Margin="24" Grid.RowSpan="3"
                           Visibility="{x:Bind inbox:ChatInboxPage.HiddenWhen(ViewModel.HasSelectedConversation), Mode=OneWay}" />
                <Grid ColumnSpacing="8" Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedConversation), Mode=OneWay}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="InboxBackButton" Click="BackToConversations_Click" Visibility="{x:Bind inbox:ChatInboxPage.BackButtonVisibility(ViewModel.IsWideLayout), Mode=OneWay}"
                                    AutomationProperties.AutomationId="InboxBackToConversations" x:Uid="InboxBackToConversations" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.SelectedConversation.Title, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="InboxSameThreadHelp" />
                            </StackPanel>
                        </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="8" Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedConversation), Mode=OneWay}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button Command="{x:Bind ViewModel.ApproveCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ApproveChat" x:Uid="InboxApprove" />
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.RejectCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="RejectChat" x:Uid="InboxReject" />
                    <Button Grid.Row="1" Command="{x:Bind ViewModel.CancelCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CancelChat" x:Uid="InboxStop" />
                    <Button Grid.Row="1" Grid.Column="1" Command="{x:Bind ViewModel.SendResultCommand}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="SendChatResult" x:Uid="InboxShare" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button Command="{x:Bind ViewModel.SendAttachmentsCommand}" AutomationProperties.AutomationId="SendChatAttachments" x:Uid="InboxSendAttachments" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedAttachmentStatus, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SelectedAttachmentStatus" />
                    </Grid>
                </Grid>
                <ScrollViewer x:Name="InboxDetailScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{x:Bind inbox:ChatInboxPage.VisibleWhen(ViewModel.HasSelectedConversation), Mode=OneWay}">
                    <StackPanel Spacing="10" AutomationProperties.AutomationId="InboxConversationDetail">
                        <TextBlock x:Name="InboxRequestCountText" Text="{x:Bind ViewModel.SelectedRequestCountLabel, Mode=OneWay}" AutomationProperties.AutomationId="InboxRequestCount" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.ConversationRequests, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" DisplayMemberPath="RequestLabel"
                                  HorizontalAlignment="Stretch" AutomationProperties.LabeledBy="{x:Bind InboxRequestCountText}"
                                  AutomationProperties.AutomationId="ChatRequests" x:Uid="InboxRequestPicker" />
                        <TextBlock x:Uid="InboxPromptLabel" />
                        <TextBox Text="{x:Bind ViewModel.Selected.Prompt, Mode=OneWay, FallbackValue=''}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" MinHeight="80" MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="InboxSelectedPrompt" />
                        <TextBlock x:Uid="InboxContextLabel" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Source, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" AutomationProperties.AutomationId="InboxSelectedIdentity" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Request.ThreadId, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.Workspace, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="{x:Bind ViewModel.Selected.SessionLabel, Mode=OneWay, FallbackValue=''}" TextWrapping="Wrap" />
                        <TextBlock x:Uid="InboxResultLabel" />
                        <TextBox Text="{x:Bind ViewModel.SelectedOutput, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" MinHeight="120" MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.AutomationId="ChatOutput" x:Uid="ChatOutput" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedUsage, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   AutomationProperties.AutomationId="ChatUsageSummary" x:Uid="ChatUsageSummary" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
