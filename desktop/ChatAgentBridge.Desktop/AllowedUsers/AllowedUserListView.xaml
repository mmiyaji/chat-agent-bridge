<UserControl
    x:Class="ChatAgentBridge_Desktop.AllowedUsers.AllowedUserListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ChatAgentBridge_Desktop.ViewModels"
    xmlns:inbox="using:ChatAgentBridge_Desktop.Inbox"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization">
    <StackPanel Spacing="8">
        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind Model.IsEmpty, Mode=OneWay}"
                   x:Uid="AllowedUserListEmpty" localization:LocalizedResourceKey.Key="AllowedUserListEmpty" />
        <Grid ColumnSpacing="8" Visibility="{x:Bind Model.HasRows, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="AllowedUserServiceColumn" localization:LocalizedResourceKey.Key="AllowedUserServiceColumn" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Grid.Column="1" x:Uid="AllowedUserIdentityColumn" localization:LocalizedResourceKey.Key="AllowedUserIdentityColumn" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock Grid.Column="2" x:Uid="AllowedUserActionColumn" localization:LocalizedResourceKey.Key="AllowedUserActionColumn" Style="{StaticResource BodyStrongTextBlockStyle}" />
        </Grid>
        <ItemsControl ItemsSource="{x:Bind Model.VisibleRows, Mode=OneWay}" AutomationProperties.AutomationId="AllowedUserTable">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AllowedUserRow">
                    <Grid ColumnSpacing="8" Padding="0,3" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ServiceName}" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <PersonPicture Width="24" Height="24" VerticalAlignment="Center" DisplayName="{x:Bind PictureName}"
                                           ProfilePicture="{x:Bind inbox:ChatInboxPage.AvatarImage(AvatarPath), Mode=OneWay}"
                                           AutomationProperties.AccessibilityView="Raw" />
                            <HyperlinkButton Grid.Column="1" VerticalAlignment="Center" Padding="0" Click="ShowUserDetails_Click"
                                             AutomationProperties.AutomationId="AllowedUserDetails">
                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                            </HyperlinkButton>
                        </Grid>
                        <Button Grid.Column="2" VerticalAlignment="Center" Click="RemoveUser_Click"
                                AutomationProperties.Name="{x:Bind RemoveLabel}" ToolTipService.ToolTip="{x:Bind RemoveLabel}"
                                AutomationProperties.AutomationId="AllowedUserRemove">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <HyperlinkButton Content="{x:Bind Model.ExpansionLabel, Mode=OneWay}" Command="{x:Bind Model.ToggleExpansionCommand, Mode=OneWay}"
                         Visibility="{x:Bind Model.HasMoreRows, Mode=OneWay}" AutomationProperties.AutomationId="AllowedUserExpansion" />
        <TextBlock Text="{x:Bind Model.Status, Mode=OneWay}" Visibility="{x:Bind Model.HasStatus, Mode=OneWay}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
