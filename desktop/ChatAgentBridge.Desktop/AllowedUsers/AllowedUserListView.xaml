<UserControl
    x:Class="ChatAgentBridge_Desktop.AllowedUsers.AllowedUserListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ChatAgentBridge_Desktop.ViewModels"
    xmlns:inbox="using:ChatAgentBridge_Desktop.Inbox"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization">
    <StackPanel Spacing="8">
        <TextBlock x:Uid="AllowedUserListTitle" localization:LocalizedResourceKey.Key="AllowedUserListTitle" />
        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind Model.IsEmpty, Mode=OneWay}"
                   x:Uid="AllowedUserListEmpty" localization:LocalizedResourceKey.Key="AllowedUserListEmpty" />
        <ItemsControl ItemsSource="{x:Bind Model.Rows, Mode=OneWay}" Visibility="{x:Bind Model.HasRows, Mode=OneWay}"
                      AutomationProperties.AutomationId="{x:Bind ListAutomationId, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AllowedUserRow">
                    <Grid ColumnSpacing="12" Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PersonPicture Width="32" Height="32" VerticalAlignment="Top" DisplayName="{x:Bind PictureName}"
                                       ProfilePicture="{x:Bind inbox:ChatInboxPage.AvatarImage(AvatarPath), Mode=OneWay}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{x:Bind DisplayName}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind IdLine}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind AddedLine}" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind LastRequestLine}" Visibility="{x:Bind HasLastRequest}" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Center" Command="{x:Bind RemoveCommand}"
                                AutomationProperties.Name="{x:Bind RemoveLabel}" ToolTipService.ToolTip="{x:Bind RemoveLabel}"
                                AutomationProperties.AutomationId="AllowedUserRemove">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox Text="{x:Bind Model.NewUserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.AutomationId="{x:Bind AddInputAutomationId, Mode=OneWay}" x:Uid="AllowedUserAddInput" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind Model.AddCommand, Mode=OneWay}"
                    AutomationProperties.AutomationId="{x:Bind AddButtonAutomationId, Mode=OneWay}" x:Uid="AllowedUserAddButton" />
        </Grid>
        <TextBlock Text="{x:Bind Model.Status, Mode=OneWay}" Visibility="{x:Bind Model.HasStatus, Mode=OneWay}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
