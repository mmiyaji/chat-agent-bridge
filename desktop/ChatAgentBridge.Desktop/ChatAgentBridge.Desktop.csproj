<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ChatAgentBridge_Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <DefaultLanguage>en-US</DefaultLanguage>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Capture build time in the assembly so every distribution uses the same embedded source. -->
  <PropertyGroup>
    <CABBuildTimestampUtc Condition="'$(CABBuildTimestampUtc)' == ''">$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))</CABBuildTimestampUtc>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestampUtc</_Parameter1>
      <_Parameter2>$(CABBuildTimestampUtc)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- An explicit portable distribution; the normal MSIX build keeps its package identity. -->
  <PropertyGroup Condition="'$(CABPortable)' == 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <DefineConstants>$(DefineConstants);CAB_PORTABLE</DefineConstants>
    <OutputPath>bin\$(Platform)\$(Configuration)\portable\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\portable\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Store submissions use a Partner Center identity supplied by Create-StorePackage.ps1.
       Keep this opt-in and reject combinations with every portable/test-only build switch. -->
  <PropertyGroup Condition="'$(CABStore)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <OutputPath>bin\$(Platform)\$(Configuration)\store\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\store\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(CABStore)' == 'true'">
    <AppxManifest Include="$(CABStoreManifest)" />
  </ItemGroup>

  <Target Name="ValidateCabStoreBuild" BeforeTargets="PrepareForBuild" Condition="'$(CABStore)' == 'true'">
    <Error Condition="'$(CABPortable)' == 'true' or '$(CABPortableIdentity)' == 'true' or '$(CABPortableUpdateTest)' == 'true' or '$(CABDiscordFixture)' == 'true'"
           Text="CABStore cannot be combined with portable, portable identity/update-test, or fixture build switches." />
    <Error Condition="'$(CABStoreManifest)' == '' or !Exists('$(CABStoreManifest)')"
           Text="CABStore requires CABStoreManifest pointing to the manifest generated by Create-StorePackage.ps1." />
    <Error Condition="'$(CABStorePackageName)' != 'mmiyaji.ChatAgentBridge'"
           Text="CABStorePackageName must be mmiyaji.ChatAgentBridge." />
    <Error Condition="'$(CABStorePublisher)' == '' or '$(CABStorePublisherDisplayName)' == ''"
           Text="CABStore requires the Publisher and PublisherDisplayName confirmed in Partner Center." />
    <Error Condition="'$(CABStorePackageVersion)' == ''"
           Text="CABStore requires CABStorePackageVersion in four-part numeric form." />
    <XmlPeek XmlInputPath="$(CABStoreManifest)" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Name">
      <Output TaskParameter="Result" PropertyName="_CABStoreManifestName" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(CABStoreManifest)" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Publisher">
      <Output TaskParameter="Result" PropertyName="_CABStoreManifestPublisher" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(CABStoreManifest)" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="_CABStoreManifestVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(CABStoreManifest)" Query="/*[local-name()='Package']/*[local-name()='Properties']/*[local-name()='PublisherDisplayName']/text()">
      <Output TaskParameter="Result" PropertyName="_CABStoreManifestPublisherDisplayName" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(CABStoreManifest)" Query="/*[local-name()='Package']/*[local-name()='Properties']/*[local-name()='DisplayName']/text()">
      <Output TaskParameter="Result" PropertyName="_CABStoreManifestDisplayName" />
    </XmlPeek>
    <Error Condition="'$(_CABStoreManifestName)' != '$(CABStorePackageName)' or '$(_CABStoreManifestPublisher)' != '$(CABStorePublisher)' or '$(_CABStoreManifestVersion)' != '$(CABStorePackageVersion)' or '$(_CABStoreManifestPublisherDisplayName)' != '$(CABStorePublisherDisplayName)' or '$(_CABStoreManifestDisplayName)' != 'Chat Agent Bridge'"
           Text="CABStore manifest identity and version must match the values supplied to the build." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(CABStorePackageVersion)', '^(?:[1-9]|[1-9]\d{1,3}|[1-5]\d{4}|6[0-4]\d{3}|65[0-4]\d{2}|655[0-2]\d|6553[0-5])\.(?:0|[1-9]\d{0,3}|[1-5]\d{4}|6[0-4]\d{3}|65[0-4]\d{2}|655[0-2]\d|6553[0-5])\.(?:0|[1-9]\d{0,3}|[1-5]\d{4}|6[0-4]\d{3}|65[0-4]\d{2}|655[0-2]\d|6553[0-5])\.0$'))"
           Text="CABStorePackageVersion must use Store format major.minor.build.0, with a nonzero major and values up to 65535 (for example 1.2.3.0)." />
  </Target>

  <!-- Native Discord fixture hooks never enter ordinary portable distributions. -->
  <PropertyGroup Condition="'$(CABDiscordFixture)' == 'true' and '$(CABPortable)' == 'true'">
    <DefineConstants>$(DefineConstants);CAB_DISCORD_FIXTURE</DefineConstants>
    <OutputPath>bin\$(Platform)\$(Configuration)\portable-discord-fixture\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\portable-discord-fixture\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Identity is additive. Ordinary portable builds retain their original notification registration. -->
  <PropertyGroup Condition="'$(CABPortable)' == 'true' and '$(CABPortableIdentity)' == 'true'">
    <ApplicationManifest>../portable-identity/app.portable.manifest</ApplicationManifest>
    <OutputPath>bin\$(Platform)\$(Configuration)\portable-identity\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\portable-identity\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CABPortableUpdateTest)' == 'true' and '$(CABPortable)' == 'true'">
    <DefineConstants>$(DefineConstants);CAB_PORTABLE_UPDATE_TEST</DefineConstants>
    <OutputPath>bin\$(Platform)\$(Configuration)\portable-update-test\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\portable-update-test\</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CABPortableUpdateTest)' == 'true' and '$(CABPortable)' == 'true' and '$(CABPortableIdentity)' == 'true'">
    <OutputPath>bin\$(Platform)\$(Configuration)\portable-identity-update-test\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\portable-identity-update-test\</IntermediateOutputPath>
  </PropertyGroup>

  <UsingTask TaskName="ExtractPortableAppNotificationResource" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll" Condition="'$(CABPortable)' == 'true'">
    <ParameterGroup>
      <ArchivePath ParameterType="System.String" Required="true" />
      <DestinationFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (var archive = new ZipArchive(File.OpenRead(ArchivePath), ZipArchiveMode.Read))
        {
            var entry = archive.GetEntry("Microsoft.WindowsAppRuntime.Insights.Resource.dll");
            if (entry == null)
            {
                Log.LogError("The Windows App SDK runtime archive does not contain Microsoft.WindowsAppRuntime.Insights.Resource.dll.");
            }
            else
            {
                Directory.CreateDirectory(Path.GetDirectoryName(DestinationFile));
                using (var source = entry.Open())
                using (var destination = File.Create(DestinationFile))
                    source.CopyTo(destination);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup Condition="'$(CABPortable)' == 'true'">
    <_PortableWindowsAppSDKArchitecture Condition="'$(Platform)' == 'x64' or '$(RuntimeIdentifier)' == 'win-x64'">x64</_PortableWindowsAppSDKArchitecture>
    <_PortableWindowsAppSDKArchitecture Condition="'$(Platform)' == 'ARM64' or '$(RuntimeIdentifier)' == 'win-arm64'">arm64</_PortableWindowsAppSDKArchitecture>
    <_PortableWindowsAppSDKRuntimeArchive>$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-$(_PortableWindowsAppSDKArchitecture)\Microsoft.WindowsAppRuntime.2.msix</_PortableWindowsAppSDKRuntimeArchive>
    <_PortableAppNotificationResource>$(IntermediateOutputPath)portable-deps\Microsoft.WindowsAppRuntime.Insights.Resource.dll</_PortableAppNotificationResource>
  </PropertyGroup>

  <ItemGroup Condition="'$(CABPortable)' == 'true'">
    <Content Include="$(_PortableAppNotificationResource)"
             Link="Microsoft.WindowsAppRuntime.Insights.Resource.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ExtractPortableAppNotificationResource"
          BeforeTargets="GetCopyToOutputDirectoryItems"
          Condition="'$(CABPortable)' == 'true'">
    <Error Condition="'$(_PortableWindowsAppSDKArchitecture)' == ''"
           Text="CABPortable requires RuntimeIdentifier win-x64 or win-arm64 (or Platform x64 or ARM64)." />
    <Error Condition="!Exists('$(_PortableWindowsAppSDKRuntimeArchive)')"
           Text="The Windows App SDK Runtime MSIX was not found at '$(_PortableWindowsAppSDKRuntimeArchive)'. Restore Microsoft.WindowsAppSDK.Runtime for this project before publishing portable." />
    <ExtractPortableAppNotificationResource ArchivePath="$(_PortableWindowsAppSDKRuntimeArchive)"
                                             DestinationFile="$(_PortableAppNotificationResource)" />
  </Target>

  <ItemGroup>
    <Content Include="Assets\OverviewArchitecture.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\OverviewArchitecture.en.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\OverviewArchitecture.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\OverviewArchitecture.en.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Icons\FluentSystemIcons\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Icons\MaterialSymbols\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Licenses\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Update="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChatAgentBridge.Core\ChatAgentBridge.Core.csproj" />
    <ProjectReference Include="..\ChatAgentBridge.Transports\ChatAgentBridge.Transports.csproj" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- Component packages instead of the Microsoft.WindowsAppSDK metapackage, which also pulls in unused AI/ML/Search/Widgets binaries. -->
    <!-- CommunityToolkit pulls the 1.6 metapackage transitively; take none of its assets so only the component packages below apply. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.7.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
  </PropertyGroup>
</Project>
