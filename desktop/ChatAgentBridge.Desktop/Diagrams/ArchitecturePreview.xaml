<UserControl
    x:Class="ChatAgentBridge_Desktop.Diagrams.ArchitecturePreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.AccessibilityView="Control">
    <Button x:Name="OpenButton"
            Padding="12"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Click="OpenButton_Click"
            AutomationProperties.AutomationId="OpenArchitectureViewer">
        <StackPanel Spacing="12" HorizontalAlignment="Stretch">
            <Border Padding="8" CornerRadius="{ThemeResource ControlCornerRadius}"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Image x:Name="DiagramImage" Stretch="Uniform" MaxHeight="{x:Bind MaxPreviewHeight, Mode=OneWay}"
                       AutomationProperties.AccessibilityView="Raw" />
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE8A7;" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="OpenHint" Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Button>
</UserControl>
