<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ChatAgentBridge_Desktop.AgentSettings.AgentProfileEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:agentSettings="using:ChatAgentBridge_Desktop.AgentSettings"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization"
    mc:Ignorable="d">
    <Grid x:Name="EditorLayout" HorizontalAlignment="Stretch" RowSpacing="0" SizeChanged="EditorLayout_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Editor.AgentProviderDisplayName, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="10"
                        Padding="10,3" VerticalAlignment="Center"
                        Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(IsActiveProvider), Mode=OneWay}">
                        <TextBlock x:Uid="AgentProfileInUse" localization:LocalizedResourceKey.Key="AgentProfileInUse"
                                   Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                </StackPanel>
                <Grid ColumnSpacing="8" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE73E;" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                              Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.CliCheckSucceeded), Mode=OneWay}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind CheckStatusLabel, Mode=OneWay}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="AgentEditorStatus" />
                    <TextBlock Grid.Column="2" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Editor.CliVersion, Mode=OneWay}" Text="{x:Bind Editor.CliVersion, Mode=OneWay}" Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.CliCheckSucceeded), Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,1"
                    Padding="0,12" Margin="0,0,0,14">
                <Grid x:Name="WorkspaceGrid" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="WorkspaceLabel" Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Uid="AgentEditorWorkspaceHeader" localization:LocalizedResourceKey.Key="AgentEditorWorkspaceHeader" />
                        <TextBlock x:Uid="AgentEditorWorkspaceDescription" localization:LocalizedResourceKey.Key="AgentEditorWorkspaceDescription"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="WorkspaceValue" Grid.Column="1" Text="{x:Bind Editor.WorkspaceRoot, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" AutomationProperties.AutomationId="AgentEditorWorkspaceValue" />
                    <Button x:Name="OpenCommonSettingsButton" Grid.Column="2" x:Uid="AgentEditorOpenCommonSettings" localization:LocalizedResourceKey.Key="AgentEditorOpenCommonSettings"
                            AutomationProperties.AutomationId="OpenCommonSettings"
                            Click="OpenCommonSettings_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Spacing="16" Margin="0,0,0,14">
                <StackPanel Spacing="5">
                    <TextBlock x:Uid="AgentEditorExecutionHeading" localization:LocalizedResourceKey.Key="AgentEditorExecutionHeading"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Uid="AgentEditorExecutionDescription" localization:LocalizedResourceKey.Key="AgentEditorExecutionDescription"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>

                <Grid x:Name="ExecutableGrid" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ExecutableLabel" x:Uid="AgentEditorExecutableLabel" localization:LocalizedResourceKey.Key="AgentEditorExecutableLabel" VerticalAlignment="Center" />
                    <TextBox x:Name="ExecutableInput" Grid.Column="1" x:Uid="AgentEditorExecutable" localization:LocalizedResourceKey.Key="AgentEditorExecutable"
                             Text="{x:Bind Editor.AgentExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AgentExecutable"
                             GotFocus="DraftField_GotFocus" LostFocus="DraftField_LostFocus" />
                    <Button x:Name="BrowseAgentExecutableButton" Grid.Column="2" x:Uid="BrowseAgentExecutable" localization:LocalizedResourceKey.Key="BrowseAgentExecutable"
                            AutomationProperties.AutomationId="BrowseAgentExecutable" Click="BrowseAgentExecutable_Click" />
                </Grid>

                <StackPanel x:Name="CheckCliActions" Orientation="Vertical" Spacing="10" Margin="200,0,0,0">
                    <Button x:Uid="CheckCli" localization:LocalizedResourceKey.Key="CheckCli" HorizontalAlignment="Left" AutomationProperties.AutomationId="CheckCli"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind CanRunCliCheck, Mode=OneWay}" Click="CheckCli_Click" />
                    <Button AutomationProperties.AutomationId="CancelAgentCliCheck" x:Uid="CancelAgentCliCheck" localization:LocalizedResourceKey.Key="CancelAgentCliCheck"
                            Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.IsCheckingCli), Mode=OneWay}"
                            Command="{x:Bind Editor.CancelCliCheckCommand}" />
                    <ProgressRing IsActive="{x:Bind Editor.IsCheckingCli, Mode=OneWay}" Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.IsCheckingCli), Mode=OneWay}" Width="18" Height="18" />
                    <TextBlock Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.SupportsReasoning), Mode=OneWay}" x:Uid="AgentEditorCliCheckHint" localization:LocalizedResourceKey.Key="AgentEditorCliCheckHint"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <InfoBar x:Name="CliErrorInfoBar" IsOpen="{x:Bind Editor.CliCheckFailed, Mode=OneWay}" IsClosable="False"
                         Severity="Error" Message="{x:Bind Editor.CliCheckSummary, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="RetryCliCheck" localization:LocalizedResourceKey.Key="RetryCliCheck"
                                AutomationProperties.AutomationId="RetryCliCheck" Click="CheckCli_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <Grid x:Name="ModelGrid" ColumnSpacing="10" AutomationProperties.AutomationId="AgentEditorModelSettings"
                      Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.SupportsModel), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModelLabel" x:Uid="AgentEditorModelLabel" localization:LocalizedResourceKey.Key="AgentEditorModelLabel" VerticalAlignment="Center" />
                    <TextBox x:Name="AgentModelControl" Grid.Column="1" x:Uid="AgentEditorModel" localization:LocalizedResourceKey.Key="AgentEditorModel"
                             Text="{x:Bind Editor.AgentModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="AgentModel" GotFocus="DraftField_GotFocus" LostFocus="DraftField_LostFocus" />
                    <Button x:Name="FetchModelsButton" Grid.Column="2" x:Uid="FetchModels" localization:LocalizedResourceKey.Key="FetchModels"
                            Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.SupportsModelCatalog), Mode=OneWay}" AutomationProperties.AutomationId="FetchModels" IsEnabled="{x:Bind Editor.CanFetchModelCandidates, Mode=OneWay}"
                            Command="{x:Bind Editor.ModelCatalog.FetchModelsCommand}" />
                </Grid>

                <ComboBox ItemsSource="{x:Bind Editor.ModelCatalog.Models, Mode=OneWay}" DisplayMemberPath="SelectionLabel"
                          SelectedItem="{x:Bind Editor.ModelCatalog.SelectedModel, Mode=TwoWay}"
                          HorizontalAlignment="Stretch" AutomationProperties.AutomationId="ModelCandidates"
                          localization:LocalizedResourceKey.Key="AgentEditorModelChoices"
                          Visibility="{x:Bind agentSettings:AgentProfileEditorControl.CountVisibility(Editor.ModelCatalog.Models.Count), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Editor.ModelCatalog.Status, Mode=OneWay}" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="ModelCatalogStatus"
                           Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.SupportsModelCatalog), Mode=OneWay}" />
                <TextBlock Text="{x:Bind Editor.BasicProviderHelp, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.IsBasicProvider), Mode=OneWay}" />
                <Grid x:Name="ReasoningGrid" ColumnSpacing="10" Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.SupportsReasoning), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ReasoningLabel" x:Uid="AgentEditorReasoningLabel" localization:LocalizedResourceKey.Key="AgentEditorReasoningLabel" VerticalAlignment="Center" />
                    <ComboBox localization:LocalizedResourceKey.Key="AgentEditorReasoning" HorizontalAlignment="Stretch" x:Name="ReasoningCombo" Grid.Column="1" ItemsSource="{x:Bind Editor.ReasoningEffortCandidates, Mode=OneWay}"
                              SelectedItem="{x:Bind Editor.SelectedReasoningEffort, Mode=TwoWay}" DisplayMemberPath="SelectionLabel"
                              AutomationProperties.AutomationId="ReasoningEffortCandidates" SelectionChanged="DraftSelection_Changed" />
                </Grid>

                <Grid x:Name="PermissionGrid" ColumnSpacing="10" Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.CanConfigureAgentPermission), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PermissionLabel" x:Uid="AgentEditorPermissionLabel" localization:LocalizedResourceKey.Key="AgentEditorPermissionLabel" VerticalAlignment="Center" />
                    <ComboBox localization:LocalizedResourceKey.Key="AgentEditorPermission" HorizontalAlignment="Stretch" x:Name="PermissionCombo" Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{x:Bind Editor.AgentPermissionMode, Mode=TwoWay}"
                              AutomationProperties.AutomationId="AgentPermissionMode" SelectionChanged="DraftSelection_Changed">
                        <ComboBoxItem x:Uid="PermissionInherit" Tag="inherit" localization:LocalizedResourceKey.Key="PermissionInherit" />
                        <ComboBoxItem x:Uid="PermissionReadOnly" Tag="read-only" localization:LocalizedResourceKey.Key="PermissionReadOnly"
                                      Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.CanSelectReadOnlyPermission), Mode=OneWay}" />
                        <ComboBoxItem x:Uid="PermissionWorkspaceWrite" Tag="workspace-write" localization:LocalizedResourceKey.Key="PermissionWorkspaceWrite" />
                        <ComboBoxItem x:Uid="PermissionAsk" Tag="ask" localization:LocalizedResourceKey.Key="PermissionAsk"
                                      Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.UseAppServer), Mode=OneWay}" />
                        <ComboBoxItem x:Uid="PermissionFullAccess" Tag="full-access" localization:LocalizedResourceKey.Key="PermissionFullAccess" />
                    </ComboBox>
                </Grid>

                <TextBlock Text="{x:Bind Editor.AgentPermissionStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Visibility="{x:Bind agentSettings:AgentProfileEditorControl.StringToVisibility(Editor.AgentPermissionStatus), Mode=OneWay}" />
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="12" Margin="0,0,0,14">
                <Expander x:Name="AdvancedExpander" AutomationProperties.AutomationId="AgentProfileDetails" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <StackPanel Spacing="3">
                            <TextBlock x:Uid="AgentProfileDetails" localization:LocalizedResourceKey.Key="AgentProfileDetails" />
                            <TextBlock x:Uid="AgentProfileDetailsSummary" localization:LocalizedResourceKey.Key="AgentProfileDetailsSummary"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Spacing="14" Margin="0,14,0,0">
                        <ToggleSwitch x:Uid="UseAppServer" localization:LocalizedResourceKey.Key="UseAppServer"
                                      Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.IsCodexProvider), Mode=OneWay}"
                                      IsOn="{x:Bind Editor.UseAppServer, Mode=TwoWay}" AutomationProperties.AutomationId="UseAppServer"
                                      Toggled="DraftSelection_Changed" />
                        <ToggleSwitch x:Uid="AllowAgentNetwork" localization:LocalizedResourceKey.Key="AllowAgentNetwork"
                                      IsOn="{x:Bind Editor.AllowAgentNetwork, Mode=TwoWay}" AutomationProperties.AutomationId="AllowAgentNetwork"
                                      Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(Editor.IsCodexProvider), Mode=OneWay}"
                                      IsEnabled="{x:Bind Editor.CanConfigureAgentNetwork, Mode=OneWay}" Toggled="DraftSelection_Changed" />
                        <Grid x:Name="ArgumentsGrid" ColumnSpacing="10" Visibility="{x:Bind ArgumentsVisibility, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ArgumentsLabel" x:Uid="AgentEditorArgumentsLabel" localization:LocalizedResourceKey.Key="AgentEditorArgumentsLabel" VerticalAlignment="Top" Margin="0,8,0,0" />
                            <TextBox x:Name="ArgumentsInput" Grid.Column="1" Text="{x:Bind Editor.AgentArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" AutomationProperties.AutomationId="AgentArguments"
                                     GotFocus="DraftField_GotFocus" LostFocus="DraftField_LostFocus" />
                        </Grid>
                        <StackPanel Spacing="3">
                            <Button x:Uid="ReloadProcessEnvironment" localization:LocalizedResourceKey.Key="ReloadProcessEnvironment"
                                    AutomationProperties.AutomationId="ReloadProcessEnvironment" IsEnabled="{x:Bind CanChangeSelection, Mode=OneWay}" Click="ReloadProcessEnvironment_Click" />
                            <TextBlock x:Uid="ReloadProcessEnvironmentHelp" localization:LocalizedResourceKey.Key="ReloadProcessEnvironmentHelp"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <TextBlock Text="{x:Bind PendingChangesLabel, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{x:Bind agentSettings:AgentProfileEditorControl.BoolToVisibility(HasUnappliedChanges), Mode=OneWay}" />
                <InfoBar IsOpen="{x:Bind ShowDraftSaveError, Mode=OneWay}" IsClosable="False" Severity="Error"
                         Message="{x:Bind Editor.StatusMessage, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button x:Uid="RetryAgentDraftSave" localization:LocalizedResourceKey.Key="RetryAgentDraftSave"
                                AutomationProperties.AutomationId="RetryDraftSave" Click="RetryDraftSave_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Uid="UseAgentProfile" localization:LocalizedResourceKey.Key="UseAgentProfile" AutomationProperties.AutomationId="UseAgentProfile"
                        Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind CanUseAgentProfile, Mode=OneWay}" Click="UseAgentProfile_Click" />
            </StackPanel>
    </Grid>
</UserControl>
