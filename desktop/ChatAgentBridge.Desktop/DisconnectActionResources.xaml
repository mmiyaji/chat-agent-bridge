<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ButtonBackground" Color="#FFF3DCDF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFEAD0D5" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFE7C9CE" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFC97F8A" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFB95265" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFB95265" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FF8A2031" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF8A2031" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF8A2031" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ButtonBackground" Color="#FF514345" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF59464B" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF5D4A4F" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF925563" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFBB7584" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFBB7584" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFB9C5" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFB9C5" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFB9C5" />
        </ResourceDictionary>
        <!-- An empty local contrast dictionary leaves native system button colors, focus and disabled states in control. -->
        <ResourceDictionary x:Key="HighContrast" />
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
