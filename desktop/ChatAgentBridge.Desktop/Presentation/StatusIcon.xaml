<UserControl
    x:Class="ChatAgentBridge_Desktop.Presentation.StatusIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChatAgentBridge_Desktop.Presentation"
    IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
    <Border Width="24" Height="24" CornerRadius="{ThemeResource ControlCornerRadius}"
            Background="{ThemeResource ControlFillColorSecondaryBrush}">
        <Grid>
            <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource OverviewAttentionIconBrush}"
                      Visibility="{x:Bind local:StatusIcon.Show(Tone, 'pending'), Mode=OneWay}" />
            <FontIcon Glyph="&#xE895;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      Visibility="{x:Bind local:StatusIcon.Show(Tone, 'running'), Mode=OneWay}" />
            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource OverviewReadyIconBrush}"
                      Visibility="{x:Bind local:StatusIcon.Show(Tone, 'success'), Mode=OneWay}" />
            <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource OverviewErrorIconBrush}"
                      Visibility="{x:Bind local:StatusIcon.Show(Tone, 'error'), Mode=OneWay}" />
            <FontIcon Glyph="&#xE8F2;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Visibility="{x:Bind local:StatusIcon.Show(Tone, 'neutral'), Mode=OneWay}" />
            <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                      Visibility="{x:Bind local:StatusIcon.Show(Tone, 'stopped'), Mode=OneWay}" />
            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource OverviewAttentionIconBrush}"
                      Visibility="{x:Bind local:StatusIcon.Show(Tone, 'warning'), Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
