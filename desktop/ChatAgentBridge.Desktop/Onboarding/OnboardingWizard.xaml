<UserControl
    x:Class="ChatAgentBridge_Desktop.Onboarding.OnboardingWizard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChatAgentBridge_Desktop.Onboarding">
    <Grid Padding="24" RowSpacing="16" MaxWidth="880" HorizontalAlignment="Stretch"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnSpacing="16" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.OnboardingTitle, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="OnboardingTitle" />
                <TextBlock Text="{x:Bind ViewModel.OnboardingDescription, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"  Command="{x:Bind ViewModel.DeferOnboardingCommand}" VerticalAlignment="Top" AutomationProperties.AutomationId="OnboardingDefer"  x:Uid="OnboardingDefer" />
        </Grid>

        <ScrollViewer x:Name="WizardScrollViewer" AutomationProperties.AutomationId="WizardScroll" Grid.Row="1" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" HorizontalAlignment="Stretch" Margin="8,0,0,0">
                <InfoBar AutomationProperties.AutomationId="WizardStatus" IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=TwoWay}"
                         Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         Severity="{x:Bind local:OnboardingWizard.ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}"
                         IsClosable="True" />
                <ContentControl x:Name="IntroHost" HorizontalContentAlignment="Stretch" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardIntro), Mode=OneWay}" />

                <StackPanel Spacing="16" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardAgentStep), Mode=OneWay}">
                    <TextBlock  Style="{StaticResource SubtitleTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock001" x:Uid="onboardingOnboardingWizardTextBlock001" />
                    <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock002" x:Uid="onboardingOnboardingWizardTextBlock002" />
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkspaceRootBox"
                                 Text="{x:Bind ViewModel.WorkspaceRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AutomationProperties.AutomationId="WizardWorkspaceRoot"  x:Uid="WizardWorkspaceRoot" />
                        <Button Grid.Column="1"  Click="PickWorkspaceFolder_Click" VerticalAlignment="Bottom" AutomationProperties.AutomationId="WizardPickWorkspaceFolder"  x:Uid="WizardPickWorkspaceFolder" />
                    </Grid>
                    <InfoBar x:Uid="WorkspaceTrustError" Severity="Warning" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.HasCliTrustRecovery, Mode=OneWay}"
                             Message="{x:Bind ViewModel.CliCheckSummary, Mode=OneWay}"
                             AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="WizardWorkspaceTrustError">
                        <InfoBar.ActionButton>
                            <Button x:Uid="CliReviewTrust" Click="ReviewCliTrust_Click" AutomationProperties.AutomationId="WizardWorkspaceReviewTrust" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <ComboBox x:Name="AgentProviderCombo"  SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.AgentProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WizardAgentProvider" x:Uid="WizardAgentProvider">
                        <ComboBoxItem Content="Codex" Tag="codex" />
                        <ComboBoxItem Content="Claude Code" Tag="claude" />
                        <ComboBoxItem Content="Gemini CLI" Tag="gemini" />
                        <ComboBoxItem Content="GitHub Copilot CLI" Tag="github-copilot" />
                        <ComboBoxItem Tag="custom" AutomationProperties.AutomationId="WizardCustomCli" x:Uid="WizardCustomCli" />
                    </ComboBox>
                    <TextBlock Text="{x:Bind ViewModel.BasicProviderHelp, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsBasicProvider), Mode=OneWay}" AutomationProperties.AutomationId="WizardBasicProviderHelp" />
                    <TextBox x:Name="AgentExecutableBox" Text="{x:Bind ViewModel.AgentExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="WizardAgentExecutable" x:Uid="WizardAgentExecutable" />
                    <Button Click="BrowseAgentExecutable_Click" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardBrowseAgentExecutable" x:Uid="WizardBrowseAgentExecutable" />
                    <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="WizardBrowseAgentExecutableHelp" x:Uid="WizardBrowseAgentExecutableHelp" />
                    <TextBox Text="{x:Bind ViewModel.AgentArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsArgumentsEditable), Mode=OneWay}" TextWrapping="Wrap" AcceptsReturn="False" AutomationProperties.AutomationId="WizardAgentArguments" x:Uid="WizardAgentArguments" />
                    <ToggleSwitch
                                  IsOn="{x:Bind ViewModel.UseAppServer, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.IsCodexProvider, Mode=OneWay}"
                                  AutomationProperties.AutomationId="WizardUseAppServer"  x:Uid="WizardUseAppServer" />
                    <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock003" x:Uid="onboardingOnboardingWizardTextBlock003" />
                </StackPanel>

                <StackPanel Spacing="16" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardCliStep), Mode=OneWay}">
                    <TextBlock  Style="{StaticResource SubtitleTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock004" x:Uid="onboardingOnboardingWizardTextBlock004" />
                    <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock005" x:Uid="onboardingOnboardingWizardTextBlock005" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                        <Button x:Name="CheckCliButton"  Command="{x:Bind ViewModel.CheckCliCommand, Mode=OneWay}" IsEnabled="{x:Bind local:OnboardingWizard.Not(ViewModel.IsCheckingCli), Mode=OneWay}" AutomationProperties.AutomationId="CheckCli"  x:Uid="CheckCli" />
                        <Button  Command="{x:Bind ViewModel.CancelCliCheckCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.IsCheckingCli, Mode=OneWay}" AutomationProperties.AutomationId="CancelCliCheck"  x:Uid="CancelCliCheck" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingCli, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                    </StackPanel>
                    <InfoBar x:Uid="CliCheckError" Severity="Error" IsClosable="False"
                             IsOpen="{x:Bind ViewModel.CliCheckFailed, Mode=OneWay}"
                             Message="{x:Bind ViewModel.CliCheckSummary, Mode=OneWay}"
                             AutomationProperties.Name="{x:Bind ViewModel.CliCheckSummary, Mode=OneWay}"
                             AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="WizardCliCheckError">
                        <InfoBar.ActionButton>
                            <Button x:Uid="CliReviewTrust" Click="ReviewCliTrust_Click"
                                    Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.HasCliTrustRecovery), Mode=OneWay}"
                                    AutomationProperties.AutomationId="WizardCliReviewTrust" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <StackPanel Spacing="8">
                        <Button Click="ReloadProcessEnvironment_Click" IsEnabled="{x:Bind local:OnboardingWizard.EnvironmentReloadAllowed(ViewModel.IsLoading, ViewModel.IsRunning, ViewModel.IsCheckingCli, ViewModel.ModelCatalog.IsLoading, ViewModel.IsOnboardingBusy, Inbox.IsExecuting, ViewModel.SaveSettingsCommand.IsRunning), Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardReloadProcessEnvironment" x:Uid="WizardReloadProcessEnvironment" />
                        <TextBlock TextWrapping="Wrap" AutomationProperties.AutomationId="WizardReloadProcessEnvironmentHelp" x:Uid="WizardReloadProcessEnvironmentHelp" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.CliCheckSummary, Mode=OneWay}" TextWrapping="Wrap"
                               Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.ShowCliCheckSummary), Mode=OneWay}" AutomationProperties.AutomationId="CliCheckSummary" />
                    <TextBlock  Style="{StaticResource BodyStrongTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock006" x:Uid="onboardingOnboardingWizardTextBlock006" />
                    <TextBlock Text="{x:Bind ViewModel.CliVersion, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="CliVersion" />
                    <TextBlock  Style="{StaticResource BodyStrongTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock007" x:Uid="onboardingOnboardingWizardTextBlock007" />
                    <TextBlock Text="{x:Bind ViewModel.CliExecutablePath, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="CliExecutablePath" />
                    <TextBlock Text="{x:Bind ViewModel.BasicProviderHelp, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsBasicProvider), Mode=OneWay}" />
                    <StackPanel Spacing="8" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.SupportsModel), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.ModelCatalog.Status, Mode=OneWay}" TextWrapping="Wrap" />
                        <ComboBox   ItemsSource="{x:Bind ViewModel.ModelCatalog.Models, Mode=OneWay}" DisplayMemberPath="SelectionLabel" SelectedItem="{x:Bind ViewModel.ModelCatalog.SelectedModel, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SupportsReasoning, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WizardModelCandidates"  x:Uid="WizardModelCandidates" />
                        <TextBox  MaxLength="256" Text="{x:Bind ViewModel.AgentModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.SupportsModel, Mode=OneWay}" AutomationProperties.AutomationId="WizardOptionalModel"  x:Uid="WizardOptionalModel" />
                        <ComboBox  ItemsSource="{x:Bind ViewModel.ReasoningEffortCandidates, Mode=OneWay}" DisplayMemberPath="SelectionLabel" SelectedItem="{x:Bind ViewModel.SelectedReasoningEffort, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.SupportsReasoning, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WizardReasoningEffort"  x:Uid="WizardReasoningEffort" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.SupportsReasoning), Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.ModelEffortStatus, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.SupportsReasoning), Mode=OneWay}" />
                        <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock008" x:Uid="onboardingOnboardingWizardTextBlock008" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="16" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardChatStep), Mode=OneWay}">
                    <TextBlock  Style="{StaticResource SubtitleTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock009" x:Uid="onboardingOnboardingWizardTextBlock009" />
                    <ComboBox  SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.OnboardingChatProvider, Mode=TwoWay}" IsEnabled="{x:Bind local:OnboardingWizard.Not(Inbox.IsExecuting), Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WizardChatProvider" x:Uid="WizardChatProvider">
                        <ComboBoxItem Content="Slack" Tag="slack" />
                        <ComboBoxItem Content="Mattermost" Tag="mattermost" />
                        <ComboBoxItem Content="Discord" Tag="discord" x:Uid="WizardProviderDiscord" />
                    </ComboBox>
                    <StackPanel Spacing="12" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardSlack), Mode=OneWay}">
                        <TextBlock  Style="{StaticResource BodyStrongTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock010" x:Uid="onboardingOnboardingWizardTextBlock010" />
                        <StackPanel Spacing="8">
                            <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock011" x:Uid="onboardingOnboardingWizardTextBlock011" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><PasswordBox x:Name="SlackBotTokenBox" Grid.ColumnSpan="2" Padding="12,5,44,6" PasswordChanged="SlackBotTokenBox_PasswordChanged"  AutomationProperties.AutomationId="WizardSlackBotToken"  x:Uid="WizardSlackBotToken" /><ToggleButton x:Name="SlackBotTokenRevealButton" Grid.Column="1" Width="36" Height="36" Padding="0" AutomationProperties.AutomationId="WizardSlackBotTokenReveal" /></Grid>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock012" x:Uid="onboardingOnboardingWizardTextBlock012" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><PasswordBox x:Name="SlackAppTokenBox" Grid.ColumnSpan="2" Padding="12,5,44,6" PasswordChanged="SlackAppTokenBox_PasswordChanged"  AutomationProperties.AutomationId="WizardSlackAppToken"  x:Uid="WizardSlackAppToken" /><ToggleButton x:Name="SlackAppTokenRevealButton" Grid.Column="1" Width="36" Height="36" Padding="0" AutomationProperties.AutomationId="WizardSlackAppTokenReveal" /></Grid>
                        </StackPanel>
                        <StackPanel Spacing="8" AutomationProperties.AutomationId="WizardSlackUsernameLookup">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="WizardSlackUsernameLookupLabel" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="SlackUsernameLookupHelp" />
                            <TextBox Text="{x:Bind ViewModel.SlackUsernameLookupInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="256" AutomationProperties.AutomationId="WizardSlackUsernameLookupInput" x:Uid="WizardSlackUsernameLookupInput" />
                            <Button Command="{x:Bind ViewModel.LookupSlackUsernameCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardLookupSlackUserButton" x:Uid="WizardLookupSlackUserButton" />
                            <TextBlock Text="{x:Bind ViewModel.SlackUsernameLookupResultText, Mode=OneWay}" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.HasSlackUsernameLookupResult), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="WizardSlackUsernameLookupResult" />
                            <TextBlock Text="{x:Bind ViewModel.SlackUsernameLookupStatus, Mode=OneWay}" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.HasSlackUsernameLookupStatus), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="WizardSlackUsernameLookupStatus" />
                            <Button Command="{x:Bind ViewModel.AddSlackUsernameLookupResultCommand}" IsEnabled="{x:Bind ViewModel.CanAddSlackUsernameLookupResult, Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardAddSlackUserButton" x:Uid="WizardAddSlackUserButton" />
                        </StackPanel>
                        <TextBox x:Name="SlackAllowedUsersBox"  Text="{x:Bind ViewModel.SlackAllowedUserIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" AutomationProperties.AutomationId="WizardSlackAllowedUserIds"  x:Uid="WizardSlackAllowedUserIds" />
                        <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock013" x:Uid="onboardingOnboardingWizardTextBlock013" />
                        <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock014" x:Uid="onboardingOnboardingWizardTextBlock014" />
                    </StackPanel>
                    <StackPanel Spacing="12" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardMattermost), Mode=OneWay}">
                        <TextBlock  Style="{StaticResource BodyStrongTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock015" x:Uid="onboardingOnboardingWizardTextBlock015" />
                        <TextBox x:Name="MattermostServerUrlBox"  Text="{x:Bind ViewModel.MattermostServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="https://chat.example.com" AutomationProperties.AutomationId="WizardMattermostServerUrl"  x:Uid="WizardMattermostServerUrl" />
                        <CheckBox IsChecked="{x:Bind ViewModel.MattermostBypassProxy, Mode=TwoWay}" AutomationProperties.AutomationId="WizardMattermostBypassProxy" x:Uid="MattermostBypassProxy" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.AutomationId="WizardMattermostProxyHelp" x:Uid="MattermostProxyHelp" />
                        <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock016" x:Uid="onboardingOnboardingWizardTextBlock016" />
                        <TextBox x:Name="MattermostChannelBox"  Text="{x:Bind ViewModel.MattermostChannelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WizardMattermostChannelId"  x:Uid="WizardMattermostChannelId" />
                        <StackPanel Spacing="8">
                            <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock017" x:Uid="onboardingOnboardingWizardTextBlock017" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><PasswordBox x:Name="MattermostTokenBox" Grid.ColumnSpan="2" Padding="12,5,44,6" PasswordChanged="MattermostTokenBox_PasswordChanged"  AutomationProperties.AutomationId="WizardMattermostToken"  x:Uid="WizardMattermostToken" /><ToggleButton x:Name="MattermostTokenRevealButton" Grid.Column="1" Width="36" Height="36" Padding="0" AutomationProperties.AutomationId="WizardMattermostTokenReveal" /></Grid>
                        </StackPanel>
                        <StackPanel Spacing="8" AutomationProperties.AutomationId="WizardMattermostUsernameLookup">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="WizardMattermostUsernameLookupLabel" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="MattermostUsernameLookupHelp" />
                            <TextBox Text="{x:Bind ViewModel.MattermostUsernameLookupInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="WizardMattermostUsernameLookupInput" x:Uid="WizardMattermostUsernameLookupInput" />
                            <Button Command="{x:Bind ViewModel.LookupMattermostUsernameCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardLookupMattermostUserButton" x:Uid="WizardLookupMattermostUserButton" />
                            <TextBlock Text="{x:Bind ViewModel.MattermostUsernameLookupResultText, Mode=OneWay}" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.HasMattermostUsernameLookupResult), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="WizardMattermostUsernameLookupResult" />
                            <TextBlock Text="{x:Bind ViewModel.MattermostUsernameLookupStatus, Mode=OneWay}" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.HasMattermostUsernameLookupStatus), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="WizardMattermostUsernameLookupStatus" />
                            <Button Command="{x:Bind ViewModel.AddMattermostUsernameLookupResultCommand}" IsEnabled="{x:Bind ViewModel.CanAddMattermostUsernameLookupResult, Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardAddMattermostUserButton" x:Uid="WizardAddMattermostUserButton" />
                        </StackPanel>
                        <TextBox x:Name="MattermostAllowedUsersBox"  Text="{x:Bind ViewModel.MattermostAllowedUserIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" AutomationProperties.AutomationId="WizardMattermostAllowedUserIds"  x:Uid="WizardMattermostAllowedUserIds" />
                        <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock018" x:Uid="onboardingOnboardingWizardTextBlock018" />
                    </StackPanel>
                    <StackPanel Spacing="12" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardDiscord), Mode=OneWay}">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" x:Uid="WizardDiscordTitle" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="WizardDiscordBotSetupHelp" />
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="WizardDiscordBotTokenLabel" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions><PasswordBox x:Name="DiscordBotTokenBox" Grid.ColumnSpan="2" Padding="12,5,44,6" PasswordChanged="DiscordBotTokenBox_PasswordChanged" AutomationProperties.AutomationId="WizardDiscordBotToken" x:Uid="WizardDiscordBotToken" /><ToggleButton x:Name="DiscordBotTokenRevealButton" Grid.Column="1" Width="36" Height="36" Padding="0" AutomationProperties.AutomationId="WizardDiscordBotTokenReveal" /></Grid>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="WizardDiscordAllowedUsersLabel" />
                            <TextBox x:Name="DiscordAllowedUsersBox" Text="{x:Bind ViewModel.DiscordAllowedUserIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" AutomationProperties.AutomationId="WizardDiscordAllowedUsers" x:Uid="WizardDiscordAllowedUsers" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="WizardDiscordAllowedUsersHelp" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="WizardDiscordAllowedGuildsLabel" />
                            <TextBox x:Name="DiscordAllowedGuildsBox" Text="{x:Bind ViewModel.DiscordAllowedGuildIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" AutomationProperties.AutomationId="WizardDiscordAllowedGuilds" x:Uid="WizardDiscordAllowedGuilds" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="WizardDiscordAllowedGuildsHelp" />
                        </StackPanel>
                        <ToggleSwitch IsOn="{x:Bind ViewModel.DiscordAllowDirectMessages, Mode=TwoWay}" AutomationProperties.AutomationId="WizardDiscordAllowDirectMessages" x:Uid="DiscordAllowDirectMessages" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" x:Uid="DiscordAllowDirectMessagesHelp" />
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="WizardDiscordAllowedChannelsLabel" />
                            <TextBox Text="{x:Bind ViewModel.DiscordAllowedChannelIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.AutomationId="WizardDiscordAllowedChannels" x:Uid="WizardDiscordAllowedChannels" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" x:Uid="WizardDiscordAllowedThreadsLabel" />
                            <TextBox Text="{x:Bind ViewModel.DiscordAllowedThreadIds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" AutomationProperties.AutomationId="WizardDiscordAllowedThreads" x:Uid="WizardDiscordAllowedThreads" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock  TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock019" x:Uid="onboardingOnboardingWizardTextBlock019" />
                </StackPanel>

                <StackPanel Spacing="16" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardSafetyStep), Mode=OneWay}">
                    <TextBlock  Style="{StaticResource SubtitleTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock020" x:Uid="onboardingOnboardingWizardTextBlock020" />
                    <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock021" x:Uid="onboardingOnboardingWizardTextBlock021" />
                    <ComboBox  SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.ChatApprovalMode, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WizardChatApprovalMode" x:Uid="WizardChatApprovalMode">
                        <ComboBoxItem  Tag="always"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem001" x:Uid="onboardingOnboardingWizardComboBoxItem001" />
                        <ComboBoxItem  Tag="first"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem002" x:Uid="onboardingOnboardingWizardComboBoxItem002" />
                        <ComboBoxItem  Tag="auto"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem003" x:Uid="onboardingOnboardingWizardComboBoxItem003" />
                    </ComboBox>
                    <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock022" x:Uid="onboardingOnboardingWizardTextBlock022" />
                    <ComboBox  SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.ChatResultMode, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WizardChatResultMode" x:Uid="WizardChatResultMode">
                        <ComboBoxItem  Tag="manual"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem004" x:Uid="onboardingOnboardingWizardComboBoxItem004" />
                        <ComboBoxItem  Tag="auto"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem005" x:Uid="onboardingOnboardingWizardComboBoxItem005" />
                        <ComboBoxItem  Tag="none"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem006" x:Uid="onboardingOnboardingWizardComboBoxItem006" />
                    </ComboBox>
                    <TextBlock  TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock023" x:Uid="onboardingOnboardingWizardTextBlock023" />
                    <ComboBox  SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.AgentPermissionMode, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanConfigureAgentPermission, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WizardAgentPermissionMode" x:Uid="WizardAgentPermissionMode">
                        <ComboBoxItem  Tag="inherit"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem007" x:Uid="onboardingOnboardingWizardComboBoxItem007" />
                        <ComboBoxItem  Tag="read-only"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem008" x:Uid="onboardingOnboardingWizardComboBoxItem008" />
                        <ComboBoxItem  Tag="workspace-write"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem009" x:Uid="onboardingOnboardingWizardComboBoxItem009" />
                        <ComboBoxItem  Tag="full-access"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem010" x:Uid="onboardingOnboardingWizardComboBoxItem010" />
                        <ComboBoxItem  Tag="ask" IsEnabled="{x:Bind local:OnboardingWizard.SupportsOperationApproval(ViewModel.IsCodexProvider, ViewModel.UseAppServer), Mode=OneWay}"  AutomationProperties.AutomationId="onboardingOnboardingWizardComboBoxItem011" x:Uid="onboardingOnboardingWizardComboBoxItem011" />
                    </ComboBox>
                    <TextBlock Text="{x:Bind ViewModel.AgentPermissionStatus, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock024" x:Uid="onboardingOnboardingWizardTextBlock024" />
                    <ToggleSwitch  IsOn="{x:Bind ViewModel.WizardAutoConnect, Mode=TwoWay}" AutomationProperties.AutomationId="WizardAutoConnect"  x:Uid="WizardAutoConnect" />
                    <TextBlock  TextWrapping="Wrap"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock025" x:Uid="onboardingOnboardingWizardTextBlock025" />
                    <Border Padding="16" CornerRadius="{ThemeResource ControlCornerRadius}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock  Style="{StaticResource BodyStrongTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock026" x:Uid="onboardingOnboardingWizardTextBlock026" />
                            <TextBlock Text="{x:Bind ViewModel.WizardSummary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="WizardSummary" />
                            <TextBlock Text="{x:Bind ViewModel.WizardSkippedNotice, Mode=OneWay}" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.HasWizardSkippedNotice), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="WizardSkippedNotice" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="8">
                        <TextBlock  Style="{StaticResource BodyStrongTextBlockStyle}"  AutomationProperties.AutomationId="onboardingOnboardingWizardTextBlock027" x:Uid="onboardingOnboardingWizardTextBlock027" />
                        <TextBlock Text="{x:Bind Inbox.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="WizardConnectionStatus" />
                        <TextBlock Text="{x:Bind Inbox.NotificationStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="WizardNotificationStatus" />
                        <Button  Click="ConnectMattermost_Click" IsEnabled="{x:Bind local:OnboardingWizard.Not(Inbox.IsExecuting), Mode=OneWay}" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardMattermost), Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardConnectMattermost"  x:Uid="WizardConnectMattermost" />
                        <Button  Click="ConnectSlack_Click" IsEnabled="{x:Bind local:OnboardingWizard.Not(Inbox.IsExecuting), Mode=OneWay}" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardSlack), Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardConnectSlack"  x:Uid="WizardConnectSlack" />
                        <Button Click="ConnectDiscord_Click" IsEnabled="{x:Bind local:OnboardingWizard.Not(Inbox.IsExecuting), Mode=OneWay}" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.IsWizardDiscord), Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="WizardConnectDiscord" x:Uid="WizardConnectDiscord" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8" VerticalAlignment="Bottom"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Grid.Column="0"  Command="{x:Bind ViewModel.PreviousOnboardingCommand}" AutomationProperties.AutomationId="OnboardingPrevious"  x:Uid="OnboardingPrevious" />
            <ProgressRing Grid.Column="2" IsActive="{x:Bind ViewModel.IsOnboardingBusy, Mode=OneWay}" Width="24" Height="24" />
            <Button Grid.Column="1" HorizontalAlignment="Right" Content="{x:Bind ViewModel.OnboardingSkipLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SkipOnboardingStepCommand}" Visibility="{x:Bind local:OnboardingWizard.ToVisibility(ViewModel.CanSkipOnboardingStep), Mode=OneWay}" AutomationProperties.AutomationId="OnboardingSkip" />
            <Button Grid.Column="3" Content="{x:Bind ViewModel.OnboardingNextLabel, Mode=OneWay}" Command="{x:Bind ViewModel.NextOnboardingCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="OnboardingNext" />
        </Grid>
    </Grid>
</UserControl>
