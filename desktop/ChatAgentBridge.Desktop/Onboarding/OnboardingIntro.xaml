<UserControl
    x:Class="ChatAgentBridge_Desktop.Onboarding.OnboardingIntro"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ChatAgentBridge_Desktop.Onboarding"
    xmlns:localization="using:ChatAgentBridge_Desktop.Localization"
    xmlns:diagrams="using:ChatAgentBridge_Desktop.Diagrams">
    <UserControl.Resources>
        <SolidColorBrush x:Key="MissingConsentBorderBrush" Color="{ThemeResource SystemFillColorCritical}" />
        <SolidColorBrush x:Key="MissingConsentBackgroundBrush" Color="{ThemeResource SystemFillColorCriticalBackground}" />
    </UserControl.Resources>
    <StackPanel x:Name="IntroStackPanel" Spacing="16" HorizontalAlignment="Stretch">
        <localization:LanguageSettings x:Name="IntroLanguageSettings" />
        <TextBlock x:Name="IntroHeading" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"  x:Uid="onboardingOnboardingIntroTextBlock001" />
        <diagrams:ArchitecturePreview x:Name="ArchitectureImage" AutomationProperties.AutomationId="WizardArchitecture" x:Uid="WizardArchitecture" />
        <TextBlock x:Name="IntroDescription" TextWrapping="Wrap"  x:Uid="onboardingOnboardingIntroTextBlock002" />
        <TextBlock x:Name="IntroDataNotice" TextWrapping="Wrap"  x:Uid="onboardingOnboardingIntroTextBlock003" />
        <TextBlock x:Name="IntroDisclaimer" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"  x:Uid="onboardingOnboardingIntroTextBlock004" />
        <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TermsButton" Grid.Row="0" Grid.Column="0" Click="ShowTerms_Click" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WizardTerms">
                <TextBlock x:Name="TermsButtonText" TextWrapping="Wrap" TextAlignment="Center"  x:Uid="onboardingOnboardingIntroTextBlock005" />
            </Button>
            <Button x:Name="PrivacyButton" Grid.Row="0" Grid.Column="1" Click="ShowPrivacy_Click" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="WizardPrivacy">
                <TextBlock x:Name="PrivacyButtonText" TextWrapping="Wrap" TextAlignment="Center"  x:Uid="onboardingOnboardingIntroTextBlock006" />
            </Button>
            <Border x:Name="TermsConsentBorder" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Padding="0" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent">
                <CheckBox x:Name="TermsConsentCheckBox" HorizontalAlignment="Stretch" Padding="12,0,0,0"  IsChecked="{x:Bind ViewModel.HasAcceptedTerms, Mode=TwoWay}" AutomationProperties.AutomationId="WizardAcceptTerms"  x:Uid="WizardAcceptTerms" />
            </Border>
            <Border x:Name="PrivacyConsentBorder" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Padding="0" CornerRadius="4" BorderThickness="2" BorderBrush="Transparent">
                <CheckBox x:Name="PrivacyConsentCheckBox" HorizontalAlignment="Stretch" Padding="12,0,0,0" IsChecked="{x:Bind ViewModel.HasAcceptedPrivacy, Mode=TwoWay}" AutomationProperties.AutomationId="WizardAcceptPrivacy"><TextBlock x:Name="PrivacyConsentText" TextWrapping="Wrap"  x:Uid="onboardingOnboardingIntroTextBlock007" /></CheckBox>
            </Border>
        </Grid>
        <TextBlock Text="{x:Bind ViewModel.ConsentStatus, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="WizardConsentStatus" />
    </StackPanel>
</UserControl>
