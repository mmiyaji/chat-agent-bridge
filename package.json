{
  "name": "chat-agent-bridge",
  "version": "0.1.0",
  "description": "Bridge chat threads to persistent local development agent sessions.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "check": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "dev": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/tsx/dist/cli.mjs src/index.ts",
    "e2e:server": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/tsx/dist/cli.mjs scripts/admin-e2e-server.ts",
    "service:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bridge-start.ps1",
    "service:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bridge-stop.ps1",
    "service:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bridge-restart.ps1",
    "service:restart:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bridge-restart.ps1 -Build",
    "service:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/bridge-status.ps1",
    "start": "node dist/index.js",
    "test": "node --preserve-symlinks --preserve-symlinks-main ./scripts/run-tests.mjs",
    "test:e2e": "node --preserve-symlinks --preserve-symlinks-main ./node_modules/@playwright/test/cli.js test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
